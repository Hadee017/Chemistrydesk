    <!-- EDITORIAL & SCIENTIFIC REFERENCE ARTICLE (ADSENSE E-E-A-T COMPLIANT) -->
    <article style="border-top: 2px solid #e2e8f0; padding-top: 3.5rem; line-height: 1.85; color: #1e293b;">
      
      <h2 style="font-size: 1.85rem; font-weight: 800; color: #0f172a; margin-bottom: 1.25rem; letter-spacing: -0.02em;">
        Theoretical Principles of Molar Solution Formulation &amp; Analytical Weighing
      </h2>
      <p style="font-size: 1rem; margin-bottom: 1.25rem;">
        Molarity (designated <em>M</em>, with standard SI units of <strong>mol&middot;L<sup>&minus;1</sup></strong> or <strong>mol&middot;dm<sup>&minus;3</sup></strong>) defines the amount of solute in moles dissolved per unit volume of final liquid solution. In analytical chemistry, materials synthesis, and spectrophotometric calibration, formulating precise volumetric solutions is the basis of repeatable stoichiometric calculations.
      </p>

      <!-- Centered Formula Box -->
      <div style="background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 12px; padding: 1.5rem 2rem; margin: 2rem 0; text-align: center;">
        <div style="font-size: 1.45rem; font-weight: 800; color: #0f172a; font-family: 'Times New Roman', Times, serif;">
          <i>Mass</i> (g) = <span style="display: inline-block; vertical-align: middle; text-align: center; margin: 0 6px;"><span style="display: block; border-bottom: 2px solid #0f172a; padding: 0 6px;"><i>C</i> &middot; <i>V</i> &middot; <i>MW</i><sub>effective</sub></span><span style="display: block; padding-top: 3px;"><i>Purity</i> (%) / 100</span></span>
        </div>
      </div>

      <h3 style="font-size: 1.35rem; font-weight: 800; color: #0f172a; margin-top: 2.5rem; margin-bottom: 0.85rem;">
        Compensating for Crystalline Hydrates (&middot;nH₂O)
      </h3>
      <p style="font-size: 1rem;">
        Many inorganic salts incorporate coordinated water molecules into their crystalline matrices. A classic benchtop example is copper(II) sulfate:
      </p>
      <ul style="margin-left: 1.5rem; font-size: 0.95rem; line-height: 1.8;">
        <li><strong>Anhydrous Copper Sulfate (CuSO₄):</strong> Molar mass = 159.60 g/mol.</li>
        <li><strong>Copper Sulfate Pentahydrate (CuSO₄&middot;5H₂O):</strong> Molar mass = 159.60 + 5(18.01528) = 249.68 g/mol.</li>
      </ul>
      <p style="font-size: 1rem;">
        Weighing 159.60 g of the pentahydrate delivers only 102.0 g of active CuSO₄ and 57.6 g of water, resulting in a severe <strong>36.1% deficit in target solution concentration</strong>. The effective molecular weight must reflect the complete crystal stoichiometry:
      </p>
      <div style="background: #f1f5f9; border-left: 4px solid #0284c7; padding: 0.85rem 1.25rem; margin: 1.25rem 0; font-family: monospace; font-size: 0.9rem; color: #0f172a; font-weight: 600;">
        MW<sub>effective</sub> = MW<sub>anhydrous</sub> + (n &times; 18.01528 g/mol)
      </div>

      <h3 style="font-size: 1.35rem; font-weight: 800; color: #0f172a; margin-top: 2.5rem; margin-bottom: 0.85rem;">
        Reagent Assay Purity Correction
      </h3>
      <p style="font-size: 1rem;">
        Analytical reagents are stamped with a certified manufacturer assay purity percentage (<em>P%</em>). Analytical Reagent (AR) grade chemicals often range between 95.0% and 99.5% purity due to atmospheric moisture absorption and synthesis traces. To supply the target moles of pure chemical (<em>n</em>), the balance mass must be adjusted:
      </p>
      <div style="background: #f1f5f9; border-left: 4px solid #0284c7; padding: 0.85rem 1.25rem; margin: 1.25rem 0; font-family: monospace; font-size: 0.9rem; color: #0f172a; font-weight: 600;">
        Mass<sub>weighed</sub> = Mass<sub>theoretical</sub> / (Assay% / 100)
      </div>

      <h3 style="font-size: 1.35rem; font-weight: 800; color: #0f172a; margin-top: 2.5rem; margin-bottom: 0.85rem;">
        Standard Volumetric Preparation Workflow
      </h3>
      <ol style="margin-left: 1.5rem; line-height: 1.8; font-size: 0.95rem;">
        <li><strong>Analytical Balance Weighing:</strong> Tare a clean weighing boat and weigh the gross mass on a calibrated analytical balance (±0.0001 g precision).</li>
        <li><strong>Initial Beaker Dissolution:</strong> Transfer the salt into a clean glass beaker containing ~60% of the target deionized water volume. Stir gently until solid dissolution is complete.</li>
        <li><strong>Thermal Equilibrate:</strong> Allow any endothermic cooling or exothermic heat of solution to return to ambient laboratory temperature (20&deg;C).</li>
        <li><strong>Quantitative Transfer:</strong> Pour the solution into a Class-A volumetric flask using a clean funnel. Rinse the beaker walls and funnel 3 times with solvent aliquots into the flask.</li>
        <li><strong>Meniscus Adjustment:</strong> Dilute dropwise until the lowest curved boundary of the meniscus touches the graduation line at eye level. Stopper and invert 10 times.</li>
      </ol>

      <!-- FAQ Section -->
      <h3 style="font-size: 1.5rem; font-weight: 800; color: #0f172a; margin-top: 3rem; margin-bottom: 1.25rem;">
        Frequently Asked Questions: Solution Molarity &amp; Analytical Weighing
      </h3>
      
      <div style="display: flex; flex-direction: column; gap: 0.85rem; margin-bottom: 2rem;">
        <details style="background: #ffffff; border: 1.5px solid #cbd5e1; border-radius: 10px; padding: 1.15rem;">
          <summary style="font-weight: 800; color: #0f172a; cursor: pointer; font-size: 0.95rem;">What is the physical difference between molarity and molality?</summary>
          <p style="margin: 0.65rem 0 0 0; font-size: 0.9rem; color: #334155; line-height: 1.7;">
            Molarity (M) denotes moles of solute per liter of total solution, which is temperature-dependent due to solvent thermal expansion. Molality (m) represents moles of solute per kilogram of pure solvent, which remains strictly independent of temperature.
          </p>
        </details>

        <details style="background: #ffffff; border: 1.5px solid #cbd5e1; border-radius: 10px; padding: 1.15rem;">
          <summary style="font-weight: 800; color: #0f172a; cursor: pointer; font-size: 0.95rem;">Why must chemical assay purity be factored into molarity calculations?</summary>
          <p style="margin: 0.65rem 0 0 0; font-size: 0.9rem; color: #334155; line-height: 1.7;">
            Manufacturer reagents are rarely 100% pure due to residual moisture and trace synthetic precursors. If an assay reads 96.0%, weighing 100 g supplies only 96 g of active solute, yielding an under-concentrated standard unless compensated.
          </p>
        </details>

        <details style="background: #ffffff; border: 1.5px solid #cbd5e1; border-radius: 10px; padding: 1.15rem;">
          <summary style="font-weight: 800; color: #0f172a; cursor: pointer; font-size: 0.95rem;">Why should solutions never be dissolved directly inside a volumetric flask?</summary>
          <p style="margin: 0.65rem 0 0 0; font-size: 0.9rem; color: #334155; line-height: 1.7;">
            Salts often display significant dissolution heats (&Delta;H<sub>solution</sub>). Volumetric flasks are calibrated strictly at 20&deg;C; dissolving hot or cold reagents alters glass dimensions and causes inaccurate volume markings before thermal equilibrium.
          </p>
        </details>
      </div>

    </article>
  </main>

  <style>
    .molarity-preset-btn {
      background: #f8fafc;
      border: 1.5px solid #cbd5e1;
      padding: 0.35rem 0.65rem;
      border-radius: 6px;
      cursor: pointer;
      color: #1e293b;
      font-size: 0.75rem;
      font-weight: 700;
      transition: all 0.2s ease;
    }
    .molarity-preset-btn:hover {
      background: #0284c7;
      color: #ffffff;
      border-color: #0284c7;
      transform: translateY(-1px);
    }
    .reagent-search-row {
      padding: 0.75rem 1rem;
      border-bottom: 1px solid #f1f5f9;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      transition: background 0.15s ease;
    }
    .reagent-search-row:hover {
      background: #f0f9ff;
    }
    @media print {
      body * {
        visibility: hidden !important;
      }
      #molarityLabelWrapper, #molarityLabelWrapper * {
        visibility: visible !important;
      }
      #molarityLabelWrapper {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        display: block !important;
      }
      #labelBoxMolarity {
        position: absolute;
        left: 0.25in;
        top: 0.25in;
      }
      #triggerMolarityPrint {
        display: none !important;
      }
    }
  </style>

  <!-- Pass Reagents Database to Client-Side -->
  <div id="reagentsDatabaseData" data-reagents={JSON.stringify(REAGENTS_DATABASE)} style="display: none;"></div>

  <script is:inline>
    function sanitizeNum(val) {
      if (typeof val === 'string') val = val.replace(',', '.').trim();
      var parsed = parseFloat(val);
      return isNaN(parsed) ? 0 : parsed;
    }

    var soluteName = document.getElementById('soluteName');
    var concInput = document.getElementById('concInput');
    var concUnit = document.getElementById('concUnit');
    var volInput = document.getElementById('volInput');
    var volUnit = document.getElementById('volUnit');
    var mwInput = document.getElementById('mwInput');
    var hydrateCount = document.getElementById('hydrateCount');
    var puritySlider = document.getElementById('puritySlider');
    var purityVal = document.getElementById('purityVal');
    var hydrateTag = document.getElementById('hydrateTag');
    var activeReagentTag = document.getElementById('activeReagentTag');

    var primaryMassGrams = document.getElementById('primaryMassGrams');
    var displayEffectiveMw = document.getElementById('displayEffectiveMw');
    var displayTotalMoles = document.getElementById('displayTotalMoles');
    var displayPureMass = document.getElementById('displayPureMass');
    var displayMassConc = document.getElementById('displayMassConc');
    var molarityStepLog = document.getElementById('molarityStepLog');
    var ghsHazardText = document.getElementById('ghsHazardText');
    var ghsPpeText = document.getElementById('ghsPpeText');

    var molarityLabelWrapper = document.getElementById('molarityLabelWrapper');
    var labelReagentName = document.getElementById('labelReagentName');
    var labelConc = document.getElementById('labelConc');
    var labelVol = document.getElementById('labelVol');
    var labelWeighedMass = document.getElementById('labelWeighedMass');
    var labelFw = document.getElementById('labelFw');
    var labelDate = document.getElementById('labelDate');

    // Parse Reagents Database from Data Element
    var reagentsRaw = document.getElementById('reagentsDatabaseData');
    var REAGENTS = [];
    if (reagentsRaw && reagentsRaw.dataset.reagents) {
      try {
        REAGENTS = JSON.parse(reagentsRaw.dataset.reagents);
      } catch (err) {
        console.error('Failed to parse reagents database', err);
      }
    }

    // Search Engine Elements
    var reagentSearchInput = document.getElementById('reagentSearchInput');
    var reagentSearchDropdown = document.getElementById('reagentSearchDropdown');

    function calculateMolarity() {
      var cFactor = parseFloat(concUnit.value);
      var vFactor = parseFloat(volUnit.value);
      var concVal = sanitizeNum(concInput.value);
      var volVal = sanitizeNum(volInput.value);
      var anhydrousMw = sanitizeNum(mwInput.value);
      var nWaters = parseInt(hydrateCount.value) || 0;
      var purityPercent = sanitizeNum(puritySlider.value);

      purityVal.textContent = purityPercent.toFixed(1) + '%';
      hydrateTag.textContent = nWaters === 0 ? 'Anhydrous (0 H₂O)' : (nWaters + ' H₂O Hydrate');

      if (concVal <= 0 || volVal <= 0 || anhydrousMw <= 0 || purityPercent <= 0) {
        primaryMassGrams.textContent = '--';
        displayEffectiveMw.textContent = '--';
        displayTotalMoles.textContent = '--';
        displayPureMass.textContent = '--';
        displayMassConc.textContent = '--';
        return;
      }

      var concMolar = concVal * cFactor;
      var volLiters = volVal * vFactor;
      var waterMw = 18.01528;
      var effectiveMw = anhydrousMw + (nWaters * waterMw);
      var molesSolute = concMolar * volLiters;
      var theoreticalPureMass = molesSolute * effectiveMw;
      var grossMassToWeigh = theoreticalPureMass / (purityPercent / 100);
      var massConcentration = grossMassToWeigh / volLiters;

      primaryMassGrams.textContent = grossMassToWeigh.toFixed(4) + ' g';
      displayEffectiveMw.textContent = effectiveMw.toFixed(3) + ' g/mol';
      displayTotalMoles.textContent = molesSolute < 1e-3 ? molesSolute.toExponential(4) + ' mol' : molesSolute.toFixed(4) + ' mol';
      displayPureMass.textContent = theoreticalPureMass.toFixed(4) + ' g';
      displayMassConc.textContent = massConcentration.toFixed(3) + ' g/L';

      molarityStepLog.innerHTML = 
        '1. Tare weighing boat on a calibrated analytical balance and weigh <strong>' + grossMassToWeigh.toFixed(4) + ' g</strong> of ' + soluteName.value + ' (compensating for ' + purityPercent.toFixed(1) + '% assay purity).<br />' +
        '2. Add approximately <strong>' + (volVal * 0.65).toFixed(1) + ' ' + volUnit.options[volUnit.selectedIndex].text + '</strong> of solvent to a beaker and stir to completely dissolve the solute.<br />' +
        '3. Quantitatively transfer to a <strong>' + volVal + ' ' + volUnit.options[volUnit.selectedIndex].text + '</strong> Class-A volumetric flask and dilute until meniscus reaches the mark.<br />' +
        '4. Result: <strong>' + concVal + ' ' + concUnit.options[concUnit.selectedIndex].text + '</strong> active solution containing ' + (molesSolute < 1e-3 ? molesSolute.toExponential(4) : molesSolute.toFixed(4)) + ' moles solute.';

      labelReagentName.textContent = soluteName.value;
      labelConc.textContent = concVal + ' ' + concUnit.options[concUnit.selectedIndex].text;
      labelVol.textContent = volVal + ' ' + volUnit.options[volUnit.selectedIndex].text;
      labelWeighedMass.textContent = grossMassToWeigh.toFixed(4) + ' g';
      labelFw.textContent = effectiveMw.toFixed(2) + ' g/mol';
      if (labelDate) labelDate.textContent = new Date().toLocaleDateString();

      // Sync URL parameters for sharing
      var urlParams = new URLSearchParams(window.location.search);
      urlParams.set('chem', soluteName.value);
      urlParams.set('c', concVal);
      urlParams.set('v', volVal);
      urlParams.set('mw', anhydrousMw);
      urlParams.set('h', nWaters);
      urlParams.set('p', purityPercent);
      window.history.replaceState({}, '', window.location.pathname + '?' + urlParams.toString());
    }

    // Select Reagent from Database Search
    function applyReagent(reagent) {
      soluteName.value = reagent.name + ' (' + reagent.formula + ')';
      mwInput.value = reagent.anhydrousMw;
      hydrateCount.value = reagent.defaultHydrate;
      puritySlider.value = reagent.typicalPurity;
      activeReagentTag.textContent = reagent.name.split(' (')[0];

      // GHS Safety & Notes
      var ghsList = (reagent.ghs && reagent.ghs.length > 0) ? reagent.ghs.join(' | ') : 'Non-Hazardous under standard handling.';
      var notes = reagent.notes ? ' — ' + reagent.notes : '';
      ghsHazardText.textContent = ghsList + notes;
      ghsPpeText.textContent = reagent.category === 'acid' || reagent.category === 'base' 
        ? 'Chemical Splash Goggles, Nitrile Gloves, Lab Coat, Fume Hood' 
        : 'Safety Glasses, Nitrile Gloves, Lab Coat';

      reagentSearchInput.value = reagent.name + ' (' + reagent.formula + ')';
      reagentSearchDropdown.style.display = 'none';

      calculateMolarity();
    }

    // Setup Live Search Handlers
    if (reagentSearchInput && reagentSearchDropdown) {
      reagentSearchInput.addEventListener('input', function(e) {
        var query = e.target.value.toLowerCase().trim();
        if (!query) {
          reagentSearchDropdown.style.display = 'none';
          return;
        }

        var matches = REAGENTS.filter(function(r) {
          return r.name.toLowerCase().indexOf(query) !== -1 || 
                 r.formula.toLowerCase().indexOf(query) !== -1 ||
                 r.category.toLowerCase().indexOf(query) !== -1;
        });

        if (matches.length === 0) {
          reagentSearchDropdown.innerHTML = '<div style="padding: 0.85rem 1rem; font-size: 0.85rem; color: #94a3b8;">No matching laboratory standard found. Enter custom values below.</div>';
          reagentSearchDropdown.style.display = 'block';
          return;
        }

        var html = '';
        matches.forEach(function(r) {
          html += '<div class="reagent-search-row" data-id="' + r.id + '">' +
                    '<div>' +
                      '<strong style="color: #0f172a; font-size: 0.9rem;">' + r.name + '</strong>' +
                      '<span style="color: #64748b; font-size: 0.82rem; margin-left: 0.4rem; font-family: monospace;">' + r.formula + '</span>' +
                    '</div>' +
                    '<div style="text-align: right;">' +
                      '<span style="font-size: 0.8rem; font-weight: 700; color: #0284c7;">' + r.anhydrousMw.toFixed(2) + ' g/mol</span>' +
                      '<span style="display: block; font-size: 0.72rem; color: #64748b;">Hydrate: ' + r.defaultHydrate + 'H₂O</span>' +
                    '</div>' +
                  '</div>';
        });

        reagentSearchDropdown.innerHTML = html;
        reagentSearchDropdown.style.display = 'block';

        var rows = reagentSearchDropdown.querySelectorAll('.reagent-search-row');
        rows.forEach(function(row) {
          row.addEventListener('click', function() {
            var selectedId = row.getAttribute('data-id');
            var selected = REAGENTS.find(function(item) { return item.id === selectedId; });
            if (selected) {
              applyReagent(selected);
            }
          });
        });
      });

      // Close dropdown when clicking outside
      document.addEventListener('click', function(e) {
        if (!reagentSearchInput.contains(e.target) && !reagentSearchDropdown.contains(e.target)) {
          reagentSearchDropdown.style.display = 'none';
        }
      });
    }

    // Parse URL on initial load if present
    function loadUrlParams() {
      var params = new URLSearchParams(window.location.search);
      if (params.has('chem')) soluteName.value = params.get('chem');
      if (params.has('c')) concInput.value = params.get('c');
      if (params.has('v')) volInput.value = params.get('v');
      if (params.has('mw')) mwInput.value = params.get('mw');
      if (params.has('h')) hydrateCount.value = params.get('h');
      if (params.has('p')) puritySlider.value = params.get('p');
    }

    document.querySelectorAll('.molarity-preset-btn').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        var t = e.currentTarget;
        soluteName.value = t.dataset.name;
        mwInput.value = t.dataset.mw;
        puritySlider.value = t.dataset.purity;
        hydrateCount.value = t.dataset.hydrate;
        ghsHazardText.textContent = t.dataset.ghs;
        ghsPpeText.textContent = t.dataset.ppe;
        activeReagentTag.textContent = t.dataset.name.split(' (')[0];
        calculateMolarity();
      });
    });

    [concInput, concUnit, volInput, volUnit, mwInput, hydrateCount, puritySlider, soluteName].forEach(function(el) {
      el.addEventListener('input', calculateMolarity);
      el.addEventListener('change', calculateMolarity);
    });

    document.getElementById('copyMolarityLatex').addEventListener('click', function() {
      var latex = 'm = \\frac{C \\cdot V \\cdot MW_{\\mathrm{eff}}}{P\\%} = ' + primaryMassGrams.textContent;
      navigator.clipboard.writeText(latex);
      alert('LaTeX equation copied to clipboard.');
    });

    document.getElementById('printMolarityLabelBtn').addEventListener('click', function() {
      molarityLabelWrapper.style.display = molarityLabelWrapper.style.display === 'none' ? 'block' : 'none';
      if (molarityLabelWrapper.style.display === 'block') {
        molarityLabelWrapper.scrollIntoView({ behavior: 'smooth' });
      }
    });

    document.getElementById('triggerMolarityPrint').addEventListener('click', function() {
      window.print();
    });

    document.getElementById('exportMolarityCsv').addEventListener('click', function() {
      var csv = 'Parameter,Value,Unit\n' +
        'Reagent_Name,' + soluteName.value + ',text\n' +
        'Target_Concentration,' + concInput.value + ',' + concUnit.options[concUnit.selectedIndex].text + '\n' +
        'Volume,' + volInput.value + ',' + volUnit.options[volUnit.selectedIndex].text + '\n' +
        'Anhydrous_MW,' + mwInput.value + ',g/mol\n' +
        'Hydrate_Water_stoichiometry,' + hydrateCount.value + ',integer\n' +
        'Effective_MW,' + displayEffectiveMw.textContent.replace(' g/mol','') + ',g/mol\n' +
        'Purity_Assay,' + puritySlider.value + ',percent\n' +
        'Mass_To_Weigh,' + primaryMassGrams.textContent.replace(' g','') + ',grams\n';
      var blob = new Blob([csv], { type: 'text/csv' });
      var url = window.URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.setAttribute('href', url);
      a.setAttribute('download', 'molarity_recipe_' + soluteName.value.replace(/[^a-zA-Z0-9]/g, '_') + '.csv');
      a.click();
    });

    document.getElementById('shareSetupBtn').addEventListener('click', function() {
      navigator.clipboard.writeText(window.location.href);
      alert('Experiment URL copied to clipboard.');
    });

    loadUrlParams();
    calculateMolarity();
    // --- In-Dashboard Academic Citation Logic ---
  const citeDrawer = document.getElementById('citeDrawer');
  const toggleCiteBtn = document.getElementById('toggleCiteBtn');
  const inlineCiteOutput = document.getElementById('inlineCiteOutput');
  const inlineTabs = document.querySelectorAll('.inline-cite-tab');
  const inlineCopyBtn = document.getElementById('inlineCopyCiteBtn');

  const molCitations = {
    bibtex: `@software{chemistrydesk_molarity_2026,
  author    = {ChemistryDesk Benchtop Contributors},
  title     = {Solution Molarity Studio & Hydrate Compensation Engine},
  year      = {2026},
  publisher = {ChemistryDesk Precision Scientific Utilities},
  url       = {https://chemistrydesk.vercel.app/molarity}
}`,
    acs: `ChemistryDesk Benchtop Contributors. Solution Molarity Studio & Hydrate Compensation Engine. ChemistryDesk, 2026. https://chemistrydesk.vercel.app/molarity (accessed ${new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}).`,
    apa: `ChemistryDesk Benchtop Contributors. (2026). Solution Molarity Studio & Hydrate Compensation Engine [Web software]. ChemistryDesk. https://chemistrydesk.vercel.app/molarity`,
    ieee: `ChemistryDesk Benchtop Contributors, "Solution Molarity Studio & Hydrate Compensation Engine," ChemistryDesk, 2026. [Online]. Available: https://chemistrydesk.vercel.app/molarity.`
  };

  let currentInlineFormat = 'bibtex';

  function updateInlineCite() {
    if (inlineCiteOutput) {
      inlineCiteOutput.textContent = molCitations[currentInlineFormat];
    }
  }

  if (toggleCiteBtn && citeDrawer) {
    toggleCiteBtn.addEventListener('click', () => {
      const isHidden = citeDrawer.style.display === 'none' || citeDrawer.style.display === '';
      citeDrawer.style.display = isHidden ? 'block' : 'none';
      toggleCiteBtn.style.background = isHidden ? '#0284c7' : '#e0f2fe';
      toggleCiteBtn.style.color = isHidden ? '#ffffff' : '#0369a1';
      if (isHidden) updateInlineCite();
    });
  }

  inlineTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      inlineTabs.forEach(t => {
        t.style.background = '#ffffff';
        t.style.color = '#334155';
        t.style.borderColor = '#cbd5e1';
      });
      tab.style.background = '#0f172a';
      tab.style.color = '#ffffff';
      tab.style.borderColor = '#0f172a';
      currentInlineFormat = tab.getAttribute('data-format');
      updateInlineCite();
    });
  });

  if (inlineCopyBtn) {
    inlineCopyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(molCitations[currentInlineFormat]);
        inlineCopyBtn.textContent = '✅ Copied!';
        setTimeout(() => {
          inlineCopyBtn.textContent = '📋 Copy';
        }, 2000);
      } catch (err) {
        console.error('Failed to copy citation:', err);
      }
    });
  }
  </script>

