---
import BaseLayout from '../layouts/BaseLayout.astro';

// Enhanced Structured Schema for AI Engine Optimization (AEO) and Rich Snippets
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://chemistrydesk.org/bet#webapp",
      "name": "ChemistryDesk Multipoint BET Surface Area & Physisorption Engine",
      "url": "https://chemistrydesk.org/bet",
      "applicationCategory": "EducationalApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Operates fully offline via ServiceWorker.",
      "description": "Lab-grade multipoint BET surface area calculator, Rouquerol consistency criteria analyzer, and gas physisorption regression studio.",
      "author": {
        "@type": "Person",
        "name": "Bilal Khan",
        "affiliation": {
          "@type": "EducationalOrganization",
          "name": "University of Education, Lahore (Attock Campus)"
        }
      },
      "sameAs": [
        "https://doi.org/10.5281/zenodo.23059466",
        "https://github.com/Hadee017/Chemistrydesk"
      ],
      "featureList": [
        "Multipoint linear BET regression (0 < P/P0 < 1)",
        "Automated Rouquerol consistency criteria verification",
        "Adsorbate probe selection (N2 77K, Ar 87K, CO2 273K) with custom sigma override",
        "Sample mass sensitivity and degassing protocol advisor",
        "Interactive SVG BET linear coordinate chart",
        "Printable thermal degas tube label generator",
        "Namespaced localStorage persistence (cd_bet_run)",
        "Audit-ready Lab Notebook SOP export",
        "One-click Overleaf / LaTeX equation generation",
        "Multi-format academic citation modal (BibTeX, ACS, APA 7) with Zenodo DOI",
        "URL search query synchronization (?pts=...&m=...)",
        "CSV isotherm data export"
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "ChemistryDesk",
          "item": "https://chemistrydesk.org"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "BET Surface Area Studio",
          "item": "https://chemistrydesk.org/bet"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the acceptable linear P/P0 range for BET calculations in MOFs and microporous materials?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For microporous materials like MOFs and zeolites, pore filling occurs at very low relative pressures. The standard range (0.05 - 0.30) violates Rouquerol criteria and yields negative C constants. The valid linear region typically falls between P/P0 = 0.005 and 0.08."
          }
        },
        {
          "@type": "Question",
          "name": "What is the Rouquerol consistency criteria for BET analysis?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Rouquerol criteria state that: (1) The quantity V(1 - P/P0) must increase monotonically with P/P0; (2) The BET constant C must be positive (requiring a positive y-intercept); and (3) The calculated monolayer capacity Vm should correspond to a relative pressure within the chosen linear range."
          }
        },
        {
          "@type": "Question",
          "name": "How much sample mass is required for an accurate BET measurement?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Instrument transducers typically require at least 2 to 5 m² of total surface area in the sample cell for reliable precision. For high surface area materials (1000 m²/g), 0.02 - 0.05 g suffices. For low surface area materials (1 - 5 m²/g), 1 to 2 g or more of degassed sample is required."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout 
  title="BET Surface Area Calculator | Multipoint Physisorption Studio | ChemistryDesk"
  description="Calculate specific surface area (SBET), monolayer volume (Vm), and C-constant from gas physisorption isotherms. Built with Rouquerol consistency checks, printable labels, and LaTeX export."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="max-w-6xl mx-auto px-4 py-8">
    
    <!-- Studio Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs font-mono text-slate-400 mb-6">
      <a href="/" class="hover:text-emerald-400 transition">Suite Catalog</a>
      <span>/</span>
      <span class="text-white">BET Physisorption Studio</span>
    </nav>

    <!-- Header & Action Ribbon -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-mono uppercase tracking-wider mb-2">
          Materials & Physisorption Engine
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          Multipoint BET Surface Area Analyzer
        </h1>
        <p class="text-slate-400 text-sm sm:text-base mt-1">
          Precision multipoint regression, Rouquerol consistency alerts, and export tools for academic workflows.
        </p>
      </div>

      <!-- Quick Action Toolbar -->
      <div class="flex flex-wrap items-center gap-2">
        <button id="cite-trigger-btn" class="px-3 py-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-xl text-xs font-mono text-slate-300 transition flex items-center gap-1.5 shadow-sm">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
          Cite Tool
        </button>
        <button id="label-trigger-btn" class="px-3 py-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-xl text-xs font-mono text-slate-300 transition flex items-center gap-1.5 shadow-sm">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
          Print Tube Label
        </button>
        <button id="export-csv-btn" class="px-3 py-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-xl text-xs font-mono text-slate-300 transition flex items-center gap-1.5 shadow-sm">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
          Export CSV
        </button>
        <button id="save-local-btn" class="px-3 py-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-xl text-xs font-mono text-slate-300 transition flex items-center gap-1.5 shadow-sm" title="Save to local browser cache">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/></svg>
          Save Run
        </button>
        <button id="share-url-btn" class="px-3 py-2 bg-emerald-600 hover:bg-emerald-500 rounded-xl text-xs font-mono text-white transition flex items-center gap-1.5 shadow-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg>
          Share Link
        </button>
      </div>
    </div>

    <!-- Main Calculation Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Input Workbench: 7 Columns -->
      <div class="lg:col-span-7 bg-slate-900 border border-slate-800 rounded-2xl p-5 sm:p-6 shadow-xl">
        <div class="flex items-center justify-between pb-4 mb-5 border-b border-slate-800">
          <h2 class="text-base font-bold text-white flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
            Isotherm Adsorption Data
          </h2>
          <div class="flex flex-wrap gap-2">
            <button id="load-mcm-btn" class="text-xs font-mono bg-slate-800 hover:bg-slate-700 text-slate-300 px-2.5 py-1 rounded-lg border border-slate-700 transition">
              MCM-41 (Mesoporous)
            </button>
            <button id="load-mof-btn" class="text-xs font-mono bg-slate-800 hover:bg-slate-700 text-slate-300 px-2.5 py-1 rounded-lg border border-slate-700 transition">
              HKUST-1 (Microporous)
            </button>
          </div>
        </div>

        <!-- Probe, Mass, & Outgas Condition Inputs -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-5">
          <div class="sm:col-span-1">
            <label class="block text-xs font-mono text-slate-400 mb-1">Adsorbate Gas Probe</label>
            <select id="adsorbate-select" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-2.5 py-2 text-xs font-mono text-white focus:outline-none focus:border-emerald-500">
              <option value="0.162" selected>N₂ (77 K) — 0.162 nm²</option>
              <option value="0.142">Ar (87 K) — 0.142 nm²</option>
              <option value="0.170">CO₂ (273 K) — 0.170 nm²</option>
              <option value="custom">Custom σ...</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-mono text-slate-400 mb-1">Degassed Mass (g)</label>
            <input type="text" inputmode="decimal" id="sample-mass" value="0.1250" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-2.5 py-2 text-xs font-mono text-white focus:outline-none focus:border-emerald-500" placeholder="0.1000" />
          </div>
          <div>
            <label class="block text-xs font-mono text-slate-400 mb-1">Degas Temp (°C)</label>
            <input type="text" inputmode="decimal" id="degas-temp" value="120" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-2.5 py-2 text-xs font-mono text-white focus:outline-none focus:border-emerald-500" placeholder="120" />
          </div>
        </div>

        <!-- Hidden Custom Sigma Input -->
        <div id="custom-sigma-row" class="mb-5 hidden bg-slate-950 p-3 rounded-xl border border-slate-800">
          <label class="block text-xs font-mono text-emerald-400 mb-1">Custom Adsorbate Cross-Sectional Area (σ in nm²)</label>
          <input type="text" inputmode="decimal" id="custom-sigma" value="0.162" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-xs font-mono text-white focus:outline-none focus:border-emerald-500" />
        </div>

        <!-- Data Table -->
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse" id="data-table">
            <thead>
              <tr class="border-b border-slate-800 text-xs font-mono text-slate-400">
                <th class="py-2 px-2 w-8">#</th>
                <th class="py-2 px-2">Relative Pressure (P/P₀)</th>
                <th class="py-2 px-2">Vol Adsorbed (cm³/g STP)</th>
                <th class="py-2 px-2 text-right w-16">Action</th>
              </tr>
            </thead>
            <tbody id="points-container" class="divide-y divide-slate-800/60 text-sm font-mono">
              <!-- Dynamically populated via JS -->
            </tbody>
          </table>
        </div>

        <!-- Table Operations -->
        <div class="mt-4 pt-3 border-t border-slate-800/80 flex items-center justify-between">
          <button id="add-row-btn" class="flex items-center gap-1.5 text-xs font-mono text-emerald-400 hover:text-emerald-300 bg-emerald-950/40 border border-emerald-800/40 px-3 py-1.5 rounded-lg transition">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            Add Data Point
          </button>
          <button id="clear-all-btn" class="text-xs font-mono text-slate-500 hover:text-red-400 transition">
            Reset to Default
          </button>
        </div>

        <!-- Dynamic SVG Regression Plot -->
        <div class="mt-6 pt-5 border-t border-slate-800">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-mono text-slate-400 uppercase tracking-wider">Dynamic BET Plot: 1/[V(P₀/P - 1)] vs P/P₀</span>
            <span id="chart-r2-badge" class="text-xs font-mono px-2 py-0.5 rounded bg-slate-800 text-emerald-400 border border-slate-700">R² = --</span>
          </div>
          <div class="w-full h-48 bg-slate-950 rounded-xl border border-slate-800 p-2 flex items-center justify-center relative overflow-hidden">
            <svg id="bet-chart" class="w-full h-full" viewBox="0 0 500 200">
              <!-- Rendered via JS -->
            </svg>
          </div>
        </div>

      </div>

      <!-- Output Workbench: 5 Columns -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Primary Output Card -->
        <div class="bg-gradient-to-br from-slate-900 to-slate-950 border border-slate-800 rounded-2xl p-6 shadow-xl relative overflow-hidden">
          <div class="absolute -right-12 -top-12 w-40 h-40 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-mono uppercase text-emerald-400 tracking-wider">Calculated Parameters</span>
            <span class="text-xs font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">IUPAC Protocol</span>
          </div>

          <!-- Major Metric: SBET -->
          <div class="mb-5">
            <div class="text-slate-400 text-xs font-mono">Specific Surface Area (S_BET)</div>
            <div class="flex items-baseline gap-2 mt-1">
              <span id="res-sbet" class="text-4xl sm:text-5xl font-black text-white font-mono tracking-tight">--</span>
              <span class="text-lg text-emerald-400 font-semibold font-mono">m²/g</span>
            </div>
          </div>

          <!-- Parameter Sub-grid -->
          <div class="grid grid-cols-2 gap-4 py-4 border-t border-b border-slate-800 font-mono text-xs">
            <div>
              <span class="text-slate-500 block mb-0.5">Monolayer Vol (V_m)</span>
              <span id="res-vm" class="text-white text-base font-bold">--</span>
              <span class="text-slate-500"> cm³/g</span>
            </div>
            <div>
              <span class="text-slate-500 block mb-0.5">BET Constant (C)</span>
              <span id="res-c" class="text-white text-base font-bold">--</span>
            </div>
            <div>
              <span class="text-slate-500 block mb-0.5">Slope (s)</span>
              <span id="res-slope" class="text-slate-300 text-sm font-semibold">--</span>
            </div>
            <div>
              <span class="text-slate-500 block mb-0.5">Intercept (i)</span>
              <span id="res-intercept" class="text-slate-300 text-sm font-semibold">--</span>
            </div>
          </div>

          <!-- Total Sample Surface Sensitivity Indicator -->
          <div class="mt-4 pt-2 flex items-center justify-between text-xs font-mono text-slate-400">
            <span>Total Tube Surface:</span>
            <span id="res-total-area" class="text-emerald-400 font-bold">-- m²</span>
          </div>

          <!-- Rouquerol Consistency Alert Box -->
          <div id="status-box" class="mt-4 p-3 rounded-xl border text-xs leading-relaxed font-mono">
            <!-- Dynamic validation alerts -->
          </div>

          <!-- Action Buttons: Lab SOP & LaTeX -->
          <div class="mt-6 pt-4 border-t border-slate-800/80 space-y-2">
            <button id="copy-sop-btn" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-mono font-medium py-2.5 px-4 rounded-xl text-xs transition flex items-center justify-center gap-2 shadow-lg shadow-emerald-950/50">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
              Copy Lab Notebook SOP
            </button>
            <button id="copy-latex-btn" class="w-full bg-slate-800 hover:bg-slate-700 text-slate-300 font-mono py-2 px-4 rounded-xl text-xs transition flex items-center justify-center gap-2 border border-slate-700">
              <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
              Copy for Overleaf / LaTeX
            </button>
          </div>

        </div>

        <!-- Real-World Benchtop SOP Card -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-md">
          <h3 class="text-xs font-mono uppercase text-slate-400 tracking-wider mb-3 flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
            Generated Laboratory SOP Protocol
          </h3>
          <div id="sop-recipe-text" class="text-xs text-slate-300 space-y-2 leading-relaxed bg-slate-950 p-3 rounded-xl border border-slate-800/80 font-mono">
            <!-- Dynamic Recipe -->
          </div>
        </div>

      </div>

    </div>

    <!-- Below the Fold: Scientific Derivation & IUPAC Standards -->
    <div class="mt-16 pt-12 border-t border-slate-800 text-slate-300 space-y-12">
      
      <!-- Theory & Formulation Section -->
      <section class="max-w-4xl">
        <h2 class="text-2xl font-bold text-white mb-4">
          Theoretical Background: The Brunauer–Emmett–Teller (BET) Equation
        </h2>
        <p class="leading-relaxed mb-4 text-slate-400">
          The BET theory describes multilayer gas adsorption on solid surfaces based on three physical assumptions: identical adsorption energy across the entire first monolayer, non-interacting adsorbed gas molecules, and liquefaction energy for all subsequent layers.
        </p>
        
        <div class="bg-slate-900 border border-slate-800 p-4 rounded-xl font-mono text-sm text-emerald-400 overflow-x-auto text-center my-6">
          1 / [ V<sub>a</sub> · ((P<sub>0</sub>/P) - 1) ] = [ (C - 1) / (V<sub>m</sub> · C) ] · (P/P<sub>0</sub>) + [ 1 / (V<sub>m</sub> · C) ]
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 font-mono text-xs my-4">
          <div class="p-3 bg-slate-900 rounded-xl border border-slate-800">
            <span class="text-slate-400 block mb-1">Monolayer Volume:</span>
            <span class="text-white font-bold text-sm">V_m = 1 / (s + i)</span>
          </div>
          <div class="p-3 bg-slate-900 rounded-xl border border-slate-800">
            <span class="text-slate-400 block mb-1">Adsorption Constant C:</span>
            <span class="text-white font-bold text-sm">C = 1 + (s / i)</span>
          </div>
          <div class="p-3 bg-slate-900 rounded-xl border border-slate-800">
            <span class="text-slate-400 block mb-1">Specific Surface Area:</span>
            <span class="text-white font-bold text-sm">S_BET = (V_m · N_A · σ) / V_molar</span>
          </div>
        </div>
      </section>

      <!-- Rouquerol Consistency Section -->
      <section class="bg-slate-900/60 border border-slate-800 rounded-2xl p-6 max-w-4xl">
        <h3 class="text-lg font-bold text-white mb-2 flex items-center gap-2">
          <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          Rouquerol Consistency Criteria for Microporous Solids
        </h3>
        <p class="text-sm text-slate-400 leading-relaxed mb-4">
          For microporous frameworks (e.g., HKUST-1, UiO-66, ZIF-8), pore filling occurs below P/P₀ = 0.05. Evaluating these materials across the standard mesoporous range (0.05 - 0.30) leads to negative intercepts (i ≤ 0) and unphysical negative C-constants. Two essential consistency rules must be satisfied:
        </p>
        <ol class="list-decimal list-inside space-y-2 text-xs font-mono text-slate-300">
          <li><strong>Monotonic Increase:</strong> The term V<sub>a</sub>(1 - P/P₀) must continuously rise with increasing P/P₀. Any points beyond the maximum must be excluded.</li>
          <li><strong>Positive Y-Intercept:</strong> The intercept i must be strictly greater than zero to yield a positive, physically valid C-constant.</li>
        </ol>
      </section>

      <!-- Rich FAQ Accordion Section -->
      <section class="max-w-4xl">
        <h2 class="text-2xl font-bold text-white mb-6">Frequently Asked Experimental Questions</h2>
        <div class="space-y-4">
          <details class="border border-slate-800 rounded-xl p-4 bg-slate-900/40 group">
            <summary class="font-semibold text-white cursor-pointer list-none flex justify-between items-center text-sm">
              <span>How does sample degassing affect BET measurements?</span>
              <span class="text-emerald-400 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-slate-400 leading-relaxed">
              Incomplete outgassing leaves atmospheric moisture and volatile solvent molecules trapped inside pores, artificially lowering the measured nitrogen capacity and underestimating specific surface area. For stable frameworks, outgassing at 120°C–150°C under high vacuum (&lt; 10⁻³ Torr) for 6–12 hours is recommended.
            </p>
          </details>

