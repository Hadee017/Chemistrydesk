    tabBibtex.className = 'text-slate-400 hover:text-white pb-1';
    tabApa.className = 'text-slate-400 hover:text-white pb-1';
    panelAcs.classList.remove('hidden');
    panelBibtex.classList.add('hidden');
    panelApa.classList.add('hidden');
  });

  tabApa.addEventListener('click', () => {
    tabApa.className = 'text-emerald-400 font-bold border-b-2 border-emerald-400 pb-1';
    tabBibtex.className = 'text-slate-400 hover:text-white pb-1';
