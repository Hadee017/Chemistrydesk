    renderTable();
    syncUrlState();
  });

  sampleMassInput.addEventListener('input', () => {
    syncUrlState();
    calculateBET();
  });

  degasTempInput.addEventListener('input', () => {
    syncUrlState();
    calculateBET();
  });

  adsorbateSelect.addEventListener('change', () => {
    if (adsorbateSelect.value === 'custom') {
      customSigmaRow.classList.remove('hidden');
    } else {
      customSigmaRow.classList.add('hidden');
    }
    syncUrlState();
    calculateBET();
  });

  customSigmaInput.addEventListener('input', () => {
    calculateBET();
  });

  // Modal Triggers
  citeTriggerBtn.addEventListener('click', () => citeModal.classList.remove('hidden'));
  closeModalBtn.addEventListener('click', () => citeModal.classList.add('hidden'));

  labelTriggerBtn.addEventListener('click', () => labelModal.classList.remove('hidden'));
  closeLabelBtn.addEventListener('click', () => labelModal.classList.add('hidden'));

  printLabelAction.addEventListener('click', () => {
    const printContent = document.getElementById('printable-label').outerHTML;
    const printWindow = window.open('', '', 'width=600,height=400');
    printWindow.document.write('<html><head><title>Print Tube Label</title><style>body{margin:20px;font-family:monospace;}</style></head><body>');
    printWindow.document.write(printContent);
    printWindow.document.write('</body></html>');
    printWindow.document.close();
    printWindow.focus();
    printWindow.print();
    printWindow.close();
  });

  // Citation Copy Buttons
  copyBibtexBtn.addEventListener('click', () => {
    navigator.clipboard.writeText(bibtexArea.value).then(() => {
      copyBibtexBtn.textContent = 'Copied to Clipboard!';
      setTimeout(() => copyBibtexBtn.textContent = 'Copy BibTeX', 2000);
    });
  });

  copyAcsBtn.addEventListener('click', () => {
    navigator.clipboard.writeText(acsText.innerText).then(() => {
      copyAcsBtn.textContent = 'Copied to Clipboard!';
      setTimeout(() => copyAcsBtn.textContent = 'Copy ACS Citation', 2000);
    });
  });

  copyApaBtn.addEventListener('click', () => {
    navigator.clipboard.writeText(apaText.innerText).then(() => {
      copyApaBtn.textContent = 'Copied to Clipboard!';
      setTimeout(() => copyApaBtn.textContent = 'Copy APA 7 Citation', 2000);
    });
  });

  copySopBtn.addEventListener('click', () => {
    const text = sopRecipeText.innerText;
    navigator.clipboard.writeText(text).then(() => {
      const orig = copySopBtn.innerHTML;
      copySopBtn.innerHTML = 'SOP Copied to Clipboard!';
      setTimeout(() => copySopBtn.innerHTML = orig, 2000);
    });
  });

  copyLatexBtn.addEventListener('click', () => {
    const latex = `S_{\\text{BET}} = ${resSbet.textContent}\\text{ m}^2/\\text{g} \\quad (V_m = ${resVm.textContent}\\text{ cm}^3/\\text{g},\\; C = ${resC.textContent})`;
    navigator.clipboard.writeText(latex).then(() => {
      const orig = copyLatexBtn.innerHTML;
      copyLatexBtn.innerHTML = 'LaTeX Code Copied!';
      setTimeout(() => copyLatexBtn.innerHTML = orig, 2000);
    });
  });

  exportCsvBtn.addEventListener('click', () => {
    let csv = 'Relative_Pressure_P_P0,Volume_Adsorbed_cm3_g_STP\n';
    points.forEach(pt => csv += `${pt.p},${pt.v}\n`);
    const blob = new Blob([csv], { type: 'text/csv' });
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'chemistrydesk_bet_isotherm.csv';
    a.click();
    window.URL.revokeObjectURL(url);
  });

  saveLocalBtn.addEventListener('click', saveToStorage);

  shareUrlBtn.addEventListener('click', () => {
    syncUrlState();
    navigator.clipboard.writeText(window.location.href).then(() => {
      const orig = shareUrlBtn.innerHTML;
      shareUrlBtn.innerHTML = 'Link Copied!';
      setTimeout(() => shareUrlBtn.innerHTML = orig, 2000);
    });
  });

  // Initialization
  loadUrlState();
  if (!window.location.search) {
    loadFromStorage();
  }
  renderTable();
</script>