  const resSlope = document.getElementById('res-slope');
  const resIntercept = document.getElementById('res-intercept');
  const resTotalArea = document.getElementById('res-total-area');
  const chartR2Badge = document.getElementById('chart-r2-badge');
  const statusBox = document.getElementById('status-box');
  const sopRecipeText = document.getElementById('sop-recipe-text');
  const betChartSvg = document.getElementById('bet-chart');

  // Citation Modal
  const citeTriggerBtn = document.getElementById('cite-trigger-btn');
  const citeModal = document.getElementById('cite-modal');
  const closeModalBtn = document.getElementById('close-modal-btn');
  const tabBibtex = document.getElementById('tab-bibtex');
  const tabAcs = document.getElementById('tab-acs');
  const tabApa = document.getElementById('tab-apa');
  const panelBibtex = document.getElementById('panel-bibtex');
  const panelAcs = document.getElementById('panel-acs');
  const panelApa = document.getElementById('panel-apa');
  const copyBibtexBtn = document.getElementById('copy-bibtex-btn');
  const copyAcsBtn = document.getElementById('copy-acs-btn');
  const copyApaBtn = document.getElementById('copy-apa-btn');
  const bibtexArea = document.getElementById('bibtex-area');
  const acsText = document.getElementById('acs-text');
  const apaText = document.getElementById('apa-text');

  // Tube Label Modal
  const labelTriggerBtn = document.getElementById('label-trigger-btn');
  const labelModal = document.getElementById('label-modal');
  const closeLabelBtn = document.getElementById('close-label-btn');
  const printLabelAction = document.getElementById('print-label-action');
  const lblSample = document.getElementById('lbl-sample');
  const lblGas = document.getElementById('lbl-gas');
  const lblMass = document.getElementById('lbl-mass');
  const lblTemp = document.getElementById('lbl-temp');
  const lblSbet = document.getElementById('lbl-sbet');
  const lblDate = document.getElementById('lbl-date');

  const copySopBtn = document.getElementById('copy-sop-btn');
  const copyLatexBtn = document.getElementById('copy-latex-btn');
  const exportCsvBtn = document.getElementById('export-csv-btn');
  const saveLocalBtn = document.getElementById('save-local-btn');
  const shareUrlBtn = document.getElementById('share-url-btn');

  // Tab Switching
  tabBibtex.addEventListener('click', () => {
    tabBibtex.className = 'text-emerald-400 font-bold border-b-2 border-emerald-400 pb-1';
    tabAcs.className = 'text-slate-400 hover:text-white pb-1';
    tabApa.className = 'text-slate-400 hover:text-white pb-1';
