    panelAcs.classList.add('hidden');
  });

  // LocalStorage
  function loadFromStorage() {
    try {
      const saved = localStorage.getItem('cd_bet_run');
      if (saved) {
        const data = JSON.parse(saved);
        if (data.points && data.points.length >= 2) points = data.points;
        if (data.mass) sampleMassInput.value = data.mass;
        if (data.gas) adsorbateSelect.value = data.gas;
        if (data.temp) degasTempInput.value = data.temp;
      }
    } catch (e) {
      console.warn("Storage load error", e);
    }
  }

  function saveToStorage() {
    try {
      const payload = {
        points,
        mass: sampleMassInput.value,
        gas: adsorbateSelect.value,
        temp: degasTempInput.value,
        savedAt: new Date().toISOString()
      };
      localStorage.setItem('cd_bet_run', JSON.stringify(payload));
      saveLocalBtn.textContent = 'Saved to Cache!';
      setTimeout(() => {
        saveLocalBtn.innerHTML = `
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/></svg>
          Save Run`;
      }, 2000);
    } catch (e) {
      console.warn("Storage save error", e);
    }
  }

  // URL State
  function loadUrlState() {
    const params = new URLSearchParams(window.location.search);
    if (params.has('m')) sampleMassInput.value = params.get('m');
    if (params.has('gas')) adsorbateSelect.value = params.get('gas');
    if (params.has('temp')) degasTempInput.value = params.get('temp');
    if (params.has('pts')) {
      try {
        const decoded = JSON.parse(decodeURIComponent(params.get('pts')));
        if (Array.isArray(decoded) && decoded.length >= 2) points = decoded;
      } catch (e) {
        console.warn("URL parse error", e);
      }
    }
  }

  function syncUrlState() {
    const params = new URLSearchParams();
    params.set('m', sampleMassInput.value);
    params.set('gas', adsorbateSelect.value);
    params.set('temp', degasTempInput.value);
    params.set('pts', JSON.stringify(points));
    window.history.replaceState({}, '', `${window.location.pathname}?${params.toString()}`);
  }

  function renderTable() {
    pointsContainer.innerHTML = '';
    points.forEach((pt, index) => {
      const row = document.createElement('tr');
      row.className = 'hover:bg-slate-800/40 transition';
      row.innerHTML = `
        <td class="py-2 px-2 text-slate-500">${index + 1}</td>
        <td class="py-2 px-2">
          <input type="text" inputmode="decimal" value="${pt.p}" data-index="${index}" data-field="p" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-2.5 py-1 text-sm text-white focus:outline-none focus:border-emerald-500" />
        </td>
        <td class="py-2 px-2">
          <input type="text" inputmode="decimal" value="${pt.v}" data-index="${index}" data-field="v" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-2.5 py-1 text-sm text-white focus:outline-none focus:border-emerald-500" />
        </td>
        <td class="py-2 px-2 text-right">
          <button data-index="${index}" class="delete-btn text-slate-500 hover:text-red-400 transition p-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
          </button>
        </td>
      `;
      pointsContainer.appendChild(row);
    });

    attachRowEvents();
    calculateBET();
  }

  function attachRowEvents() {
    document.querySelectorAll('#points-container input').forEach(input => {
      input.addEventListener('input', (e) => {
        const idx = parseInt(e.target.getAttribute('data-index'), 10);
        const field = e.target.getAttribute('data-field');
        const cleanVal = parseFloat(e.target.value.replace(',', '.')) || 0;
        points[idx][field] = cleanVal;
        syncUrlState();
        calculateBET();
      });
    });

    document.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt(e.currentTarget.getAttribute('data-index'), 10);
        if (points.length > 2) {
          points.splice(idx, 1);
          renderTable();
          syncUrlState();
        } else {
          alert('At least 2 points are required for linear regression.');
        }
      });
    });
  }

  function getEffectiveSigma() {
    if (adsorbateSelect.value === 'custom') {
      return parseFloat(customSigmaInput.value.replace(',', '.')) || 0.162;
    }
    return parseFloat(adsorbateSelect.value) || 0.162;
  }

  function calculateBET() {
    const sigma = getEffectiveSigma();
    const mass = parseFloat(sampleMassInput.value.replace(',', '.')) || 0.1;
    const degasTemp = degasTempInput.value || '120';

    const valid = points.filter(pt => pt.p > 0 && pt.p < 1 && pt.v > 0);
    if (valid.length < 2) {
      resSbet.textContent = '--';
      return;
    }

    const xVals = [];
    const yVals = [];

    for (let i = 0; i < valid.length; i++) {
      const p = valid[i].p;
      const vNorm = valid[i].v / mass;
      const y = 1.0 / (vNorm * ((1.0 / p) - 1.0));
      xVals.push(p);
      yVals.push(y);
    }

    // Linear Regression
    const n = xVals.length;
    let sX = 0, sY = 0, sXY = 0, sXX = 0, sYY = 0;
    for (let i = 0; i < n; i++) {
      sX += xVals[i];
      sY += yVals[i];
      sXY += xVals[i] * yVals[i];
      sXX += xVals[i] * xVals[i];
      sYY += yVals[i] * yVals[i];
    }

    const denom = n * sXX - sX * sX;
    if (Math.abs(denom) < 1e-12) return;

    const slope = (n * sXY - sX * sY) / denom;
    const intercept = (sY - slope * sX) / n;

    const ssTot = sYY - (sY * sY) / n;
    const ssRes = sYY - intercept * sY - slope * sXY;
    const r2 = ssTot !== 0 ? Math.max(0, 1 - (ssRes / ssTot)) : 1.0;

    const vm = 1.0 / (slope + intercept);
    const cConst = 1.0 + (slope / intercept);
    const convFactor = (6.02214076e23 * (sigma * 1e-18)) / 22414.0;
    const sbet = vm * convFactor;
    const totalArea = sbet * mass;

    // Update Output
    resSbet.textContent = sbet.toFixed(1);
    resVm.textContent = vm.toFixed(2);
    resC.textContent = cConst.toFixed(1);
    resSlope.textContent = slope.toFixed(4);
    resIntercept.textContent = intercept.toFixed(4);
    resTotalArea.textContent = `${totalArea.toFixed(2)} m²`;
    chartR2Badge.textContent = `R² = ${r2.toFixed(4)}`;

    // Sync Label Modal Values
    lblMass.textContent = `${mass.toFixed(4)} g`;
    lblTemp.textContent = `${degasTemp} °C`;
    lblSbet.textContent = `${sbet.toFixed(1)} m²/g`;
    lblGas.textContent = adsorbateSelect.options[adsorbateSelect.selectedIndex].text.split('—')[0];
    lblDate.textContent = new Date().toISOString().split('T')[0];

    // Status / Rouquerol Box
    if (intercept <= 0 || cConst <= 0) {
      statusBox.className = 'mt-4 p-3 rounded-xl bg-red-950/40 border border-red-800 text-xs text-red-300';
      statusBox.innerHTML = '<strong>Rouquerol Violation:</strong> Negative intercept detected (C &lt; 0). Exclude higher relative pressure points.';
    } else if (totalArea < 2.0) {
      statusBox.className = 'mt-4 p-3 rounded-xl bg-amber-950/40 border border-amber-800 text-xs text-amber-300';
      statusBox.innerHTML = `<strong>Sensitivity Notice:</strong> Total sample area in tube (${totalArea.toFixed(2)} m²) is below standard transducer sensitivity (≥ 2.0 m²). Increase degassed sample mass.`;
    } else if (r2 < 0.995) {
      statusBox.className = 'mt-4 p-3 rounded-xl bg-amber-950/40 border border-amber-800 text-xs text-amber-300';
      statusBox.innerHTML = '<strong>Linearity Notice:</strong> R² is below 0.995. Inspect if capillary condensation has started.';
    } else {
      statusBox.className = 'mt-4 p-3 rounded-xl bg-emerald-950/40 border border-emerald-800 text-xs text-emerald-300';
      statusBox.innerHTML = '<strong>Valid BET Fit:</strong> High correlation (R² ≥ 0.995) and positive energetic parameter C confirmed.';
    }

    // Dynamic Laboratory Recipe Generation
    sopRecipeText.innerHTML = `
      <p>1. <strong>Degassing:</strong> Activate <strong>${mass.toFixed(4)} g</strong> of adsorbent under high vacuum (&lt; 10⁻³ Torr) at <strong>${degasTemp} °C</strong> for 6–12 h.</p>
      <p>2. <strong>Analysis:</strong> Measure adsorption isotherm at <strong>77.35 K</strong> using <strong>${adsorbateSelect.options[adsorbateSelect.selectedIndex].text.split('—')[0]}</strong>.</p>
      <p>3. <strong>Monolayer Result:</strong> Derived monolayer volume is <strong>${vm.toFixed(2)} cm³/g STP</strong> with an adsorption energy constant C = <strong>${cConst.toFixed(1)}</strong>.</p>
      <p>4. <strong>Audit Surface Area:</strong> S_BET = <strong>${sbet.toFixed(1)} m²/g</strong> (Total tube area: ${totalArea.toFixed(2)} m²).</p>
    `;

    renderSvgPlot(xVals, yVals, slope, intercept);
  }

  // Draw SVG Regression Plot
  function renderSvgPlot(xVals, yVals, slope, intercept) {
    if (xVals.length < 2) return;
    const minX = Math.min(...xVals), maxX = Math.max(...xVals);
    const minY = Math.min(...yVals), maxY = Math.max(...yVals);

    const padX = (maxX - minX) * 0.1 || 0.01;
    const padY = (maxY - minY) * 0.1 || 0.001;

    const x0 = minX - padX, x1 = maxX + padX;
    const y0 = Math.max(0, minY - padY), y1 = maxY + padY;

    function scaleX(val) { return 40 + ((val - x0) / (x1 - x0)) * 430; }
    function scaleY(val) { return 175 - ((val - y0) / (y1 - y0)) * 150; }

    const lineX1 = x0, lineY1 = slope * lineX1 + intercept;
    const lineX2 = x1, lineY2 = slope * lineX2 + intercept;

    let pointsSvg = '';
    for (let i = 0; i < xVals.length; i++) {
      pointsSvg += `<circle cx="${scaleX(xVals[i])}" cy="${scaleY(yVals[i])}" r="4" class="fill-emerald-400 stroke-slate-900" stroke-width="1.5" />`;
    }

    betChartSvg.innerHTML = `
      <line x1="40" y1="175" x2="480" y2="175" stroke="#334155" stroke-width="1" />
      <line x1="40" y1="20" x2="40" y2="175" stroke="#334155" stroke-width="1" />
      <line x1="${scaleX(lineX1)}" y1="${scaleY(lineY1)}" x2="${scaleX(lineX2)}" y2="${scaleY(lineY2)}" stroke="#10b981" stroke-width="2" stroke-dasharray="3 3" />
      ${pointsSvg}
    `;
  }

  // Event Listeners
  addRowBtn.addEventListener('click', () => {
    const lastP = points.length > 0 ? points[points.length - 1].p : 0.05;
    const nextP = parseFloat(Math.min(0.35, lastP + 0.03).toFixed(3));
    points.push({ p: nextP, v: 120.0 });
    renderTable();
    syncUrlState();
  });

  clearAllBtn.addEventListener('click', () => {
    points = [...presets.mcm41];
    renderTable();
    syncUrlState();
  });

  loadMcmBtn.addEventListener('click', () => {
    points = [...presets.mcm41];
    lblSample.textContent = 'MCM-41 Silica';
    renderTable();
    syncUrlState();
  });

  loadMofBtn.addEventListener('click', () => {
    points = [...presets.mof];
