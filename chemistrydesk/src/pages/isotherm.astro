    function solveVanTHoff() {
      const t1 = parseCleanNumber((document.getElementById('thermoT1') as HTMLInputElement).value);
      const k1 = parseCleanNumber((document.getElementById('thermoK1') as HTMLInputElement).value);
      const t2 = parseCleanNumber((document.getElementById('thermoT2') as HTMLInputElement).value);
      const k2 = parseCleanNumber((document.getElementById('thermoK2') as HTMLInputElement).value);
      const t3 = parseCleanNumber((document.getElementById('thermoT3') as HTMLInputElement).value);
      const k3 = parseCleanNumber((document.getElementById('thermoK3') as HTMLInputElement).value);

      const temps = [t1, t2, t3].filter((t, i) => t > 0 && [k1, k2, k3][i] > 0);
      const ks = [k1, k2, k3].filter((k, i) => k > 0 && [t1, t2, t3][i] > 0);

      if (temps.length < 2) return;

      const R = 8.31446;
      const x = temps.map(t => 1 / t);
      const y = ks.map(k => Math.log(k * 55.5 * 1000));

      let sX = 0, sY = 0, sXY = 0, sX2 = 0;
      const n = x.length;
      for (let i = 0; i < n; i++) {
        sX += x[i]; sY += y[i]; sXY += x[i] * y[i]; sX2 += x[i] * x[i];
      }
      const slope = (n * sXY - sX * sY) / (n * sX2 - sX * sX || 1);
      const intercept = (sY - slope * sX) / n;

      const deltaH = (-slope * R) / 1000;
      const deltaS = intercept * R;
      const deltaG298 = deltaH - (298.15 * deltaS) / 1000;

      document.getElementById('outDeltaH')!.textContent = `${deltaH.toFixed(2)} kJ/mol`;
      document.getElementById('outDeltaS')!.textContent = `${deltaS.toFixed(2)} J/(mol·K)`;
      document.getElementById('outDeltaG')!.textContent = `${deltaG298.toFixed(2)} kJ/mol`;

      const verdict = document.getElementById('thermoVerdictText')!;
      const isEndo = deltaH > 0;
      const isSpon = deltaG298 < 0;
      verdict.textContent = `${isEndo ? 'Endothermic (ΔH° > 0)' : 'Exothermic (ΔH° < 0)'} & ${isSpon ? 'Spontaneous (ΔG° < 0)' : 'Non-Spontaneous'} Adsorption`;
      verdict.style.color = isSpon ? '#10b981' : '#dc2626';
      verdict.style.background = isSpon ? '#ecfdf5' : '#fef2f2';
    }

    ['thermoT1', 'thermoK1', 'thermoT2', 'thermoK2', 'thermoT3', 'thermoK3'].forEach(id => {
      document.getElementById(id)?.addEventListener('input', solveVanTHoff);
    });

