   - R²: ${lastTournamentResult.freundlich.r2.toFixed(4)} | RMSE: ${lastTournamentResult.freundlich.rmse.toFixed(3)}

3. DUBININ-RADUSHKEVICH:
   - Mean Free Energy (E): ${pD.E?.value.toFixed(2)} kJ/mol
   - Saturation qD: ${pD.qD?.value.toFixed(2)} mg/g
   - R²: ${lastTournamentResult.dubininRadushkevich.r2.toFixed(4)}
================================================`;

      await navigator.clipboard.writeText(summary);
      const btn = document.getElementById('btnCopySummary')!;
      const oldTxt = btn.textContent;
      btn.textContent = '✅ Copied!';
      setTimeout(() => { btn.textContent = oldTxt; }, 1800);
