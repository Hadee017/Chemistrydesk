---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Adsorption Isotherm Studio | Langmuir, Freundlich, Temkin & D-R Models | ChemistryDesk"
  description="Fit Langmuir, Freundlich, Temkin, and Dubinin-Radushkevich adsorption isotherms. Batch mass-balance solver, non-linear error metrics (R², RMSE, χ²), mean energy E, and dynamic SVG equilibrium curves."
>
  <!-- Schema: WebApplication -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "ChemistryDesk Adsorption Isotherm Studio",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "All",
    "browserRequirements": "Requires JavaScript",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": [
      "Langmuir Monolayer Fitting & RL Separation Factor",
      "Freundlich Multilayer Heterogeneity Solver",
      "Temkin Heat of Sorption Estimation",
      "Dubinin-Radushkevich Mean Free Energy (E) Calculation",
      "Dynamic SVG Isotherm Overlay Plot",
      "OriginLab and GraphPad Prism CSV Export"
    ]
  })} />

  <!-- Schema: FAQPage -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is the difference between Langmuir and Freundlich adsorption isotherms?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The Langmuir model assumes monolayer adsorption onto a finite number of energetically equivalent, homogeneous sites without transmigration. The Freundlich model is an empirical equation describing reversible, non-ideal multilayer adsorption onto energetically heterogeneous surfaces."
        }
      },
      {
        "@type": "Question",
        "name": "How does the separation factor (RL) determine adsorption feasibility?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The dimensionless separation factor RL = 1 / (1 + KL * C0) defines whether adsorption is irreversible (RL = 0), favorable (0 < RL < 1), linear (RL = 1), or unfavorable (RL > 1)."
        }
      },
      {
        "@type": "Question",
        "name": "How does Dubinin-Radushkevich mean free energy (E) distinguish physisorption from chemisorption?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The mean free energy of adsorption E = 1 / sqrt(2 * beta). If E < 8 kJ/mol, the process is dominated by physical forces (physisorption). If 8 <= E <= 16 kJ/mol, ion-exchange or electrostatic sorption dominates. If E > 16 kJ/mol, chemical bonding (chemisorption) governs adsorption."
        }
      }
    ]
  })} />

  <main style="max-width: 1100px; margin: 1.5rem auto 3rem auto; padding: 0 1.5rem; font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #1e293b;">
    
