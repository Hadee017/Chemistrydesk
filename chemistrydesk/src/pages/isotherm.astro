      <a href="/" style="color: #0284c7; text-decoration: none; font-weight: 600;">Home</a> &rsaquo; 
      <span style="color: #94a3b8;"> Materials &amp; Environmental</span> &rsaquo; 
      <span style="color: #0f172a; font-weight: 700;">Adsorption Isotherm Studio</span>
    </nav>

    <!-- Header Section -->
    <div style="border-bottom: 1px solid #e2e8f0; padding-bottom: 1.75rem; margin-bottom: 2rem;">
      <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem;">
        <span style="font-size: 2.5rem;">🧲</span>
        <div>
