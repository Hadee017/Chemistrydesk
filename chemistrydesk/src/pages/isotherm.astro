    function renderActivePlotView() {
      const valid = dataPoints.filter(p => p.ce > 0 && p.qe > 0);
      if (valid.length < 2 || !lastTournamentResult) return;

      const svg = document.getElementById('isothermSvg')!;
      const w = 500, h = 320, padL = 55, padR = 25, padT = 25, padB = 40;

      if (currentPlotView === 'equilibrium') {
        renderEquilibriumPlot(valid, lastTournamentResult);
        return;
      }

      let xVals: number[] = [];
      let yVals: number[] = [];
      let xLabel = 'Equilibrium Concentration Ce (mg/L)';
      let yLabel = 'Adsorption Uptake qe (mg/g)';

      if (currentPlotView === 'langmuir') {
        xVals = valid.map(p => p.ce);
        yVals = valid.map(p => p.ce / p.qe);
        xLabel = 'Ce (mg/L)';
        yLabel = 'Ce / qe (g/L)';
      } else if (currentPlotView === 'freundlich') {
        xVals = valid.map(p => Math.log(p.ce));
        yVals = valid.map(p => Math.log(p.qe));
        xLabel = 'ln(Ce)';
        yLabel = 'ln(qe)';
      } else if (currentPlotView === 'dr') {
        const tempK = parseCleanNumber(inpTempK.value) || 298.15;
        const R = 8.31446;
        xVals = valid.map(p => Math.pow(R * tempK * Math.log(1 + 1 / p.ce), 2));
        yVals = valid.map(p => Math.log(p.qe));
        xLabel = 'ε² (J²/mol²)';
        yLabel = 'ln(qe)';
      }

      const rawMinX = Math.min(...xVals);
      const rawMaxX = Math.max(...xVals);
      const rawMinY = Math.min(...yVals);
      const rawMaxY = Math.max(...yVals);

      const spanX = rawMaxX - rawMinX || 1;
      const spanY = rawMaxY - rawMinY || 1;

      const minX = rawMinX - spanX * 0.05;
      const maxX = rawMaxX + spanX * 0.1;
      const minY = rawMinY - spanY * 0.05;
      const maxY = rawMaxY + spanY * 0.1;

      const scaleX = (val: number) => padL + ((val - minX) / (maxX - minX)) * (w - padL - padR);
      const scaleY = (val: number) => h - padB - ((val - minY) / (maxY - minY)) * (h - padT - padB);

      let svgHtml = `
        <line x1="${padL}" y1="${h - padB}" x2="${w - padR}" y2="${h - padB}" stroke="#cbd5e1" stroke-width="2"/>
        <line x1="${padL}" y1="${padT}" x2="${padL}" y2="${h - padB}" stroke="#cbd5e1" stroke-width="2"/>
        <text x="${w / 2}" y="${h - 8}" text-anchor="middle" font-size="11" fill="#475569" font-weight="bold">${xLabel}</text>
        <text x="14" y="${h / 2}" text-anchor="middle" font-size="11" fill="#475569" font-weight="bold" transform="rotate(-90 14 ${h / 2})">${yLabel}</text>
      `;

      for (let i = 0; i <= 4; i++) {
        const xV = minX + ((maxX - minX) / 4) * i;
        const yV = minY + ((maxY - minY) / 4) * i;
        svgHtml += `
          <text x="${scaleX(xV)}" y="${h - padB + 14}" text-anchor="middle" font-size="9" fill="#94a3b8">${xV.toFixed(1)}</text>
          <text x="${padL - 6}" y="${scaleY(yV) + 3}" text-anchor="end" font-size="9" fill="#94a3b8">${yV.toFixed(1)}</text>
          <line x1="${padL}" y1="${scaleY(yV)}" x2="${w - padR}" y2="${scaleY(yV)}" stroke="#f1f5f9" stroke-width="1"/>
        `;
      }

      const n = xVals.length;
      let sX = 0, sY = 0, sXY = 0, sX2 = 0;
      for (let i = 0; i < n; i++) {
        sX += xVals[i]; sY += yVals[i]; sXY += xVals[i] * yVals[i]; sX2 += xVals[i] * xVals[i];
      }
      const slope = (n * sXY - sX * sY) / (n * sX2 - sX * sX || 1);
      const intercept = (sY - slope * sX) / n;

      const p1x = scaleX(minX);
      const p1y = scaleY(slope * minX + intercept);
      const p2x = scaleX(maxX);
      const p2y = scaleY(slope * maxX + intercept);
      svgHtml += `<line x1="${p1x}" y1="${p1y}" x2="${p2x}" y2="${p2y}" stroke="#0284c7" stroke-width="2.5" />`;

      for (let i = 0; i < n; i++) {
        svgHtml += `<circle cx="${scaleX(xVals[i])}" cy="${scaleY(yVals[i])}" r="4.5" fill="#0f172a" stroke="#fff" stroke-width="1.5"/>`;
      }

      svg.innerHTML = svgHtml;
    }

    function renderEquilibriumPlot(points: IsothermPoint[], res: any) {
      const svg = document.getElementById('isothermSvg')!;
      const w = 500, h = 320, padL = 55, padR = 25, padT = 25, padB = 40;

      const maxCe = Math.max(...points.map(p => p.ce)) * 1.15 || 10;
      const maxQe = Math.max(...points.map(p => p.qe)) * 1.2 || 10;

      const scaleX = (val: number) => padL + (val / maxCe) * (w - padL - padR);
      const scaleY = (val: number) => h - padB - (val / maxQe) * (h - padT - padB);

      let svgHtml = `
        <line x1="${padL}" y1="${h - padB}" x2="${w - padR}" y2="${h - padB}" stroke="#cbd5e1" stroke-width="2"/>
        <line x1="${padL}" y1="${padT}" x2="${padL}" y2="${h - padB}" stroke="#cbd5e1" stroke-width="2"/>
        <text x="${w / 2}" y="${h - 8}" text-anchor="middle" font-size="11" fill="#475569" font-weight="bold">Equilibrium Concentration Ce (${(document.getElementById('selConcUnit') as HTMLSelectElement).value})</text>
        <text x="14" y="${h / 2}" text-anchor="middle" font-size="11" fill="#475569" font-weight="bold" transform="rotate(-90 14 ${h / 2})">Adsorption Uptake qe (mg/g)</text>
      `;

      for (let i = 0; i <= 4; i++) {
        const xVal = (maxCe / 4) * i;
        const yVal = (maxQe / 4) * i;
        svgHtml += `
          <text x="${scaleX(xVal)}" y="${h - padB + 14}" text-anchor="middle" font-size="9" fill="#94a3b8">${xVal.toFixed(0)}</text>
          <text x="${padL - 6}" y="${scaleY(yVal) + 3}" text-anchor="end" font-size="9" fill="#94a3b8">${yVal.toFixed(0)}</text>
          <line x1="${padL}" y1="${scaleY(yVal)}" x2="${w - padR}" y2="${scaleY(yVal)}" stroke="#f1f5f9" stroke-width="1"/>
        `;
      }

      let langD = '';
      for (let cx = 0; cx <= maxCe; cx += maxCe / 40) {
        const qPred = res.langmuir.predictQe(cx);
        langD += (cx === 0 ? `M ${scaleX(cx)} ${scaleY(qPred)}` : ` L ${scaleX(cx)} ${scaleY(qPred)}`);
      }
      svgHtml += `<path d="${langD}" fill="none" stroke="#0284c7" stroke-width="2.5" />`;

      let freundD = '';
      for (let cx = maxCe / 40; cx <= maxCe; cx += maxCe / 40) {
        const qPred = res.freundlich.predictQe(cx);
        freundD += (freundD === '' ? `M ${scaleX(cx)} ${scaleY(qPred)}` : ` L ${scaleX(cx)} ${scaleY(qPred)}`);
      }
      svgHtml += `<path d="${freundD}" fill="none" stroke="#10b981" stroke-width="2" stroke-dasharray="4,3" />`;

      points.forEach(p => {
        svgHtml += `<circle cx="${scaleX(p.ce)}" cy="${scaleY(p.qe)}" r="4.5" fill="#0f172a" stroke="#fff" stroke-width="1.5"/>`;
      });

      svg.innerHTML = svgHtml;
    }

