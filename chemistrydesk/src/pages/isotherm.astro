      const bestR2 = lastTournamentResult.bestR2.toFixed(4);
      const qmax = pL.qmax?.value.toFixed(2);
      const kL = pL.kL?.value.toFixed(4);
      const EkJ = pD.E?.value.toFixed(2);
      const rlStatus = lastTournamentResult.rlCurve[0] ? lastTournamentResult.rlCurve[0].status.toLowerCase() : 'favorable';

      const paragraph = `Equilibrium adsorption data were modeled using linear and non-linear regressions across the Langmuir, Freundlich, Temkin, and Dubinin-Radushkevich isotherm equations. The experimental equilibrium was best described by the ${best} isotherm model (R² = ${bestR2}), yielding a maximum monolayer adsorption capacity (q_max) of ${qmax} mg/g and a Langmuir affinity constant (K_L) of ${kL} L/mg. The dimensionless separation factor (R_L) confirmed ${rlStatus} sorption across the investigated concentration domain. Furthermore, the mean free energy of adsorption estimated via the Dubinin-Radushkevich model was E = ${EkJ} kJ/mol, indicating that the uptake process is predominantly governed by ${EkJ < 8 ? 'physisorption through weak physical interactions' : EkJ <= 16 ? 'ion-exchange and electrostatic coordination' : 'chemisorption via chemical bonding'}.`;

      await navigator.clipboard.writeText(paragraph);
