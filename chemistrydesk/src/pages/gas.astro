  <style>
    .gas-preset-btn {
      background: #f8fafc;
      border: 1.5px solid #cbd5e1;
      padding: 0.35rem 0.65rem;
      border-radius: 6px;
      cursor: pointer;
      color: #1e293b;
      font-size: 0.78rem;
      font-weight: 700;
      transition: all 0.15s ease;
    }
    .gas-preset-btn:hover {
      background: #e0f2fe;
      border-color: #0284c7;
      color: #0284c7;
    }
    .gas-preset-btn.active {
      background: #0284c7;
      color: #ffffff;
      border-color: #0284c7;
    }
  </style>

  <script>
    import {
      calculateGasSystem,
      generateIsothermPoints,
      COMMON_GASES,
      type PressureUnit,
      type VolumeUnit,
      type TempUnit,
      type AmountUnit,
      type SolveTarget
    } from '../utils/gasMath';

    // DOM Elements
    const selSolveFor = document.getElementById('selSolveFor') as HTMLSelectElement;
    const inpP = document.getElementById('inpP') as HTMLInputElement;
    const unitP = document.getElementById('unitP') as HTMLSelectElement;
    const inpV = document.getElementById('inpV') as HTMLInputElement;
    const unitV = document.getElementById('unitV') as HTMLSelectElement;
    const inpN = document.getElementById('inpN') as HTMLInputElement;
    const unitN = document.getElementById('unitN') as HTMLSelectElement;
    const inpT = document.getElementById('inpT') as HTMLInputElement;
    const unitT = document.getElementById('unitT') as HTMLSelectElement;

    const inpMW = document.getElementById('inpMW') as HTMLInputElement;
    const inpVdwA = document.getElementById('inpVdwA') as HTMLInputElement;
    const inpVdwB = document.getElementById('inpVdwB') as HTMLInputElement;

    const rowP = document.getElementById('rowP')!;
    const rowV = document.getElementById('rowV')!;
    const rowN = document.getElementById('rowN')!;
    const rowT = document.getElementById('rowT')!;
    const lblN = document.getElementById('lblN')!;

    const outputHeaderLabel = document.getElementById('outputHeaderLabel')!;
    const primarySolvedDisplay = document.getElementById('primarySolvedDisplay')!;
    const nonIdealityBadge = document.getElementById('nonIdealityBadge')!;
    const realGasOutputText = document.getElementById('realGasOutputText')!;
    const dispZFactor = document.getElementById('dispZFactor')!;
    const dispDensity = document.getElementById('dispDensity')!;
    const dispMolarVol = document.getElementById('dispMolarVol')!;

    const curvePath = document.getElementById('curvePath')!;
    const stateDot = document.getElementById('stateDot')!;
    const stateLabel = document.getElementById('stateLabel')!;
    const activeGasLabel = document.getElementById('activeGasLabel')!;

    function parseNum(val: string): number {
      const clean = val.replace(',', '.').trim();
      const n = parseFloat(clean);
      return Number.isFinite(n) ? n : 0;
    }

    function syncTargetUi() {
      const target = selSolveFor.value as SolveTarget;
      // Reset displays
      [rowP, rowV, rowN, rowT].forEach(r => r.style.opacity = '1');
      inpP.disabled = false;
      inpV.disabled = false;
      inpN.disabled = false;
      inpT.disabled = false;

      if (target === 'P') {
        rowP.style.opacity = '0.5';
        inpP.disabled = true;
        outputHeaderLabel.textContent = 'Calculated Pressure (Ideal Gas)';
      } else if (target === 'V') {
        rowV.style.opacity = '0.5';
        inpV.disabled = true;
        outputHeaderLabel.textContent = 'Calculated Volume (Ideal Gas)';
      } else if (target === 'n') {
        rowN.style.opacity = '0.5';
        inpN.disabled = true;
        lblN.textContent = 'QUANTITY OF SUBSTANCE (Molar)';
        outputHeaderLabel.textContent = 'Calculated Moles of Gas';
      } else if (target === 'm') {
        rowN.style.opacity = '0.5';
        inpN.disabled = true;
        lblN.textContent = 'QUANTITY OF SUBSTANCE (Mass)';
        outputHeaderLabel.textContent = 'Calculated Mass of Gas (g)';
      } else if (target === 'T') {
        rowT.style.opacity = '0.5';
        inpT.disabled = true;
        outputHeaderLabel.textContent = 'Calculated Temperature';
      }
    }

    function runEngine() {
      const solveFor = selSolveFor.value as SolveTarget;
      const res = calculateGasSystem({
        solveFor,
        P_val: parseNum(inpP.value),
        P_unit: unitP.value as PressureUnit,
        V_val: parseNum(inpV.value),
        V_unit: unitV.value as VolumeUnit,
        n_val: parseNum(inpN.value),
        n_unit: unitN.value as AmountUnit,
        T_val: parseNum(inpT.value),
        T_unit: unitT.value as TempUnit,
        molarMass: parseNum(inpMW.value),
        vdw_a: parseNum(inpVdwA.value),
        vdw_b: parseNum(inpVdwB.value),
      });

      if (!res.isValid) {
        primarySolvedDisplay.textContent = '--';
        realGasOutputText.textContent = res.errorMessage || 'Invalid values';
        return;
      }

      // Format Solved Value
      const formatted = res.solvedValue >= 1000 || (res.solvedValue < 0.001 && res.solvedValue > 0)
        ? res.solvedValue.toExponential(4)
        : res.solvedValue.toFixed(res.solvedValue >= 10 ? 3 : 4);

      primarySolvedDisplay.textContent = `${formatted} ${res.solvedUnit}`;

      // Real Gas Comparison
      if (res.realP_Pa !== undefined && solveFor === 'P') {
        const pAtm = res.realP_Pa / 101325;
        realGasOutputText.textContent = `${pAtm.toFixed(3)} atm (${res.percentNonIdeality.toFixed(2)}% dev)`;
      } else if (res.realP_Pa !== undefined) {
        realGasOutputText.textContent = `Real P: ${(res.realP_Pa / 101325).toFixed(3)} atm`;
      } else {
        realGasOutputText.textContent = 'V <= nb (Volume below molecular co-volume)';
      }

      // Non-ideality Badge
      if (res.percentNonIdeality > 5) {
        nonIdealityBadge.textContent = `High Non-Ideality (${res.percentNonIdeality.toFixed(1)}% dev)`;
        nonIdealityBadge.style.background = '#e11d48';
      } else if (res.percentNonIdeality > 1) {
        nonIdealityBadge.textContent = `Noticeable Deviation (${res.percentNonIdeality.toFixed(1)}%)`;
        nonIdealityBadge.style.background = '#f59e0b';
      } else {
        nonIdealityBadge.textContent = `Ideal Behavior (${res.percentNonIdeality.toFixed(2)}% dev)`;
        nonIdealityBadge.style.background = '#0284c7';
      }

      // Diagnostics
      dispZFactor.textContent = res.compressibilityFactor_Z.toFixed(4);
      dispDensity.textContent = `${res.density_g_L.toFixed(3)} g/L`;
      dispMolarVol.textContent = `${res.molarVolume_L_mol.toFixed(3)} L/mol`;

      // Draw SVG Isotherm
      renderSvgCurve(res.n_mol, res.T_K, res.V_m3 * 1000, res.P_Pa / 101325);
    }

    function renderSvgCurve(n_mol: number, T_K: number, v_L: number, p_atm: number) {
      if (n_mol <= 0 || T_K <= 0 || v_L <= 0) return;
      const pts = generateIsothermPoints(n_mol, T_K, v_L);
      if (pts.length < 2) return;

      const minV = pts[0].v;
      const maxV = pts[pts.length - 1].v;
      const maxP = Math.max(...pts.map(pt => pt.p_ideal)) * 1.1;

      const svgW = 340;
      const svgH = 120;

      const d = pts.map((pt, idx) => {
        const x = 40 + ((pt.v - minV) / (maxV - minV)) * svgW;
        const y = 135 - (pt.p_ideal / maxP) * svgH;
        return `${idx === 0 ? 'M' : 'L'} ${x.toFixed(1)} ${Math.max(15, y).toFixed(1)}`;
      }).join(' ');

      curvePath.setAttribute('d', d);

      // Dot position
      const dotX = 40 + (Math.min(Math.max(v_L, minV), maxV) - minV) / (maxV - minV) * svgW;
      const dotY = 135 - (p_atm / maxP) * svgH;
      stateDot.setAttribute('cx', dotX.toFixed(1));
      stateDot.setAttribute('cy', Math.max(15, Math.min(135, dotY)).toFixed(1));
      stateLabel.setAttribute('x', dotX.toFixed(1));
      stateLabel.setAttribute('y', Math.max(25, dotY - 10).toFixed(1));
      stateLabel.textContent = `${p_atm.toFixed(1)} atm, ${v_L.toFixed(1)} L`;
    }

    // Event Listeners
    selSolveFor.addEventListener('change', () => {
      syncTargetUi();
      runEngine();
    });

    [inpP, inpV, inpN, inpT, inpMW, inpVdwA, inpVdwB].forEach(inp => {
      inp.addEventListener('input', runEngine);
    });

    [unitP, unitV, unitN, unitT].forEach(sel => {
      sel.addEventListener('change', runEngine);
    });

    // Preset Gases
    document.querySelectorAll('.gas-preset-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        document.querySelectorAll('.gas-preset-btn').forEach(b => b.classList.remove('active'));
        target.classList.add('active');

        const gasKey = target.dataset.gas!;
        const g = COMMON_GASES[gasKey];
        if (g) {
          inpMW.value = g.molarMass.toString();
          inpVdwA.value = g.vdw_a.toString();
          inpVdwB.value = g.vdw_b.toString();
          activeGasLabel.textContent = g.name;
          runEngine();
        }
      });
    });

    // STP Presets
    document.querySelectorAll('.cond-preset-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        inpP.value = target.dataset.p!;
        unitP.value = target.dataset.pu!;
        inpT.value = target.dataset.t!;
        unitT.value = target.dataset.tu!;
        runEngine();
      });
    });

    // Share URL
    document.getElementById('btnShareUrl')?.addEventListener('click', async () => {
      const p = new URLSearchParams();
      p.set('solve', selSolveFor.value);
      p.set('p', inpP.value);
      p.set('pu', unitP.value);
      p.set('v', inpV.value);
      p.set('vu', unitV.value);
      p.set('n', inpN.value);
      p.set('nu', unitN.value);
      p.set('t', inpT.value);
      p.set('tu', unitT.value);
      p.set('mw', inpMW.value);
      window.history.replaceState({}, '', `${window.location.pathname}?${p.toString()}`);
      await navigator.clipboard.writeText(window.location.href);
      alert('Thermodynamic state URL copied to clipboard.');
    });

    // CSV Exporter
    document.getElementById('btnExportCsv')?.addEventListener('click', () => {
      let csv = 'Variable,Value,Unit\n';
      csv += `SolveTarget,${selSolveFor.value},\n`;
      csv += `Pressure,${inpP.value},${unitP.value}\n`;
      csv += `Volume,${inpV.value},${unitV.value}\n`;
      csv += `Quantity,${inpN.value},${unitN.value}\n`;
      csv += `Temperature,${inpT.value},${unitT.value}\n`;
      csv += `MolarMass,${inpMW.value},g/mol\n`;
      csv += `Vdw_a,${inpVdwA.value},bar*L^2/mol^2\n`;
      csv += `Vdw_b,${inpVdwB.value},L/mol\n`;
      const blob = new Blob([csv], { type: 'text/csv' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `gas_thermodynamics_${Date.now()}.csv`;
      a.click();
      URL.revokeObjectURL(url);
    });

    // Copy Report
    document.getElementById('btnCopyReport')?.addEventListener('click', async () => {
      const report = `========================================
CHEMISTRYDESK GAS THERMODYNAMICS REPORT
Target: ${selSolveFor.value}
Solved Result: ${primarySolvedDisplay.textContent}
Real Gas Output: ${realGasOutputText.textContent}
Compressibility (Z): ${dispZFactor.textContent}
Gas Density: ${dispDensity.textContent}
Molar Volume: ${dispMolarVol.textContent}
========================================`;
      await navigator.clipboard.writeText(report);
      alert('Thermodynamic summary copied to clipboard.');
    });

    // Copy LaTeX
    document.getElementById('btnCopyLatex')?.addEventListener('click', async () => {
      const latex = `% Ideal Gas Law & Van der Waals (ChemistryDesk)
\\begin{aligned}
  PV &= nRT \\implies P = \\frac{nRT}{V} \\\\
  \\left(P + a\\frac{n^2}{V^2}\\right)(V - nb) &= nRT
\\end{aligned}`;
      await navigator.clipboard.writeText(latex);
      alert('LaTeX equations copied to clipboard.');
    });

    // Citation Drawer Logic
    const citeDrawer = document.getElementById('citeDrawer')!;
    const toggleCiteBtn = document.getElementById('toggleCiteBtn')!;
    const inlineCiteOutput = document.getElementById('inlineCiteOutput')!;
    const inlineTabs = document.querySelectorAll('.inline-cite-tab');
    const inlineCopyBtn = document.getElementById('inlineCopyCiteBtn')!;
    const doi = "10.5281/zenodo.23059466";
    const year = new Date().getFullYear();

    const citations: Record<string, string> = {
      bibtex: `@software{khan_chemistrydesk_gas_${year},
  author        = {Khan, Bilal},
  title         = {ChemistryDesk: Ideal & Real Gas Thermodynamics Studio},
  year          = {${year}},
  version       = {v1.0.1},
  publisher     = {Zenodo},
  doi           = {${doi}},
  url           = {https://chemistrycal.com/gas}
}`,
      acs: `Khan, B. ChemistryDesk: Ideal & Real Gas Thermodynamics Studio, version 1.0.1; Zenodo, ${year}. https://doi.org/${doi}.`,
      rsc: `B. Khan, ChemistryDesk: Ideal & Real Gas Thermodynamics Studio, version 1.0.1, Zenodo, ${year}, DOI: ${doi}.`,
      nature: `Khan, B. ChemistryDesk: Ideal & Real Gas Thermodynamics Studio. Zenodo https://doi.org/${doi} (${year}).`,
      elsevier: `Khan, B., ${year}. ChemistryDesk: Ideal & Real Gas Thermodynamics Studio (Version 1.0.1). Zenodo. https://doi.org/${doi}.`,
      wiley: `B. Khan, ChemistryDesk: Ideal & Real Gas Thermodynamics Studio, version 1.0.1, Zenodo, ${year}, DOI: ${doi}.`
    };

    let activeFormat = 'bibtex';
    function updateCite() {
      inlineCiteOutput.textContent = citations[activeFormat] || citations['bibtex'];
    }

    toggleCiteBtn.addEventListener('click', (e) => {
      e.preventDefault();
      const isHidden = citeDrawer.style.display === 'none';
      citeDrawer.style.display = isHidden ? 'block' : 'none';
      if (isHidden) updateCite();
    });

    inlineTabs.forEach(tab => {
      tab.addEventListener('click', (e) => {
        e.preventDefault();
        inlineTabs.forEach(t => {
          (t as HTMLElement).style.background = '#fff';
          (t as HTMLElement).style.color = '#334155';
          (t as HTMLElement).style.borderColor = '#cbd5e1';
          (t as HTMLElement).style.fontWeight = '600';
        });
        const el = tab as HTMLElement;
        el.style.background = '#0f172a';
        el.style.color = '#fff';
        el.style.borderColor = '#0f172a';
        el.style.fontWeight = '700';
        activeFormat = el.dataset.format || 'bibtex';
        updateCite();
      });
    });

    inlineCopyBtn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(citations[activeFormat]);
      alert('Academic citation copied.');
    });

    // Check URL state on load
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('solve')) selSolveFor.value = urlParams.get('solve')!;
    if (urlParams.has('p')) inpP.value = urlParams.get('p')!;
    if (urlParams.has('pu')) unitP.value = urlParams.get('pu')!;
    if (urlParams.has('v')) inpV.value = urlParams.get('v')!;
    if (urlParams.has('vu')) unitV.value = urlParams.get('vu')!;
    if (urlParams.has('n')) inpN.value = urlParams.get('n')!;
    if (urlParams.has('nu')) unitN.value = urlParams.get('nu')!;
    if (urlParams.has('t')) inpT.value = urlParams.get('t')!;
    if (urlParams.has('tu')) unitT.value = urlParams.get('tu')!;
    if (urlParams.has('mw')) inpMW.value = urlParams.get('mw')!;

    updateCite();
    syncTargetUi();
    runEngine();
  </script>
</BaseLayout>