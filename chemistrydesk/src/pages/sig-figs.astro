          chip.style.flexDirection = 'column';
          chip.style.alignItems = 'center';
          chip.style.padding = '0.35rem 0.55rem';
          chip.style.borderRadius = '6px';
          chip.style.backgroundColor = d.colorHex;
          chip.style.color = '#ffffff';
          chip.style.fontWeight = '800';
          chip.style.fontFamily = 'monospace';
          chip.style.fontSize = '1.05rem';
          chip.title = d.explanation;

          const spanChar = document.createElement('span');
          spanChar.textContent = d.char;
          chip.appendChild(spanChar);

          const spanTag = document.createElement('span');
          spanTag.style.fontSize = '0.62rem';
          spanTag.style.fontWeight = '600';
          spanTag.style.textTransform = 'uppercase';
          spanTag.style.opacity = '0.9';
          spanTag.textContent = d.isSignificant ? 'Sig' : (d.role === 'decimal_point' ? 'Dec' : 'No');
          chip.appendChild(spanTag);

          visualDigitBar.appendChild(chip);
        });

        // Rules List
        containerRulesList.innerHTML = '';
        res.rulesApplied.forEach(rule => {
          const div = document.createElement('div');
          div.style.padding = '0.55rem 0.75rem';
          div.style.borderRadius = '6px';
          div.style.backgroundColor = '#f8fafc';
          div.style.border = '1px solid #e2e8f0';
          div.style.fontSize = '0.85rem';
          div.style.fontWeight = '600';
          div.style.color = '#334155';
          div.textContent = `• ${rule}`;
          containerRulesList.appendChild(div);
        });

      } else if (currentMode === 'expr') {
        const expr = inpExprVal.value.trim();
        const res = evaluateSigFigExpression(expr);
        lastExprResult = res;

        if (!res.isValid) {
          sigFigAlert.textContent = res.errorMessage || 'Invalid arithmetic expression.';
          sigFigAlert.style.display = 'block';
          return;
        }

        badgeSigFigType.textContent = `Rounded Answer: ${res.roundedValue}`;
        dispHudMain.innerHTML = `${res.roundedValue} <span style="font-size: 1.25rem; color: #94a3b8; font-weight: 700;">(${res.sigFigs} SF)</span>`;
        dispDecimalsCount.textContent = res.decimalPlaces.toString();

        dispSciNotation.textContent = res.scientificNotation;
        dispEngNotation.textContent = res.scientificNotation;
        dispENotation.textContent = parseFloat(res.roundedValue).toExponential().replace('e', 'E');

        // Visual Bar for Expression
        visualDigitBar.innerHTML = '';
        const chip = document.createElement('div');
        chip.style.padding = '0.4rem 0.85rem';
        chip.style.borderRadius = '6px';
        chip.style.backgroundColor = '#0284c7';
        chip.style.color = '#ffffff';
        chip.style.fontWeight = '800';
        chip.style.fontFamily = 'monospace';
        chip.textContent = `${res.expression} = ${res.roundedValue}`;
        visualDigitBar.appendChild(chip);

        // Rules & Steps Container
        containerRulesList.innerHTML = '';
        res.steps.forEach(s => {
          const div = document.createElement('div');
          div.style.padding = '0.65rem 0.85rem';
          div.style.borderRadius = '6px';
          div.style.backgroundColor = '#f8fafc';
          div.style.border = '1px solid #cbd5e1';
          div.style.fontSize = '0.85rem';
          div.style.color = '#0f172a';
          div.innerHTML = `<strong>${s.description}</strong><br /><span style="color: #64748b; font-size: 0.8rem;">${s.limitingFactor}</span><br /><span style="font-family: monospace; color: #0284c7; font-weight: 700;">Raw Intermediate: ${s.rawIntermediate} &rarr; Standard Round: ${s.intermediateRounded}</span>`;
          containerRulesList.appendChild(div);
        });

      } else {
        const raw = parseFloat(inpRoundVal.value) || 0;
        const target = parseInt(inpTargetSigFigs.value, 10) || 3;
        lblTargetNum.textContent = target.toString();

        const rounded = roundToSigFigs(raw, target);
        lastRoundString = rounded;

        badgeSigFigType.textContent = `Rounded to ${target} Significant Figures`;
        dispHudMain.innerHTML = `${rounded} <span style="font-size: 1.25rem; color: #94a3b8; font-weight: 700;">(${target} SF)</span>`;
        dispDecimalsCount.textContent = rounded.includes('.') ? (rounded.split('.')[1].length).toString() : '0';

        dispSciNotation.textContent = parseFloat(rounded).toExponential();
        dispEngNotation.textContent = parseFloat(rounded).toExponential();
        dispENotation.textContent = parseFloat(rounded).toExponential().replace('e', 'E');

        // Visual Bar
        visualDigitBar.innerHTML = '';
        const chip = document.createElement('div');
        chip.style.padding = '0.4rem 0.85rem';
        chip.style.borderRadius = '6px';
        chip.style.backgroundColor = '#10b981';
        chip.style.color = '#ffffff';
        chip.style.fontWeight = '800';
        chip.style.fontFamily = 'monospace';
        chip.textContent = `Raw: ${inpRoundVal.value} ➔ ${rounded} (${target} Sig Figs)`;
        visualDigitBar.appendChild(chip);

        containerRulesList.innerHTML = `
          <div style="padding: 0.65rem 0.85rem; border-radius: 6px; background-color: #f8fafc; border: 1px solid #cbd5e1; font-size: 0.85rem; color: #0f172a;">
            <strong>Target Precision Rounding:</strong><br />
            Input: ${inpRoundVal.value}<br />
            Target count: ${target} significant figures.<br />
            Final exact format: <strong>${rounded}</strong>
          </div>
        `;
      }
    }

    // Tab Listeners
    tabBtnCount.addEventListener('click', () => switchMode('count'));
    tabBtnExpr.addEventListener('click', () => switchMode('expr'));
    tabBtnRound.addEventListener('click', () => switchMode('round'));

    // Input Listeners
    inpCountVal.addEventListener('input', runCalculation);
    inpExprVal.addEventListener('input', runCalculation);
    inpRoundVal.addEventListener('input', runCalculation);
    inpTargetSigFigs.addEventListener('input', runCalculation);

    // Paste from Clipboard
    document.getElementById('btnPasteCount')?.addEventListener('click', async () => {
      try {
        const text = await navigator.clipboard.readText();
        inpCountVal.value = text.trim();
        runCalculation();
      } catch {
        alert('Please allow clipboard permissions or paste manually.');
      }
    });

    // Preset Pills
    presetPills.forEach(pill => {
      pill.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        presetPills.forEach(p => p.classList.remove('active'));
        target.classList.add('active');

        const mode = target.dataset.mode as ActiveMode;
        const val = target.dataset.val || '';
        if (mode === 'count') {
          inpCountVal.value = val;
          switchMode('count');
        } else if (mode === 'expr') {
          inpExprVal.value = val;
          switchMode('expr');
        } else {
          inpRoundVal.value = val;
          if (target.dataset.target) {
            inpTargetSigFigs.value = target.dataset.target;
          }
          switchMode('round');
        }
      });
    });

    // Reset Defaults
    document.getElementById('btnResetDefault')?.addEventListener('click', () => {
      inpCountVal.value = '0.005020';
      inpExprVal.value = '(14.285 - 0.12) / 2.05';
      inpRoundVal.value = '149.528';
      inpTargetSigFigs.value = '3';
      switchMode('count');
    });

    // Share URL
    document.getElementById('btnShareUrl')?.addEventListener('click', async () => {
      const p = new URLSearchParams();
      p.set('mode', currentMode);
      if (currentMode === 'count') p.set('v', inpCountVal.value);
      else if (currentMode === 'expr') p.set('e', inpExprVal.value);
      else {
        p.set('r', inpRoundVal.value);
        p.set('t', inpTargetSigFigs.value);
      }
      window.history.replaceState({}, '', `${window.location.pathname}?${p.toString()}`);
      await navigator.clipboard.writeText(window.location.href);
      alert('Significant figures calculation link copied to clipboard.');
    });

    // Copy Answer
    document.getElementById('btnCopyResult')?.addEventListener('click', async () => {
      let copyText = '';
      if (currentMode === 'count' && lastCountResult) {
        copyText = `${lastCountResult.totalSigFigs} significant figures`;
      } else if (currentMode === 'expr' && lastExprResult) {
        copyText = lastExprResult.roundedValue;
      } else {
        copyText = lastRoundString;
      }
      await navigator.clipboard.writeText(copyText);
      alert('Calculated precision value copied to clipboard.');
    });

    // Copy Homework Derivations
    document.getElementById('btnCopyHomework')?.addEventListener('click', async () => {
      let text = '';
      if (currentMode === 'count' && lastCountResult) {
        text = `Significant Figure Analysis for: ${lastCountResult.normalizedInput}\nTotal Sig Figs: ${lastCountResult.totalSigFigs}\nRules Applied:\n` +
          lastCountResult.rulesApplied.map(r => `• ${r}`).join('\n') +
          `\nScientific Notation: ${lastCountResult.scientificNotation}`;
      } else if (currentMode === 'expr' && lastExprResult) {
        text = lastExprResult.homeworkExplanation;
      } else {
        text = `Rounding ${inpRoundVal.value} to ${inpTargetSigFigs.value} significant figures:\nResult = ${lastRoundString}`;
      }
      await navigator.clipboard.writeText(text);
      alert('Step-by-step homework derivation copied to clipboard.');
    });

    // Copy LaTeX
    document.getElementById('btnCopyLatex')?.addEventListener('click', async () => {
      let latex = '';
      if (currentMode === 'count' && lastCountResult) {
        latex = `\\text{Value: } ${lastCountResult.normalizedInput} \\quad \\implies \\quad \\mathbf{${lastCountResult.totalSigFigs}\\text{ Sig Figs}}`;
      } else if (currentMode === 'expr' && lastExprResult) {
        latex = lastExprResult.latexBlock;
      } else {
        latex = `\\operatorname{round}_{\\text{SF}}(${inpRoundVal.value}, ${inpTargetSigFigs.value}) = \\mathbf{${lastRoundString}}`;
      }
      await navigator.clipboard.writeText(latex);
      alert('LaTeX derivation block copied to clipboard.');
    });

    // CSV Exporter
    document.getElementById('btnExportCsv')?.addEventListener('click', () => {
      let csv = 'Mode,Input,Result,SigFigs,Decimals,ScientificNotation\n';
      if (currentMode === 'count' && lastCountResult) {
        csv += `"Count","${lastCountResult.normalizedInput}",${lastCountResult.totalSigFigs},${lastCountResult.totalSigFigs},${lastCountResult.decimalsCount},"${lastCountResult.scientificNotation}"\n`;
      } else if (currentMode === 'expr' && lastExprResult) {
        csv += `"Expression","${lastExprResult.expression}","${lastExprResult.roundedValue}",${lastExprResult.sigFigs},${lastExprResult.decimalPlaces},"${lastExprResult.scientificNotation}"\n`;
      } else {
        csv += `"Round","${inpRoundVal.value}","${lastRoundString}",${inpTargetSigFigs.value},0,"${parseFloat(lastRoundString).toExponential()}"\n`;
      }

      const blob = new Blob([csv], { type: 'text/csv' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `sig_figs_${Date.now()}.csv`;
      a.click();
      URL.revokeObjectURL(url);
    });

    // Copy Mini Buttons
    document.querySelectorAll('.btn-copy-mini').forEach(b => {
      b.addEventListener('click', async (e) => {
        const targetId = (e.currentTarget as HTMLElement).dataset.target;
        if (targetId) {
          const txt = document.getElementById(targetId)?.textContent || '';
          await navigator.clipboard.writeText(txt);
          alert('Copied to clipboard.');
        }
      });
    });

    // Citation Drawer
    const citeDrawer = document.getElementById('citeDrawer')!;
    const toggleCiteBtn = document.getElementById('toggleCiteBtn')!;
    const inlineCiteOutput = document.getElementById('inlineCiteOutput')!;
    const inlineTabs = document.querySelectorAll('.inline-cite-tab');
    const inlineCopyBtn = document.getElementById('inlineCopyCiteBtn')!;
    const doi = "10.5281/zenodo.23059466";
    const year = new Date().getFullYear();

    const citations: Record<string, string> = {
      bibtex: `@software{khan_chemistrydesk_sigfigs_${year},
  author        = {Khan, Bilal},
  title         = {ChemistryDesk: Significant Figures & Scientific Precision Studio},
  year          = {${year}},
  version       = {v1.0.1},
  publisher     = {Zenodo},
  doi           = {${doi}},
  url           = {https://chemistrycal.com/sig-figs}
}`,
      acs: `Khan, B. ChemistryDesk: Significant Figures & Scientific Precision Studio, version 1.0.1; Zenodo, ${year}. https://doi.org/${doi}.`,
      rsc: `B. Khan, ChemistryDesk: Significant Figures & Scientific Precision Studio, version 1.0.1, Zenodo, ${year}, DOI: ${doi}.`,
      nature: `Khan, B. ChemistryDesk: Significant Figures & Scientific Precision Studio. Zenodo https://doi.org/${doi} (${year}).`
    };

    let activeFormat = 'bibtex';
    function updateCite() {
      inlineCiteOutput.textContent = citations[activeFormat] || citations['bibtex'];
    }

    toggleCiteBtn.addEventListener('click', (e) => {
      e.preventDefault();
      const isHidden = citeDrawer.style.display === 'none';
      citeDrawer.style.display = isHidden ? 'block' : 'none';
      if (isHidden) updateCite();
    });

    inlineTabs.forEach(tab => {
      tab.addEventListener('click', (e) => {
        e.preventDefault();
        inlineTabs.forEach(t => {
          (t as HTMLElement).style.background = '#fff';
          (t as HTMLElement).style.color = '#334155';
          (t as HTMLElement).style.borderColor = '#cbd5e1';
          (t as HTMLElement).style.fontWeight = '600';
        });
        const el = tab as HTMLElement;
        el.style.background = '#0f172a';
        el.style.color = '#fff';
        el.style.borderColor = '#0f172a';
        el.style.fontWeight = '700';
        activeFormat = el.dataset.format || 'bibtex';
        updateCite();
      });
    });

    inlineCopyBtn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(citations[activeFormat]);
      alert('Academic citation copied.');
    });

    // Check URL State on Load
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('mode')) {
      const m = urlParams.get('mode') as ActiveMode;
      if (m === 'count' || m === 'expr' || m === 'round') currentMode = m;
    }
    if (urlParams.has('v')) inpCountVal.value = urlParams.get('v')!;
    if (urlParams.has('e')) inpExprVal.value = urlParams.get('e')!;
    if (urlParams.has('r')) inpRoundVal.value = urlParams.get('r')!;
    if (urlParams.has('t')) inpTargetSigFigs.value = urlParams.get('t')!;

    updateCite();
    switchMode(currentMode);
  </script>
</BaseLayout>