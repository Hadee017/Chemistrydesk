  <script>
    import { 
      balanceChemicalEquation, 
      solveStoichiometry, 
      type BalancedReactionResult, 
      type StoichiometryCalculationResult 
    } from '../utils/stoichiometryMath';

    let currentBalancedResult: BalancedReactionResult | null = null;
    let reactantInputs: Record<string, { value: number; unit: 'g' | 'mg' | 'mol' | 'mmol' }> = {};

    const inputEquation = document.getElementById('inputEquation') as HTMLInputElement;
    const btnBalanceRxn = document.getElementById('btnBalanceRxn')!;
    const balancedBanner = document.getElementById('balancedBanner')!;
    const balancedEqText = document.getElementById('balancedEqText')!;
    const errorBanner = document.getElementById('errorBanner')!;
    const stoichTableBody = document.getElementById('stoichTableBody')!;
    const limitingVerdictText = document.getElementById('limitingVerdictText')!;
    const excessSummaryText = document.getElementById('excessSummaryText')!;
    const theoreticalYieldText = document.getElementById('theoreticalYieldText')!;
    const inpActualYield = document.getElementById('inpActualYield') as HTMLInputElement;
    const percentYieldBadge = document.getElementById('percentYieldBadge')!;

    function formatSubscripts(formula: string): string {
      return formula.replace(/(\d+)/g, (m) => {
        const subMap: Record<string, string> = {
          '0':'₀','1':'₁','2':'₂','3':'₃','4':'₄',
          '5':'₅','6':'₆','7':'₇','8':'₈','9':'₉'
        };
        return m.split('').map(d => subMap[d] || d).join('');
      });
    }

    function syncUrlState() {
      const eq = inputEquation.value.trim();
      if (!eq) return;
      const params = new URLSearchParams();
      params.set('rxn', eq);
      const newUrl = `${window.location.pathname}?${params.toString()}`;
      window.history.replaceState({}, '', newUrl);
    }

    function runBalancing() {
      const eq = inputEquation.value.trim();
      if (!eq) return;

      const res = balanceChemicalEquation(eq);
      currentBalancedResult = res;

      if (!res.isBalanced) {
        balancedBanner.style.display = 'none';
        errorBanner.style.display = 'block';
        errorBanner.textContent = res.errorMessage || 'Unable to balance equation.';
        stoichTableBody.innerHTML = '';
        return;
      }

      errorBanner.style.display = 'none';
      balancedBanner.style.display = 'flex';
      balancedEqText.textContent = formatSubscripts(res.balancedEquationString);

      res.reactants.forEach(r => {
        if (!reactantInputs[r.formula]) {
          reactantInputs[r.formula] = { value: 10.0, unit: 'g' };
        }
      });

      renderGridAndSolve();
      syncUrlState();
    }

    function renderGridAndSolve() {
      if (!currentBalancedResult || !currentBalancedResult.isBalanced) return;

      const actualMass = parseFloat(inpActualYield.value.trim().replace(',', '.')) || undefined;
      const stoichRes: StoichiometryCalculationResult = solveStoichiometry(
        currentBalancedResult.reactants,
        currentBalancedResult.products,
        reactantInputs,
        actualMass
      );

      stoichTableBody.innerHTML = '';

      stoichRes.speciesResults.forEach(sp => {
        const tr = document.createElement('tr');
        tr.style.borderBottom = '1px solid #f1f5f9';
        if (sp.isLimiting) tr.style.background = '#fff1f2';

        const prettyFormula = formatSubscripts(sp.formula);
        const mmSafe = Number.isFinite(sp.molarMass) ? sp.molarMass.toFixed(3) : '0.000';

        if (!sp.isProduct) {
          const initMoles = Number.isFinite(sp.initialMoles) ? sp.initialMoles.toFixed(4) : '0.0000';
          const remainingMass = Number.isFinite(sp.remainingMoles * sp.molarMass) 
            ? (sp.remainingMoles * sp.molarMass).toFixed(2) 
            : '0.00';

          tr.innerHTML = `
            <td style="padding: 0.6rem 0.75rem; font-weight: 700; color: #475569;">
              Reactant ${sp.isLimiting ? '<span style="background: #e11d48; color: #fff; font-size: 0.68rem; padding: 1px 5px; border-radius: 4px; margin-left: 4px;">LIMITING</span>' : ''}
            </td>
            <td style="padding: 0.6rem 0.75rem; font-weight: 800; font-family: monospace; font-size: 0.95rem; color: #0f172a;">${prettyFormula}</td>
            <td style="padding: 0.6rem 0.75rem; font-weight: 800; color: #0284c7;">${sp.coefficient}</td>
            <td style="padding: 0.6rem 0.75rem; font-family: monospace;">${mmSafe}</td>
            <td style="padding: 0.6rem 0.75rem;">
              <div style="display: flex; gap: 4px; align-items: center;">
                <input type="text" inputmode="decimal" class="inp-reagent-val" data-formula="${sp.formula}" value="${reactantInputs[sp.formula]?.value ?? 0}" style="width: 75px; padding: 0.3rem 0.5rem; border: 1px solid #cbd5e1; border-radius: 4px; font-weight: 700; font-size: 0.85rem;" />
                <select class="sel-reagent-unit" data-formula="${sp.formula}" style="padding: 0.3rem 0.4rem; border: 1px solid #cbd5e1; border-radius: 4px; font-size: 0.8rem; background: #fff;">
                  <option value="g" ${reactantInputs[sp.formula]?.unit === 'g' ? 'selected' : ''}>g</option>
                  <option value="mg" ${reactantInputs[sp.formula]?.unit === 'mg' ? 'selected' : ''}>mg</option>
                  <option value="mol" ${reactantInputs[sp.formula]?.unit === 'mol' ? 'selected' : ''}>mol</option>
                  <option value="mmol" ${reactantInputs[sp.formula]?.unit === 'mmol' ? 'selected' : ''}>mmol</option>
                </select>
              </div>
            </td>
            <td style="padding: 0.6rem 0.75rem; font-family: monospace; font-weight: 600;">${initMoles}</td>
            <td style="padding: 0.6rem 0.75rem; font-family: monospace; font-weight: 700; color: #64748b; background: #fafafa;">
              Rem: ${remainingMass} g
            </td>
          `;
        } else {
          const prodMoles = Number.isFinite(sp.producedMoles) ? sp.producedMoles.toFixed(4) : '0.0000';
          const prodMass = Number.isFinite(sp.producedMassG) ? sp.producedMassG.toFixed(2) : '0.00';

          tr.innerHTML = `
            <td style="padding: 0.6rem 0.75rem; font-weight: 700; color: #166534;">Product</td>
            <td style="padding: 0.6rem 0.75rem; font-weight: 800; font-family: monospace; font-size: 0.95rem; color: #0f172a;">${prettyFormula}</td>
            <td style="padding: 0.6rem 0.75rem; font-weight: 800; color: #0284c7;">${sp.coefficient}</td>
            <td style="padding: 0.6rem 0.75rem; font-family: monospace;">${mmSafe}</td>
            <td style="padding: 0.6rem 0.75rem; color: #94a3b8; font-style: italic;">Produced</td>
            <td style="padding: 0.6rem 0.75rem; font-family: monospace; font-weight: 600;">${prodMoles}</td>
            <td style="padding: 0.6rem 0.75rem; font-family: monospace; font-weight: 800; color: #15803d; background: #f0fdf4;">
              ${prodMass} g
            </td>
          `;
        }
        stoichTableBody.appendChild(tr);
      });

      // Update Limiting Verdict
      if (stoichRes.limitingSpecies) {
        limitingVerdictText.textContent = `${formatSubscripts(stoichRes.limitingSpecies)} is Limiting`;
        const excesses = stoichRes.speciesResults
          .filter(sp => !sp.isProduct && !sp.isLimiting)
          .map(sp => `${(sp.remainingMoles * sp.molarMass).toFixed(2)} g ${formatSubscripts(sp.formula)}`)
          .join(', ');
        excessSummaryText.textContent = excesses ? `Excess unreacted: ${excesses}` : 'Reagents in exact stoichiometric ratio.';
      } else {
        limitingVerdictText.textContent = 'Enter reactant quantities';
        excessSummaryText.textContent = 'All species await quantitative entry.';
      }

      // Update Theoretical Yield & Percent Yield
      const theoYield = Number.isFinite(stoichRes.theoreticalYieldG) ? stoichRes.theoreticalYieldG.toFixed(2) : '0.00';
      theoreticalYieldText.textContent = `${theoYield} g Total`;

      if (stoichRes.percentYield !== undefined && !Number.isNaN(stoichRes.percentYield)) {
        percentYieldBadge.textContent = `${stoichRes.percentYield.toFixed(1)} %`;
        percentYieldBadge.style.background = stoichRes.percentYield <= 100 ? '#15803d' : '#e11d48';
      } else {
        percentYieldBadge.textContent = '-- %';
        percentYieldBadge.style.background = '#64748b';
      }
    }

    // Unified Event Delegation on Stoich Table Body
    stoichTableBody.addEventListener('input', (e) => {
      const target = e.target as HTMLElement;
      if (target.classList.contains('inp-reagent-val')) {
        const inp = target as HTMLInputElement;
        const formula = inp.dataset.formula!;
        const val = parseFloat(inp.value.trim().replace(',', '.')) || 0;
        if (reactantInputs[formula]) {
          reactantInputs[formula].value = val;
        }
        renderGridAndSolve();
      }
    });

    stoichTableBody.addEventListener('change', (e) => {
      const target = e.target as HTMLElement;
      if (target.classList.contains('sel-reagent-unit')) {
        const sel = target as HTMLSelectElement;
        const formula = sel.dataset.formula!;
        const unit = sel.value as 'g' | 'mg' | 'mol' | 'mmol';
        if (reactantInputs[formula]) {
          reactantInputs[formula].unit = unit;
        }
        renderGridAndSolve();
      }
    });

    btnBalanceRxn.addEventListener('click', runBalancing);
    inputEquation.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') runBalancing();
    });

    inpActualYield.addEventListener('input', renderGridAndSolve);

    // Preset Buttons
    document.querySelectorAll('.preset-rxn-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const rxn = (e.currentTarget as HTMLElement).dataset.rxn || '';
        inputEquation.value = rxn;
        reactantInputs = {};
        runBalancing();
      });
    });

    // Shareable URL Copy Button
    document.getElementById('btnCopyShareUrl')?.addEventListener('click', async () => {
      syncUrlState();
      await navigator.clipboard.writeText(window.location.href);
      const btn = document.getElementById('btnCopyShareUrl')!;
      const oldTxt = btn.textContent;
      btn.textContent = '✅ Link Copied!';
      setTimeout(() => { btn.textContent = oldTxt; }, 1800);
    });

    // 1-Click Copy Summary Report
    document.getElementById('btnCopyReport')?.addEventListener('click', async () => {
      if (!currentBalancedResult || !currentBalancedResult.isBalanced) return;
      const report = `================================================
CHEMISTRYCAL STOICHIOMETRY & YIELD REPORT
Equation: ${currentBalancedResult.balancedEquationString}
================================================
Limiting Reactant: ${limitingVerdictText.textContent}
${excessSummaryText.textContent}
Theoretical Product Yield: ${theoreticalYieldText.textContent}
Actual Yield: ${inpActualYield.value || 'N/A'} g
Percent Yield: ${percentYieldBadge.textContent}
================================================`;

      await navigator.clipboard.writeText(report);
      const btn = document.getElementById('btnCopyReport')!;
      const oldTxt = btn.textContent;
      btn.textContent = '✅ Copied!';
      setTimeout(() => { btn.textContent = oldTxt; }, 1800);
    });

    // 1-Click LaTeX Block
    document.getElementById('btnCopyLatex')?.addEventListener('click', async () => {
      if (!currentBalancedResult || !currentBalancedResult.isBalanced) return;
      const latex = `% Balanced Stoichiometric Reaction (Chemistrycal)
\\begin{equation}
  ${currentBalancedResult.balancedEquationString.replace(/->|→/g, '\\longrightarrow ')}
\\end{equation}`;
      await navigator.clipboard.writeText(latex);
      const btn = document.getElementById('btnCopyLatex')!;
      const oldTxt = btn.textContent;
      btn.textContent = '✅ Copied!';
      setTimeout(() => { btn.textContent = oldTxt; }, 1800);
    });

    // CSV Data Exporter
    document.getElementById('btnExportCsv')?.addEventListener('click', () => {
      if (!currentBalancedResult || !currentBalancedResult.isBalanced) return;
      let csv = 'Role,Formula,Coefficient,MolarMass_g_mol,InitialAmount,Unit\n';
      currentBalancedResult.reactants.forEach(r => {
        const inp = reactantInputs[r.formula];
        csv += `Reactant,${r.formula},${r.coefficient},${r.molarMass.toFixed(3)},${inp?.value ?? 0},${inp?.unit ?? 'g'}\n`;
      });
      currentBalancedResult.products.forEach(p => {
        csv += `Product,${p.formula},${p.coefficient},${p.molarMass.toFixed(3)},,\n`;
      });
      const blob = new Blob([csv], { type: 'text/csv' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `stoichiometry_${Date.now()}.csv`;
      a.click();
      URL.revokeObjectURL(url);
    });

    // Citation Drawer Logic
    const citeDrawer = document.getElementById('citeDrawer');
    const toggleCiteBtn = document.getElementById('toggleCiteBtn');
    const inlineCiteOutput = document.getElementById('inlineCiteOutput');
    const inlineTabs = document.querySelectorAll('.inline-cite-tab');
    const inlineCopyBtn = document.getElementById('inlineCopyCiteBtn');

    const doi = "10.5281/zenodo.23059466";
    const currentYear = new Date().getFullYear();

    const citations: Record<string, string> = {
      bibtex: `@software{khan_chemistrycal_stoichiometry_${currentYear},
  author         = {Khan, Bilal},
  title          = {Chemistrycal: Stoichiometry Calculator & Chemical Formula Balancer},
  year           = {${currentYear}},
  version        = {v1.0.1},
  publisher      = {Zenodo},
  doi            = {${doi}},
  url            = {https://chemistrycal.com/stoichiometry}
}`,
      acs: `Khan, B. Chemistrycal: Stoichiometry Calculator & Chemical Formula Balancer, version 1.0.1; Zenodo, ${currentYear}. https://doi.org/${doi}.`,
      rsc: `B. Khan, Chemistrycal: Stoichiometry Calculator & Chemical Formula Balancer, version 1.0.1, Zenodo, ${currentYear}, DOI: ${doi}.`,
      nature: `Khan, B. Chemistrycal: Stoichiometry Calculator & Chemical Formula Balancer. Zenodo https://doi.org/${doi} (${currentYear}).`,
      elsevier: `Khan, B., ${currentYear}. Chemistrycal: Stoichiometry Calculator & Chemical Formula Balancer (Version 1.0.1). Zenodo. https://doi.org/${doi}.`,
      wiley: `B. Khan, Chemistrycal: Stoichiometry Calculator & Chemical Formula Balancer, version 1.0.1, Zenodo, ${currentYear}, DOI: ${doi}.`
    };

    let currentInlineFormat = 'bibtex';

    function updateInlineCite() {
      if (inlineCiteOutput) {
        inlineCiteOutput.textContent = citations[currentInlineFormat] || citations['bibtex'];
      }
    }

    if (toggleCiteBtn && citeDrawer) {
      toggleCiteBtn.addEventListener('click', (e) => {
        e.preventDefault();
        const isHidden = window.getComputedStyle(citeDrawer).display === 'none';
        citeDrawer.style.display = isHidden ? 'block' : 'none';
        toggleCiteBtn.style.background = isHidden ? '#0284c7' : '#e0f2fe';
        toggleCiteBtn.style.color = isHidden ? '#ffffff' : '#0369a1';
        if (isHidden) updateInlineCite();
      });
    }

    inlineTabs.forEach(tab => {
      tab.addEventListener('click', (e) => {
        e.preventDefault();
        inlineTabs.forEach(t => {
          const el = t as HTMLElement;
          el.style.background = '#ffffff';
          el.style.color = '#334155';
          el.style.borderColor = '#cbd5e1';
          el.style.fontWeight = '600';
        });
        const activeTab = tab as HTMLElement;
        activeTab.style.background = '#0f172a';
        activeTab.style.color = '#ffffff';
        activeTab.style.borderColor = '#0f172a';
        activeTab.style.fontWeight = '700';
        currentInlineFormat = activeTab.getAttribute('data-format') || 'bibtex';
        updateInlineCite();
      });
    });

    if (inlineCopyBtn) {
      inlineCopyBtn.addEventListener('click', async (e) => {
        e.preventDefault();
        await navigator.clipboard.writeText(citations[currentInlineFormat]);
        inlineCopyBtn.textContent = '✅ Copied!';
        setTimeout(() => { inlineCopyBtn.textContent = '📋 Copy'; }, 1800);
      });
    }

    updateInlineCite();

    // Initial Execution: check URL parameter or load default
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('rxn')) {
      inputEquation.value = urlParams.get('rxn')!;
    }
    runBalancing();
  </script>
</BaseLayout>