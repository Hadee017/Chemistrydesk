            </tr>
            <tr style="border-bottom: 1px solid #f1f5f9;">
              <td style="padding: 0.6rem 0.75rem; font-family: monospace; font-weight: bold; color: #0284c7;">&nu;</td>
              <td style="padding: 0.6rem 0.75rem;">Stoichiometric Coefficient</td>
              <td style="padding: 0.6rem 0.75rem;">Dimensionless Integer</td>
              <td style="padding: 0.6rem 0.75rem; font-family: monospace;">Matrix Nullspace Basis</td>
            </tr>
            <tr style="border-bottom: 1px solid #f1f5f9; background: #fafafa;">
              <td style="padding: 0.6rem 0.75rem; font-family: monospace; font-weight: bold; color: #0284c7;">&xi;</td>
              <td style="padding: 0.6rem 0.75rem;">Reaction Extent</td>
              <td style="padding: 0.6rem 0.75rem;">Mole (mol)</td>
              <td style="padding: 0.6rem 0.75rem; font-family: monospace;">&xi; = n_i / &nu;_i</td>
