    document.getElementById('kineticsTable')?.addEventListener('paste', (e: ClipboardEvent) => {
      const clipboardData = e.clipboardData?.getData('text');
      if (!clipboardData) return;

      const lines = clipboardData.trim().split(/\r?\n/);
      const pastedPoints: KineticsRow[] = [];

      for (const line of lines) {
        const parts = line.trim().split(/[\t,;]+/);
        if (parts.length >= 2) {
          const t = parseFloat(parts[0].replace(',', '.'));
          const v = parseFloat(parts[1].replace(',', '.'));
          if (!isNaN(t) && !isNaN(v) && v > 0) {
            pastedPoints.push({ t, v });
          }
        }
      }

      if (pastedPoints.length >= 2) {
        e.preventDefault();
        kineticsTableData = pastedPoints;
        renderKineticsTable();
        runKineticsEngine();
      }
    });

    function runKineticsEngine() {
      const uTime = kineticsTimeUnitSelect.value;
      const validPoints = kineticsTableData.filter(p => !isNaN(p.t) && !isNaN(p.v) && p.v > 0);

      if (validPoints.length < 2) return;

      const c0 = validPoints[0].v;
      const cFinal = validPoints[validPoints.length - 1].v;
      const degPct = Math.max(0, ((c0 - cFinal) / c0) * 100);
      document.getElementById('resDegPct')!.textContent = degPct.toFixed(2) + ' %';

      // Pseudo-1st Order: ln(C0/Ct) = k1 * t
      let sumT = 0, sumY = 0, sumTY = 0, sumTT = 0;
      const n = validPoints.length;
      const fitPts: Array<{ x: number; y: number }> = [];

      for (const p of validPoints) {
        const y = Math.log(c0 / p.v);
        sumT += p.t; sumY += y;
        sumTY += p.t * y; sumTT += p.t * p.t;
        fitPts.push({ x: p.t, y });
      }

      const k1 = Math.max(0, (n * sumTY - sumT * sumY) / (n * sumTT - sumT * sumT));
      const tHalf = k1 > 0 ? (Math.LN2 / k1) : 0;

      const meanY = sumY / n;
      let ssTot = 0, ssRes = 0;
      for (const p of fitPts) {
        const fitY = k1 * p.x;
        ssTot += Math.pow(p.y - meanY, 2);
        ssRes += Math.pow(p.y - fitY, 2);
      }
      const r2 = ssTot > 0 ? Math.max(0, 1 - (ssRes / ssTot)) : 1;

      document.getElementById('resK1')!.textContent = `${k1.toFixed(4)} ${uTime}⁻¹`;
      document.getElementById('resR2K1')!.textContent = r2.toFixed(4);
      document.getElementById('resTHalf')!.textContent = `${tHalf.toFixed(2)} ${uTime}`;

      // Pseudo-2nd Order: (1/Ct - 1/C0) = k2 * t
      let sumY2 = 0, sumTY2 = 0;
      for (const p of validPoints) {
        const y2 = (1 / p.v) - (1 / c0);
        sumY2 += y2; sumTY2 += p.t * y2;
      }
      const k2 = Math.max(0, (n * sumTY2 - sumT * sumY2) / (n * sumTT - sumT * sumT));
      document.getElementById('resK2')!.textContent = `${k2.toFixed(4)} conc⁻¹·${uTime}⁻¹`;

      renderKineticsSvg(fitPts, k1, uTime);
    }

    function renderKineticsSvg(pts: Array<{ x: number; y: number }>, k1: number, uTime: string) {
      const svg = document.getElementById('kineticsSvg')!;
      const maxX = Math.max(...pts.map(p => p.x)) * 1.1 || 10;
      const maxY = Math.max(...pts.map(p => p.y)) * 1.2 || 1;

      const padL = 50, padR = 25, padT = 20, padB = 35;
      const width = 600 - padL - padR;
      const height = 240 - padT - padB;

      const scX = (x: number) => padL + (x / maxX) * width;
      const scY = (y: number) => padT + height - (y / maxY) * height;

      let svgHtml = `
        <line x1="${padL}" y1="${padT + height}" x2="${padL + width}" y2="${padT + height}" stroke="#94a3b8" stroke-width="1.5" />
        <line x1="${padL}" y1="${padT}" x2="${padL}" y2="${padT + height}" stroke="#94a3b8" stroke-width="1.5" />
        <text x="15" y="${padT + height / 2}" transform="rotate(-90 15,${padT + height / 2})" fill="#64748b" font-weight="bold">ln(C₀ / Cₜ)</text>
        <text x="${padL + width / 2}" y="${padT + height + 25}" fill="#64748b" font-weight="bold">Time (${uTime})</text>
      `;

      const endX = maxX * 0.95;
      const endY = k1 * endX;
      svgHtml += `<line x1="${scX(0)}" y1="${scY(0)}" x2="${scX(endX)}" y2="${scY(endY)}" stroke="#7c3aed" stroke-width="2.5" stroke-dasharray="4,4" />`;

      pts.forEach(p => {
        svgHtml += `<circle cx="${scX(p.x)}" cy="${scY(p.y)}" r="4.5" fill="#7c3aed" stroke="#ffffff" stroke-width="1.5" />`;
      });

      svg.innerHTML = svgHtml;
    }

    renderKineticsTable();

    // CSV EXPORTS
    document.getElementById('downloadCalibCsvBtn')?.addEventListener('click', () => {
      const unit = calibUnitSelect.value;
      const validPoints = calibTableData.filter(p => !isNaN(p.c) && !isNaN(p.a));
      if (validPoints.length === 0) return;
      let csv = `Standard_Concentration_${unit},Absorbance_au\n`;
      validPoints.forEach(p => { csv += `${p.c},${p.a}\n`; });
      const blob = new Blob([csv], { type: 'text/csv' });
      const a = document.createElement('a');
      a.href = window.URL.createObjectURL(blob);
      a.download = `spectrophotometry_calibration_curve_${unit}.csv`;
      a.click();
    });

    document.getElementById('downloadKineticsCsvBtn')?.addEventListener('click', () => {
      const uTime = kineticsTimeUnitSelect.value;
      const uVal = kineticsValTypeSelect.value;
      const validPoints = kineticsTableData.filter(p => !isNaN(p.t) && !isNaN(p.v));
      if (validPoints.length === 0) return;
      let csv = `Time_${uTime},Value_${uVal}\n`;
      validPoints.forEach(p => { csv += `${p.t},${p.v}\n`; });
      const blob = new Blob([csv], { type: 'text/csv' });
      const a = document.createElement('a');
      a.href = window.URL.createObjectURL(blob);
      a.download = `reaction_kinetics_decay_${uTime}.csv`;
      a.click();
    });

    // EVENT BINDINGS
    [inpAbs, inpPath, inpEps, inpConc].forEach(inp => {
      inp.addEventListener('input', runSingleEngine);
    });

    ['unitConc', 'unitPath', 'inpMwAnh', 'inpHydrateN', 'inpPurity', 'inpPrepVol'].forEach(id => {
      document.getElementById(id)?.addEventListener('input', runSingleEngine);
      document.getElementById(id)?.addEventListener('change', runSingleEngine);
    });

    document.getElementById('copyProtocolBtn')?.addEventListener('click', () => {
      const text = document.getElementById('protocolSteps')?.innerText || '';
      navigator.clipboard.writeText(text);
      alert('Spectrophotometry protocol copied to clipboard.');
    });

    document.getElementById('shareBtn')?.addEventListener('click', () => {
      navigator.clipboard.writeText(window.location.href);
      alert('Experiment URL copied to clipboard.');
    });

    document.getElementById('copyLatexBtn')?.addEventListener('click', () => {
      const latex = `A = \\varepsilon \\cdot b \\cdot c \\implies ${inpAbs.value} = ${inpEps.value} \\times ${inpPath.value}\\,\\text{cm} \\times (${inpConc.value}\\,\\text{M})`;
      navigator.clipboard.writeText(latex);
      alert('LaTeX equation copied to clipboard.');
    });

    // --- ACADEMIC CITATION SYSTEM ---
    const citeDrawer = document.getElementById('citeDrawer');
    const toggleCiteBtn = document.getElementById('toggleCiteBtn');
    const inlineCiteOutput = document.getElementById('inlineCiteOutput');
    const inlineTabs = document.querySelectorAll('.inline-cite-tab');
    const inlineCopyBtn = document.getElementById('inlineCopyCiteBtn');

    const doi = "10.5281/zenodo.23059466";
    const currentYear = new Date().getFullYear();

    const spectroCitations: Record<string, string> = {
      bibtex: `@software{khan_chemistrycal_spectro_${currentYear},
  author         = {Khan, Bilal},
  title          = {Chemistrycal: Beer-Lambert Law Calculator & Chemical Kinetics Studio},
  year           = {${currentYear}},
  version        = {v1.0.1},
  publisher      = {Zenodo},
  doi            = {${doi}},
  url            = {https://chemistrycal.com/spectro}
}`,
      acs: `Khan, B. Chemistrycal: Beer-Lambert Law Calculator & Chemical Kinetics Studio, version 1.0.1; Zenodo, ${currentYear}. https://doi.org/${doi}.`,
      rsc: `B. Khan, Chemistrycal: Beer-Lambert Law Calculator & Chemical Kinetics Studio, version 1.0.1, Zenodo, ${currentYear}, DOI: ${doi}.`,
      nature: `Khan, B. Chemistrycal: Beer-Lambert Law Calculator & Chemical Kinetics Studio. Zenodo https://doi.org/${doi} (${currentYear}).`,
      elsevier: `Khan, B., ${currentYear}. Chemistrycal: Beer-Lambert Law Calculator & Chemical Kinetics Studio (Version 1.0.1). Zenodo. https://doi.org/${doi}.`,
      wiley: `B. Khan, Chemistrycal: Beer-Lambert Law Calculator & Chemical Kinetics Studio, version 1.0.1, Zenodo, ${currentYear}, DOI: ${doi}.`
    };

    let currentInlineFormat = 'bibtex';

    function updateInlineCite() {
      if (inlineCiteOutput) {
        inlineCiteOutput.textContent = spectroCitations[currentInlineFormat] || spectroCitations['bibtex'];
      }
    }

    if (toggleCiteBtn && citeDrawer) {
      toggleCiteBtn.addEventListener('click', (e) => {
        e.preventDefault();
        const isHidden = window.getComputedStyle(citeDrawer).display === 'none';
        citeDrawer.style.display = isHidden ? 'block' : 'none';
        toggleCiteBtn.style.background = isHidden ? '#7c3aed' : '#ede9fe';
        toggleCiteBtn.style.color = isHidden ? '#ffffff' : '#6d28d9';
        if (isHidden) updateInlineCite();
      });
    }

    inlineTabs.forEach(tab => {
      tab.addEventListener('click', (e) => {
        e.preventDefault();
        inlineTabs.forEach(t => {
          const el = t as HTMLElement;
          el.style.background = '#ffffff';
          el.style.color = '#334155';
          el.style.borderColor = '#cbd5e1';
          el.style.fontWeight = '600';
        });
        const activeTab = tab as HTMLElement;
        activeTab.style.background = '#0f172a';
        activeTab.style.color = '#ffffff';
        activeTab.style.borderColor = '#0f172a';
        activeTab.style.fontWeight = '700';
        currentInlineFormat = activeTab.getAttribute('data-format') || 'bibtex';
        updateInlineCite();
      });
    });

    if (inlineCopyBtn) {
      inlineCopyBtn.addEventListener('click', async (e) => {
        e.preventDefault();
        try {
          await navigator.clipboard.writeText(spectroCitations[currentInlineFormat]);
          inlineCopyBtn.textContent = '✅ Copied!';
          setTimeout(() => {
            inlineCopyBtn.textContent = '📋 Copy';
          }, 1800);
        } catch (err) {
          console.error('Failed to copy citation:', err);
        }
      });
    }

    updateInlineCite();
    adjustInputStates();
    runSingleEngine();
  </script>
</BaseLayout>