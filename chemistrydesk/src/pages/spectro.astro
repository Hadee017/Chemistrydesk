    });

    calibFileInput.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = (event) => {
        const text = event.target?.result as string;
        if (!text) return;

        const lines = text.trim().split(/\r?\n/);
        const parsed: CalibRow[] = [];

        for (const line of lines) {
          const parts = line.trim().split(/[,;\t\s]+/);
          if (parts.length >= 2) {
            const c = parseFloat(parts[0].replace(',', '.'));
            const a = parseFloat(parts[1].replace(',', '.'));
            if (!isNaN(c) && !isNaN(a)) {
              parsed.push({ c, a });
            }
          }
        }

        if (parsed.length >= 2) {
          calibTableData = parsed;
          renderCalibTable();
          runCalibrationEngine();
        } else {
          alert('Could not parse at least 2 valid numeric rows from file. Ensure format is: Concentration, Absorbance');
        }
      };
      reader.readAsText(file);
    });

    document.getElementById('calibTable')?.addEventListener('paste', (e: ClipboardEvent) => {
      const clipboardData = e.clipboardData?.getData('text');
      if (!clipboardData) return;

      const lines = clipboardData.trim().split(/\r?\n/);
      const pastedPoints: CalibRow[] = [];

      for (const line of lines) {
        const parts = line.trim().split(/[\t,;]+/);
        if (parts.length >= 2) {
          const c = parseFloat(parts[0].replace(',', '.'));
          const a = parseFloat(parts[1].replace(',', '.'));
          if (!isNaN(c) && !isNaN(a)) {
            pastedPoints.push({ c, a });
          }
        }
      }

      if (pastedPoints.length >= 2) {
        e.preventDefault();
        calibTableData = pastedPoints;
        renderCalibTable();
        runCalibrationEngine();
      }
    });

    function runCalibrationEngine() {
      const unit = calibUnitSelect.value;
      const validPoints = calibTableData.filter(p => !isNaN(p.c) && !isNaN(p.a));

      if (validPoints.length < 2) return;

      let sumC = 0, sumA = 0, sumCA = 0, sumCC = 0;
      const n = validPoints.length;
      for (const p of validPoints) {
        sumC += p.c; sumA += p.a;
        sumCA += p.c * p.a; sumCC += p.c * p.c;
      }

      const slope = (n * sumCA - sumC * sumA) / (n * sumCC - sumC * sumC);
      const intercept = (sumA - slope * sumC) / n;

      const meanA = sumA / n;
      let ssTot = 0, ssRes = 0;
      for (const p of validPoints) {
        const fitA = slope * p.c + intercept;
        ssTot += Math.pow(p.a - meanA, 2);
        ssRes += Math.pow(p.a - fitA, 2);
      }
      const r2 = ssTot > 0 ? Math.max(0, 1 - (ssRes / ssTot)) : 1;

      document.getElementById('calibEquation')!.textContent = `A = ${slope.toFixed(4)}·c + (${intercept.toFixed(4)})`;
      document.getElementById('calibR2Text')!.textContent = `R² = ${r2.toFixed(4)}`;

      const unkAbs = parseFloat((document.getElementById('inpUnkAbs') as HTMLInputElement).value) || 0;
      const unkConc = slope !== 0 ? (unkAbs - intercept) / slope : 0;
      document.getElementById('outUnkConc')!.textContent = `${unkConc.toFixed(2)} ${unit}`;
      document.getElementById('outUnkEquation')!.textContent = `c = (${unkAbs.toFixed(3)} - ${intercept.toFixed(4)}) / ${slope.toFixed(4)}`;

      renderCalibSvg(validPoints, slope, intercept, { c: unkConc, a: unkAbs }, unit);
    }

    function renderCalibSvg(pts: Array<{ c: number; a: number }>, slope: number, intercept: number, unk: { c: number; a: number }, unit: string) {
      const svg = document.getElementById('calibSvg')!;
      const maxC = Math.max(...pts.map(p => p.c), unk.c) * 1.15 || 10;
      const maxA = Math.max(...pts.map(p => p.a), unk.a) * 1.2 || 1;

      const padL = 55, padR = 25, padT = 20, padB = 35;
      const width = 600 - padL - padR;
      const height = 240 - padT - padB;

      const scX = (c: number) => padL + (c / maxC) * width;
      const scY = (a: number) => padT + height - (a / maxA) * height;

      let svgHtml = `
        <line x1="${padL}" y1="${padT + height}" x2="${padL + width}" y2="${padT + height}" stroke="#94a3b8" stroke-width="1.5" />
        <line x1="${padL}" y1="${padT}" x2="${padL}" y2="${padT + height}" stroke="#94a3b8" stroke-width="1.5" />
        <text x="15" y="${padT + height / 2}" transform="rotate(-90 15,${padT + height / 2})" fill="#64748b" font-weight="bold">Absorbance (a.u.)</text>
        <text x="${padL + width / 2}" y="${padT + height + 25}" fill="#64748b" font-weight="bold">Standard Concentration (${unit})</text>
      `;

      const endC = maxC * 0.95;
      const endA = slope * endC + intercept;
      svgHtml += `<line x1="${scX(0)}" y1="${scY(intercept)}" x2="${scX(endC)}" y2="${scY(endA)}" stroke="#7c3aed" stroke-width="2.5" />`;

      pts.forEach(p => {
        svgHtml += `<circle cx="${scX(p.c)}" cy="${scY(p.a)}" r="4.5" fill="#7c3aed" stroke="#ffffff" stroke-width="1.5" />`;
      });

      if (unk.c > 0 && unk.a > 0) {
        svgHtml += `
          <circle cx="${scX(unk.c)}" cy="${scY(unk.a)}" r="6" fill="#ef4444" stroke="#ffffff" stroke-width="1.5" />
          <line x1="${scX(unk.c)}" y1="${padT + height}" x2="${scX(unk.c)}" y2="${scY(unk.a)}" stroke="#ef4444" stroke-dasharray="3,3" />
          <line x1="${padL}" y1="${scY(unk.a)}" x2="${scX(unk.c)}" y2="${scY(unk.a)}" stroke="#ef4444" stroke-dasharray="3,3" />
        `;
      }

      svg.innerHTML = svgHtml;
    }

    document.getElementById('inpUnkAbs')?.addEventListener('input', runCalibrationEngine);
    renderCalibTable();

    // ============================================================
    // MODE 3: INTERACTIVE EXCEL TABLE, UPLOAD & KINETICS ENGINE
    // ============================================================
    interface KineticsRow {
      t: number;
