    document.getElementById('btnDownloadSdsTemplateTab')?.addEventListener('click', downloadBlankSdsTemplate);
    document.getElementById('btnDownloadSdsTemplateArticle')?.addEventListener('click', downloadBlankSdsTemplate);

    // ============================================================
    // ACADEMIC CITATION SYSTEM
    // ============================================================
    const citeDrawer = document.getElementById('citeDrawer');
    const toggleCiteBtn = document.getElementById('toggleCiteBtn');
    const inlineCiteOutput = document.getElementById('inlineCiteOutput');
    const inlineTabs = document.querySelectorAll('.inline-cite-tab');
    const inlineCopyBtn = document.getElementById('inlineCopyCiteBtn');

    const doi = "10.5281/zenodo.23059466";
    const currentYear = new Date().getFullYear();

    const ghsCitations: Record<string, string> = {
      bibtex: `@software{khan_chemistrycal_ghs_${currentYear},
  author         = {Khan, Bilal},
  title          = {Chemistrycal: GHS Hazard & Chemical Safety Studio},
  year           = {${currentYear}},
  version        = {v1.0.1},
  publisher      = {Zenodo},
  doi            = {${doi}},
  url            = {https://chemistrycal.com/ghs}
}`,
      acs: `Khan, B. Chemistrycal: GHS Hazard & Chemical Safety Studio, version 1.0.1; Zenodo, ${currentYear}. https://doi.org/${doi}.`,
      rsc: `B. Khan, Chemistrycal: GHS Hazard & Chemical Safety Studio, version 1.0.1, Zenodo, ${currentYear}, DOI: ${doi}.`,
      nature: `Khan, B. Chemistrycal: GHS Hazard & Chemical Safety Studio. Zenodo https://doi.org/${doi} (${currentYear}).`,
      elsevier: `Khan, B., ${currentYear}. Chemistrycal: GHS Hazard & Chemical Safety Studio (Version 1.0.1). Zenodo. https://doi.org/${doi}.`,
      wiley: `B. Khan, Chemistrycal: GHS Hazard & Chemical Safety Studio, version 1.0.1, Zenodo, ${currentYear}, DOI: ${doi}.`
    };

    let currentInlineFormat = 'bibtex';

    function updateInlineCite() {
      if (inlineCiteOutput) {
        inlineCiteOutput.textContent = ghsCitations[currentInlineFormat] || ghsCitations['bibtex'];
      }
    }

    if (toggleCiteBtn && citeDrawer) {
      toggleCiteBtn.addEventListener('click', (e) => {
        e.preventDefault();
        const isHidden = window.getComputedStyle(citeDrawer).display === 'none';
        citeDrawer.style.display = isHidden ? 'block' : 'none';
        toggleCiteBtn.style.background = isHidden ? '#dc2626' : '#fee2e2';
        toggleCiteBtn.style.color = isHidden ? '#ffffff' : '#991b1b';
        if (isHidden) updateInlineCite();
      });
    }

    inlineTabs.forEach(tab => {
      tab.addEventListener('click', (e) => {
        e.preventDefault();
        inlineTabs.forEach(t => {
          const el = t as HTMLElement;
          el.style.background = '#ffffff';
          el.style.color = '#334155';
          el.style.borderColor = '#cbd5e1';
          el.style.fontWeight = '600';
        });
        const activeTab = tab as HTMLElement;
        activeTab.style.background = '#0f172a';
        activeTab.style.color = '#ffffff';
        activeTab.style.borderColor = '#0f172a';
        activeTab.style.fontWeight = '700';
        currentInlineFormat = activeTab.getAttribute('data-format') || 'bibtex';
        updateInlineCite();
      });
    });

    if (inlineCopyBtn) {
      inlineCopyBtn.addEventListener('click', async (e) => {
        e.preventDefault();
        try {
          await navigator.clipboard.writeText(ghsCitations[currentInlineFormat]);
          inlineCopyBtn.textContent = '✅ Copied!';
          setTimeout(() => {
            inlineCopyBtn.textContent = '📋 Copy';
          }, 1800);
        } catch (err) {
          console.error('Failed to copy citation:', err);
        }
      });
    }

    updateInlineCite();

    // Initial Execution
    handleChemicalSearch('Sodium Dodecyl Sulfate');
    renderStatementsTable();
    runCutoffEngine();
  </script>

