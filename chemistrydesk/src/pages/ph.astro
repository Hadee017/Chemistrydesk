  </main>

  <style>
    .temp-btn {
      transition: all 0.15s ease;
    }
    .temp-btn:hover {
      background: #e0f2fe !important;
      border-color: #0284c7 !important;
      color: #0284c7 !important;
    }
    .temp-btn.active {
      background: #0284c7 !important;
      color: #ffffff !important;
      border-color: #0284c7 !important;
    }
  </style>

  <script>
    import {
      solvePhFourWay,
      solveEquilibrium,
      parseScientificNumber,
      formatExponentialHtml,
      COMMON_ACID_BASE_PRESETS,
      type AcidBaseClass
    } from '../utils/phMath';

    let currentTemp = 25;
    let isInternalUpdating = false;

    // DOM Elements - Circular
    const inpPh = document.getElementById('inpPh') as HTMLInputElement;
    const inpPoh = document.getElementById('inpPoh') as HTMLInputElement;
    const inpHConc = document.getElementById('inpHConc') as HTMLInputElement;
    const inpOhConc = document.getElementById('inpOhConc') as HTMLInputElement;
    const hConcSupDisplay = document.getElementById('hConcSupDisplay')!;
    const ohConcSupDisplay = document.getElementById('ohConcSupDisplay')!;
    const solClassificationBadge = document.getElementById('solClassificationBadge')!;
    const spectrumMarker = document.getElementById('spectrumMarker')!;
    const lblSpectrumColor = document.getElementById('lblSpectrumColor')!;

    // DOM Elements - Indicators
    const indDotPhph = document.getElementById('indDotPhph')!;
    const indTextPhph = document.getElementById('indTextPhph')!;
    const indDotBtb = document.getElementById('indDotBtb')!;
    const indTextBtb = document.getElementById('indTextBtb')!;
    const indDotMo = document.getElementById('indDotMo')!;
    const indTextMo = document.getElementById('indTextMo')!;

    // DOM Elements - Temperature & Kw
    const lblKwDisplay = document.getElementById('lblKwDisplay')!;
    const lblPkwDisplay = document.getElementById('lblPkwDisplay')!;
    const lblNeutralPhDisplay = document.getElementById('lblNeutralPhDisplay')!;
    const tempButtons = document.querySelectorAll('.temp-btn');

    // DOM Elements - Equilibrium
    const selAcidBasePreset = document.getElementById('selAcidBasePreset') as HTMLSelectElement;
    const selElectrolyteType = document.getElementById('selElectrolyteType') as HTMLSelectElement;
    const inpConcVal = document.getElementById('inpConcVal') as HTMLInputElement;
    const selConcUnit = document.getElementById('selConcUnit') as HTMLSelectElement;
    const rowKConst = document.getElementById('rowKConst')!;
    const lblKConst = document.getElementById('lblKConst')!;
    const lblPkaCalculated = document.getElementById('lblPkaCalculated')!;
    const inpKVal = document.getElementById('inpKVal') as HTMLInputElement;
    const btnTransferToCircular = document.getElementById('btnTransferToCircular')!;

    const dispEquilPh = document.getElementById('dispEquilPh')!;
    const badgeApproxRule = document.getElementById('badgeApproxRule')!;
    const dispAlpha = document.getElementById('dispAlpha')!;
    const dispEquilPoh = document.getElementById('dispEquilPoh')!;
    const dispHIonEquil = document.getElementById('dispHIonEquil')!;
    const dispOhIonEquil = document.getElementById('dispOhIonEquil')!;
    const calloutExplanation = document.getElementById('calloutExplanation')!;

    function syncCircular(source: 'ph' | 'poh' | 'h' | 'oh') {
      if (isInternalUpdating) return;
      isInternalUpdating = true;

      let val = 7;
      if (source === 'ph') val = parseScientificNumber(inpPh.value);
      else if (source === 'poh') val = parseScientificNumber(inpPoh.value);
      else if (source === 'h') val = parseScientificNumber(inpHConc.value);
      else if (source === 'oh') val = parseScientificNumber(inpOhConc.value);

      const state = solvePhFourWay(source, val, currentTemp);

      if (source !== 'ph') inpPh.value = state.ph.toFixed(3);
      if (source !== 'poh') inpPoh.value = state.poh.toFixed(3);
      if (source !== 'h') inpHConc.value = state.hConc.toExponential(3);
      if (source !== 'oh') inpOhConc.value = state.ohConc.toExponential(3);

      hConcSupDisplay.innerHTML = formatExponentialHtml(state.hConc, 3) + ' M';
      ohConcSupDisplay.innerHTML = formatExponentialHtml(state.ohConc, 3) + ' M';

      const clampedPh = Math.max(0, Math.min(14, state.ph));
      const pct = (clampedPh / 14) * 100;
      spectrumMarker.style.left = `${pct}%`;
      lblSpectrumColor.textContent = `${state.universalColor} (pH ${state.ph.toFixed(2)})`;
      lblSpectrumColor.style.color = state.universalHex;

      if (state.ph < state.neutralPH - 0.1) {
        solClassificationBadge.textContent = state.ph < 3 ? 'Strongly Acidic' : 'Weakly Acidic';
        solClassificationBadge.style.background = '#ef4444';
      } else if (state.ph > state.neutralPH + 0.1) {
        solClassificationBadge.textContent = state.ph > 11 ? 'Strongly Basic' : 'Weakly Basic';
        solClassificationBadge.style.background = '#3b82f6';
      } else {
        solClassificationBadge.textContent = 'Neutral Solution';
        solClassificationBadge.style.background = '#22c55e';
      }

      const indMap = Object.fromEntries(state.indicators.map(i => [i.name, i]));
      if (indMap['Phenolphthalein']) {
        indDotPhph.style.backgroundColor = indMap['Phenolphthalein'].hexCode;
        indTextPhph.textContent = indMap['Phenolphthalein'].colorName;
      }
      if (indMap['Bromothymol Blue']) {
        indDotBtb.style.backgroundColor = indMap['Bromothymol Blue'].hexCode;
        indTextBtb.textContent = indMap['Bromothymol Blue'].colorName;
      }
      if (indMap['Methyl Orange']) {
        indDotMo.style.backgroundColor = indMap['Methyl Orange'].hexCode;
        indTextMo.textContent = indMap['Methyl Orange'].colorName;
      }

      isInternalUpdating = false;
    }

    function runEquilibriumEngine() {
      const type = selElectrolyteType.value as AcidBaseClass;
      let cVal = parseScientificNumber(inpConcVal.value);
      const cUnit = selConcUnit.value;
      if (cUnit === 'mM') cVal /= 1000;
      else if (cUnit === 'uM') cVal /= 1e6;

      const kVal = parseScientificNumber(inpKVal.value);

      if (type === 'strong_acid' || type === 'strong_base') {
        rowKConst.style.opacity = '0.4';
        inpKVal.disabled = true;
      } else {
        rowKConst.style.opacity = '1';
        inpKVal.disabled = false;
        lblKConst.textContent = type === 'weak_acid' ? 'DISSOCIATION CONSTANT (K_a)' : 'DISSOCIATION CONSTANT (K_b)';
        if (kVal > 0) {
          lblPkaCalculated.textContent = (-Math.log10(kVal)).toFixed(2);
        }
      }

      const res = solveEquilibrium(type, cVal, kVal, currentTemp);

      dispEquilPh.innerHTML = `${res.ph.toFixed(3)} <span style="font-size: 1.5rem; color: #94a3b8; font-weight: 700;">pH</span>`;
      dispEquilPoh.textContent = res.poh.toFixed(3);
      dispAlpha.textContent = `${res.alphaPercent.toFixed(2)}%`;
      dispHIonEquil.innerHTML = formatExponentialHtml(res.hConc, 3) + ' M';
      dispOhIonEquil.innerHTML = formatExponentialHtml(res.ohConc, 3) + ' M';
      calloutExplanation.textContent = res.benchtopExplanation;

      if (type === 'strong_acid' || type === 'strong_base') {
        badgeApproxRule.textContent = '100% Strong Dissociation';
        badgeApproxRule.style.background = '#0284c7';
      } else if (res.isApproximationValid) {
        badgeApproxRule.textContent = '5% Rule Valid (alpha <= 5%)';
        badgeApproxRule.style.background = '#059669';
      } else {
        badgeApproxRule.textContent = `5% Rule FAILS (${res.alphaPercent.toFixed(1)}% ion)`;
        badgeApproxRule.style.background = '#e11d48';
      }
    }

    btnTransferToCircular.addEventListener('click', () => {
      const phText = dispEquilPh.textContent?.split(' ')[0] || '7.000';
      inpPh.value = phText;
      syncCircular('ph');
      window.scrollTo({ top: 180, behavior: 'smooth' });
    });

    selAcidBasePreset.addEventListener('change', () => {
      const presetId = selAcidBasePreset.value;
      const p = COMMON_ACID_BASE_PRESETS.find(item => item.id === presetId);
      if (p) {
        selElectrolyteType.value = p.type;
        inpKVal.value = p.K_val.toExponential(2);
        lblPkaCalculated.textContent = p.pK_val.toFixed(2);
        runEquilibriumEngine();
      }
    });

    inpPh.addEventListener('input', () => syncCircular('ph'));
    inpPoh.addEventListener('input', () => syncCircular('poh'));
    inpHConc.addEventListener('input', () => syncCircular('h'));
    inpOhConc.addEventListener('input', () => syncCircular('oh'));

    selElectrolyteType.addEventListener('change', runEquilibriumEngine);
    inpConcVal.addEventListener('input', runEquilibriumEngine);
    selConcUnit.addEventListener('change', runEquilibriumEngine);
    inpKVal.addEventListener('input', runEquilibriumEngine);

    tempButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        tempButtons.forEach(b => b.classList.remove('active'));
        target.classList.add('active');
        currentTemp = parseInt(target.dataset.temp || '25', 10);

        if (currentTemp === 0) {
          lblKwDisplay.innerHTML = '1.14 &times; 10&#8315;&#185;&#8309;';
          lblPkwDisplay.textContent = '14.94';
          lblNeutralPhDisplay.textContent = '7.47';
        } else if (currentTemp === 37) {
          lblKwDisplay.innerHTML = '2.42 &times; 10&#8315;&#185;&#8308;';
          lblPkwDisplay.textContent = '13.62';
          lblNeutralPhDisplay.textContent = '6.81';
        } else if (currentTemp === 60) {
          lblKwDisplay.innerHTML = '9.61 &times; 10&#8315;&#185;&#8308;';
          lblPkwDisplay.textContent = '13.02';
          lblNeutralPhDisplay.textContent = '6.51';
        } else {
          lblKwDisplay.innerHTML = '1.00 &times; 10&#8315;&#185;&#8308;';
          lblPkwDisplay.textContent = '14.00';
          lblNeutralPhDisplay.textContent = '7.00';
        }

        syncCircular('ph');
        runEquilibriumEngine();
      });
    });

    document.getElementById('btnResetDefault')?.addEventListener('click', () => {
      currentTemp = 25;
      tempButtons.forEach(b => b.classList.remove('active'));
      document.querySelector('[data-temp="25"]')?.classList.add('active');
      lblKwDisplay.innerHTML = '1.00 &times; 10&#8315;&#185;&#8308;';
      lblPkwDisplay.textContent = '14.00';
      lblNeutralPhDisplay.textContent = '7.00';

      inpPh.value = '7.000';
      selAcidBasePreset.value = 'acetic';
      selElectrolyteType.value = 'weak_acid';
      inpConcVal.value = '0.100';
      selConcUnit.value = 'M';
      inpKVal.value = '1.75e-5';
      syncCircular('ph');
      runEquilibriumEngine();
    });

    document.getElementById('btnShareUrl')?.addEventListener('click', async () => {
      const p = new URLSearchParams();
      p.set('ph', inpPh.value);
      p.set('temp', currentTemp.toString());
      p.set('preset', selAcidBasePreset.value);
      p.set('c', inpConcVal.value);
      p.set('cu', selConcUnit.value);
      p.set('k', inpKVal.value);
      p.set('type', selElectrolyteType.value);
      window.history.replaceState({}, '', `${window.location.pathname}?${p.toString()}`);
      await navigator.clipboard.writeText(window.location.href);
      alert('pH & equilibrium setup URL copied to clipboard.');
    });

    document.getElementById('btnExportCsv')?.addEventListener('click', () => {
      let csv = 'Parameter,Value,Unit\n';
      csv += `Temperature,${currentTemp},degC\n`;
      csv += `pH,${inpPh.value},\n`;
      csv += `pOH,${inpPoh.value},\n`;
      csv += `[H+],${inpHConc.value},M\n`;
      csv += `[OH-],${inpOhConc.value},M\n`;
      csv += `ElectrolyteType,${selElectrolyteType.value},\n`;
      csv += `AnalyticalConcentration,${inpConcVal.value},${selConcUnit.value}\n`;
      csv += `K_Constant,${inpKVal.value},\n`;
      csv += `Equilibrium_pH,${dispEquilPh.textContent?.split(' ')[0]},\n`;
      csv += `IonizationDegree,${dispAlpha.textContent},\n`;
      const blob = new Blob([csv], { type: 'text/csv' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `ph_equilibrium_${Date.now()}.csv`;
      a.click();
      URL.revokeObjectURL(url);
    });

    document.getElementById('btnCopyReport')?.addEventListener('click', async () => {
      const report = `========================================
CHEMISTRYCAL pH & EQUILIBRIUM REPORT
Temperature: ${currentTemp} C
pH: ${inpPh.value} | pOH: ${inpPoh.value}
[H+]: ${inpHConc.value} M | [OH-]: ${inpOhConc.value} M
Electrolyte: ${selElectrolyteType.value} (${inpConcVal.value} ${selConcUnit.value})
Equilibrium pH: ${dispEquilPh.textContent?.split(' ')[0]}
Ionization Degree (alpha): ${dispAlpha.textContent}
Diagnostic: ${calloutExplanation.textContent}
========================================`;
      await navigator.clipboard.writeText(report);
      alert('Aqueous equilibrium summary copied to clipboard.');
    });

    document.getElementById('btnCopyLatex')?.addEventListener('click', async () => {
      const latex = `% Aqueous Ion Equilibrium & Exact Quadratic Root (Chemistrycal)
\\begin{aligned}
  \\text{pH} &= -\\log_{10}[\\text{H}^+] \\implies [\\text{H}^+] = 10^{-\\text{pH}} \\\\
  K_w &= [\\text{H}^+][\\text{OH}^-] = 1.00 \\times 10^{-14} \\text{ (at 25}^\\circ\\text{C)} \\\\
  K_a &= \\frac{x^2}{C_0 - x} \\implies x = [\\text{H}^+] = \\frac{-K_a + \\sqrt{K_a^2 + 4K_a C_0}}{2}
\\end{aligned}`;
      await navigator.clipboard.writeText(latex);
      alert('LaTeX equations copied to clipboard.');
    });

    const citeDrawer = document.getElementById('citeDrawer')!;
    const toggleCiteBtn = document.getElementById('toggleCiteBtn')!;
    const inlineCiteOutput = document.getElementById('inlineCiteOutput')!;
    const inlineTabs = document.querySelectorAll('.inline-cite-tab');
    const inlineCopyBtn = document.getElementById('inlineCopyCiteBtn')!;
    const doi = "10.5281/zenodo.23059466";
    const year = new Date().getFullYear();

    const citations: Record<string, string> = {
      bibtex: `@software{khan_chemistrycal_ph_${year},
  author         = {Khan, Bilal},
  title          = {Chemistrycal: Universal pH & Aqueous Equilibrium Studio},
  year           = {${year}},
  version        = {v1.0.1},
  publisher      = {Zenodo},
  doi            = {${doi}},
  url            = {https://chemistrycal.com/ph}
}`,
      acs: `Khan, B. Chemistrycal: Universal pH & Aqueous Equilibrium Studio, version 1.0.1; Zenodo, ${year}. https://doi.org/${doi}.`,
      rsc: `B. Khan, Chemistrycal: Universal pH & Aqueous Equilibrium Studio, version 1.0.1, Zenodo, ${year}, DOI: ${doi}.`,
      nature: `Khan, B. Chemistrycal: Universal pH & Aqueous Equilibrium Studio. Zenodo https://doi.org/${doi} (${year}).`,
      elsevier: `Khan, B., ${year}. Chemistrycal: Universal pH & Aqueous Equilibrium Studio (Version 1.0.1). Zenodo. https://doi.org/${doi}.`,
      wiley: `B. Khan, Chemistrycal: Universal pH & Aqueous Equilibrium Studio, version 1.0.1, Zenodo, ${year}, DOI: ${doi}.`
    };

    let activeFormat = 'bibtex';
    function updateCite() {
      inlineCiteOutput.textContent = citations[activeFormat] || citations['bibtex'];
    }

    toggleCiteBtn.addEventListener('click', (e) => {
      e.preventDefault();
      const isHidden = citeDrawer.style.display === 'none';
      citeDrawer.style.display = isHidden ? 'block' : 'none';
      if (isHidden) updateCite();
    });

    inlineTabs.forEach(tab => {
      tab.addEventListener('click', (e) => {
        e.preventDefault();
        inlineTabs.forEach(t => {
          (t as HTMLElement).style.background = '#fff';
          (t as HTMLElement).style.color = '#334155';
          (t as HTMLElement).style.borderColor = '#cbd5e1';
          (t as HTMLElement).style.fontWeight = '600';
        });
        const el = tab as HTMLElement;
        el.style.background = '#0f172a';
        el.style.color = '#fff';
        el.style.borderColor = '#0f172a';
        el.style.fontWeight = '700';
        activeFormat = el.dataset.format || 'bibtex';
        updateCite();
      });
    });

    inlineCopyBtn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(citations[activeFormat]);
      alert('Academic citation copied.');
    });

    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('ph')) inpPh.value = urlParams.get('ph')!;
    if (urlParams.has('temp')) {
      const t = parseInt(urlParams.get('temp')!, 10);
      const targetBtn = document.querySelector(`[data-temp="${t}"]`) as HTMLButtonElement;
      if (targetBtn) targetBtn.click();
    }
    if (urlParams.has('preset')) selAcidBasePreset.value = urlParams.get('preset')!;
    if (urlParams.has('type')) selElectrolyteType.value = urlParams.get('type')!;
    if (urlParams.has('c')) inpConcVal.value = urlParams.get('c')!;
    if (urlParams.has('cu')) selConcUnit.value = urlParams.get('cu')!;
    if (urlParams.has('k')) inpKVal.value = urlParams.get('k')!;

    updateCite();
    syncCircular('ph');
    runEquilibriumEngine();
  </script>
</BaseLayout>