  <style>
    .preset-pill {
      transition: all 0.15s ease;
    }
    .preset-pill:hover {
      background: #e0f2fe !important;
      border-color: #0284c7 !important;
      color: #0284c7 !important;
    }
    .preset-pill.active {
      background: #0284c7 !important;
      color: #ffffff !important;
      border-color: #0284c7 !important;
    }
  </style>

  <script>
    import {
      calculateMolarMass,
      convertMassMoles,
      type MolarMassResult
    } from '../utils/molarMassMath';

    let currentResult: MolarMassResult | null = null;
    let isInternalUpdating = false;

    // DOM Elements - Formula & Output
    const inpFormula = document.getElementById('inpFormula') as HTMLInputElement;
    const parseAlert = document.getElementById('parseAlert')!;
    const lblHillFormula = document.getElementById('lblHillFormula')!;
    const lblTotalAtoms = document.getElementById('lblTotalAtoms')!;
    const dispMolarMass = document.getElementById('dispMolarMass')!;
    const dispDaValue = document.getElementById('dispDaValue')!;
    const compositionSegmentedBar = document.getElementById('compositionSegmentedBar')!;
    const tblElementsBody = document.getElementById('tblElementsBody')!;

    // DOM Elements - Two-Way Converter
    const inpSampleMass = document.getElementById('inpSampleMass') as HTMLInputElement;
    const selMassUnit = document.getElementById('selMassUnit') as HTMLSelectElement;
    const inpSampleMoles = document.getElementById('inpSampleMoles') as HTMLInputElement;
    const selMolesUnit = document.getElementById('selMolesUnit') as HTMLSelectElement;
    const lblMoleculesDisplay = document.getElementById('lblMoleculesDisplay')!;

    // DOM Elements - Presets
    const presetPills = document.querySelectorAll('.preset-pill');

    function executeMolarMassCalculation() {
      const val = inpFormula.value.trim();
      const res = calculateMolarMass(val);
      currentResult = res;

      if (!res.isValid) {
        parseAlert.textContent = res.errorMessage || 'Invalid formula notation.';
        parseAlert.style.display = 'block';
        return;
      }

      parseAlert.style.display = 'none';
      lblHillFormula.textContent = res.hillFormula || '-';
      lblTotalAtoms.textContent = res.totalAtomCount.toString();

      dispMolarMass.innerHTML = `${res.totalMolarMass.toFixed(3)} <span style="font-size: 1.45rem; color: #94a3b8; font-weight: 700;">g/mol</span>`;
      dispDaValue.textContent = `${res.totalMolarMass.toFixed(3)} Da (amu)`;

      // Render Segmented Composition Bar
      compositionSegmentedBar.innerHTML = '';
      res.elements.forEach(item => {
        const seg = document.createElement('div');
        seg.style.width = `${item.massPercent}%`;
        seg.style.height = '100%';
        seg.style.backgroundColor = item.colorHex;
        seg.title = `${item.name} (${item.symbol}): ${item.massPercent.toFixed(1)}%`;
        compositionSegmentedBar.appendChild(seg);
      });

      // Render Table Rows
      tblElementsBody.innerHTML = '';
      res.elements.forEach(item => {
        const tr = document.createElement('tr');
        tr.style.borderBottom = '1px solid #f1f5f9';
        tr.innerHTML = `
          <td style="padding: 0.55rem 0.75rem; font-weight: 700; color: #0f172a; display: flex; align-items: center; gap: 0.4rem;">
            <span style="width: 10px; height: 10px; border-radius: 50%; background-color: ${item.colorHex}; display: inline-block;"></span>
            ${item.name} <span style="color: #64748b; font-family: monospace;">(${item.symbol})</span>
          </td>
          <td style="padding: 0.55rem 0.75rem; font-family: monospace; color: #475569;">${item.atomicWeight.toFixed(3)}</td>
          <td style="padding: 0.55rem 0.75rem; font-family: monospace; font-weight: 700; color: #0284c7;">${item.atomCount}</td>
          <td style="padding: 0.55rem 0.75rem; font-family: monospace; color: #0f172a; font-weight: 700;">${item.subtotalMass.toFixed(3)}</td>
          <td style="padding: 0.55rem 0.75rem; font-family: monospace; font-weight: 800; color: #059669;">${item.massPercent.toFixed(2)}%</td>
        `;
        tblElementsBody.appendChild(tr);
      });

      // Synchronize Two-Way Converter
      syncConverter('mass');
    }

    function syncConverter(source: 'mass' | 'moles') {
      if (!currentResult || !currentResult.isValid || isInternalUpdating) return;
      isInternalUpdating = true;

      const M = currentResult.totalMolarMass;

      if (source === 'mass') {
        let m = parseFloat(inpSampleMass.value) || 0;
        const u = selMassUnit.value;
        if (u === 'mg') m /= 1000;
        else if (u === 'kg') m *= 1000;

        const conv = convertMassMoles(M, 'mass_to_moles', m);

        let dispMoles = conv.moles;
        const mUnit = selMolesUnit.value;
        if (mUnit === 'mmol') dispMoles *= 1000;
        else if (mUnit === 'umol') dispMoles *= 1e6;

        inpSampleMoles.value = dispMoles >= 0.001 && dispMoles < 1000 ? dispMoles.toFixed(4) : dispMoles.toExponential(4);
        lblMoleculesDisplay.innerHTML = `${conv.molecules.toExponential(3).replace('e+', ' &times; 10<sup>')}</sup> molecules`;
      } else {
        let n = parseFloat(inpSampleMoles.value) || 0;
        const u = selMolesUnit.value;
        if (u === 'mmol') n /= 1000;
        else if (u === 'umol') n /= 1e6;

        const conv = convertMassMoles(M, 'moles_to_mass', n);

        let dispMass = conv.massGrams;
        const massUnit = selMassUnit.value;
        if (massUnit === 'mg') dispMass *= 1000;
        else if (massUnit === 'kg') dispMass /= 1000;

        inpSampleMass.value = dispMass >= 0.001 && dispMass < 1000 ? dispMass.toFixed(3) : dispMass.toExponential(3);
        lblMoleculesDisplay.innerHTML = `${conv.molecules.toExponential(3).replace('e+', ' &times; 10<sup>')}</sup> molecules`;
      }

      isInternalUpdating = false;
    }

    // Input listeners
    inpFormula.addEventListener('input', executeMolarMassCalculation);
    inpSampleMass.addEventListener('input', () => syncConverter('mass'));
    selMassUnit.addEventListener('change', () => syncConverter('mass'));
    inpSampleMoles.addEventListener('input', () => syncConverter('moles'));
    selMolesUnit.addEventListener('change', () => syncConverter('moles'));

    // Preset Pills
    presetPills.forEach(pill => {
      pill.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        presetPills.forEach(p => p.classList.remove('active'));
        target.classList.add('active');
        inpFormula.value = target.dataset.formula || 'H2O';
        executeMolarMassCalculation();
      });
    });

    // Reset Defaults
    document.getElementById('btnResetDefault')?.addEventListener('click', () => {
      inpFormula.value = 'C6H12O6';
      presetPills.forEach(p => p.classList.remove('active'));
      document.querySelector('[data-formula="C6H12O6"]')?.classList.add('active');
      inpSampleMass.value = '10.00';
      selMassUnit.value = 'g';
      selMolesUnit.value = 'mol';
      executeMolarMassCalculation();
    });

    // Share URL
    document.getElementById('btnShareUrl')?.addEventListener('click', async () => {
      const p = new URLSearchParams();
      p.set('f', inpFormula.value);
      p.set('m', inpSampleMass.value);
      p.set('mu', selMassUnit.value);
      window.history.replaceState({}, '', `${window.location.pathname}?${p.toString()}`);
      await navigator.clipboard.writeText(window.location.href);
      alert('Molar mass calculation link copied to clipboard.');
    });

    // CSV Exporter
    document.getElementById('btnExportCsv')?.addEventListener('click', () => {
      if (!currentResult || !currentResult.isValid) return;
      let csv = 'Element,Symbol,AtomicWeight,AtomCount,SubtotalMass,MassPercent\n';
      currentResult.elements.forEach(item => {
        csv += `"${item.name}",${item.symbol},${item.atomicWeight},${item.atomCount},${item.subtotalMass.toFixed(3)},${item.massPercent.toFixed(2)}\n`;
      });
      csv += `\nTotalMolarMass,${currentResult.totalMolarMass.toFixed(3)},g/mol\n`;
      csv += `TotalAtoms,${currentResult.totalAtomCount}\n`;
      csv += `HillFormula,"${currentResult.hillFormula}"\n`;

      const blob = new Blob([csv], { type: 'text/csv' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `molar_mass_${inpFormula.value.replace(/[^a-zA-Z0-9]/g, '_')}_${Date.now()}.csv`;
      a.click();
      URL.revokeObjectURL(url);
    });

    // Copy Homework Derivation
    document.getElementById('btnCopyHomework')?.addEventListener('click', async () => {
      if (!currentResult || !currentResult.isValid) return;
      await navigator.clipboard.writeText(currentResult.homeworkSteps);
      alert('Step-by-step homework derivation copied to clipboard.');
    });

    // Copy LaTeX
    document.getElementById('btnCopyLatex')?.addEventListener('click', async () => {
      if (!currentResult || !currentResult.isValid) return;
      await navigator.clipboard.writeText(currentResult.latexBlock);
      alert('LaTeX derivation equations copied to clipboard.');
    });

    // Academic Citation Drawer Logic
    const citeDrawer = document.getElementById('citeDrawer')!;
    const toggleCiteBtn = document.getElementById('toggleCiteBtn')!;
    const inlineCiteOutput = document.getElementById('inlineCiteOutput')!;
    const inlineTabs = document.querySelectorAll('.inline-cite-tab');
    const inlineCopyBtn = document.getElementById('inlineCopyCiteBtn')!;
    const doi = "10.5281/zenodo.23059466";
    const year = new Date().getFullYear();

    const citations: Record<string, string> = {
      bibtex: `@software{khan_chemistrydesk_molarmass_${year},
  author        = {Khan, Bilal},
  title         = {ChemistryDesk: Universal Molar Mass & Elemental Composition Studio},
  year          = {${year}},
  version       = {v1.0.1},
  publisher     = {Zenodo},
  doi           = {${doi}},
  url           = {https://chemistrycal.com/molar-mass}
}`,
      acs: `Khan, B. ChemistryDesk: Universal Molar Mass & Elemental Composition Studio, version 1.0.1; Zenodo, ${year}. https://doi.org/${doi}.`,
      rsc: `B. Khan, ChemistryDesk: Universal Molar Mass & Elemental Composition Studio, version 1.0.1, Zenodo, ${year}, DOI: ${doi}.`,
      nature: `Khan, B. ChemistryDesk: Universal Molar Mass & Elemental Composition Studio. Zenodo https://doi.org/${doi} (${year}).`,
      elsevier: `Khan, B., ${year}. ChemistryDesk: Universal Molar Mass & Elemental Composition Studio (Version 1.0.1). Zenodo. https://doi.org/${doi}.`,
      wiley: `B. Khan, ChemistryDesk: Universal Molar Mass & Elemental Composition Studio, version 1.0.1, Zenodo, ${year}, DOI: ${doi}.`
    };

    let activeFormat = 'bibtex';
    function updateCite() {
      inlineCiteOutput.textContent = citations[activeFormat] || citations['bibtex'];
    }

    toggleCiteBtn.addEventListener('click', (e) => {
      e.preventDefault();
      const isHidden = citeDrawer.style.display === 'none';
      citeDrawer.style.display = isHidden ? 'block' : 'none';
      if (isHidden) updateCite();
    });

    inlineTabs.forEach(tab => {
      tab.addEventListener('click', (e) => {
        e.preventDefault();
        inlineTabs.forEach(t => {
          (t as HTMLElement).style.background = '#fff';
          (t as HTMLElement).style.color = '#334155';
          (t as HTMLElement).style.borderColor = '#cbd5e1';
          (t as HTMLElement).style.fontWeight = '600';
        });
        const el = tab as HTMLElement;
        el.style.background = '#0f172a';
        el.style.color = '#fff';
        el.style.borderColor = '#0f172a';
        el.style.fontWeight = '700';
        activeFormat = el.dataset.format || 'bibtex';
        updateCite();
      });
    });

    inlineCopyBtn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(citations[activeFormat]);
      alert('Academic citation copied.');
    });

    // Check URL state on load
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('f')) inpFormula.value = urlParams.get('f')!;
    if (urlParams.has('m')) inpSampleMass.value = urlParams.get('m')!;
    if (urlParams.has('mu')) selMassUnit.value = urlParams.get('mu')!;

    updateCite();
    executeMolarMassCalculation();
  </script>
</BaseLayout>