<script is:inline>
  (function() {
    var chemicalPresets = {
      hcl_naoh: {
        systemType: 'strong_acid_strong_base',
        analyteName: 'Hydrochloric Acid (HCl)',
        titrantName: 'Sodium Hydroxide (NaOH)',
        defaultCa: 0.100,
        defaultVa: 25.0,
        defaultCb: 0.100,
        pKa: 0,
        indicator: 'Bromothymol Blue',
        badge: 'Strong Acid vs. Strong Base'
      },
      vinegar_naoh: {
        systemType: 'weak_acid_strong_base',
        analyteName: 'Acetic Acid (CH₃COOH)',
        titrantName: 'Sodium Hydroxide (NaOH)',
        defaultCa: 0.100,
        defaultVa: 25.0,
        defaultCb: 0.100,
        pKa: 4.76,
        indicator: 'Phenolphthalein',
        badge: 'Weak Acid vs. Strong Base'
      },
      ammonia_hcl: {
        systemType: 'weak_base_strong_acid',
        analyteName: 'Ammonia (NH₃)',
        titrantName: 'Hydrochloric Acid (HCl)',
        defaultCa: 0.100,
        defaultVa: 25.0,
        defaultCb: 0.100,
        pKa: 4.75, // pKb
        indicator: 'Methyl Orange',
        badge: 'Weak Base vs. Strong Acid'
      },
      formic_naoh: {
        systemType: 'weak_acid_strong_base',
        analyteName: 'Formic Acid (HCOOH)',
        titrantName: 'Sodium Hydroxide (NaOH)',
        defaultCa: 0.100,
        defaultVa: 25.0,
        defaultCb: 0.100,
        pKa: 3.75,
        indicator: 'Phenolphthalein',
        badge: 'Weak Acid vs. Strong Base'
      }
    };

    var currentSystemType = 'weak_acid_strong_base';
    var currentPK = 4.76;
    var currentAnalyteName = 'Acetic Acid (CH₃COOH)';
    var currentTitrantName = 'Sodium Hydroxide (NaOH)';

    var selAnalyte = document.getElementById('select-analyte-chemical');
    var selTitrant = document.getElementById('select-titrant-chemical');
    var inpCa = document.getElementById('input-ca');
    var inpVa = document.getElementById('input-va');
    var inpCb = document.getElementById('input-cb');
    var selIndicator = document.getElementById('select-indicator');
    var inpProbeVol = document.getElementById('input-probe-vol');
    var probePhOutput = document.getElementById('probe-ph-output');
    var probeRegionBadge = document.getElementById('probe-region-badge');
    var probeColorDot = document.getElementById('probe-color-indicator');
    var activeBadge = document.getElementById('activePresetBadge');

    var outVeq = document.getElementById('metric-veq');
    var outEqPH = document.getElementById('metric-eqph');
    var outHalfV = document.getElementById('metric-halfv');
    var outHalfPH = document.getElementById('metric-halfph');
    var outMaxDeriv = document.getElementById('metric-max-deriv');
    var outBufferNote = document.getElementById('metric-buffer-range-note');
    var outEqNature = document.getElementById('eq-ph-nature');
    var outSop = document.getElementById('sop-recipe-text');
    var svgContainer = document.getElementById('svg-chart-container');
    var indRangeTag = document.getElementById('indicator-range-tag');

    var KW = 1.0e-14;

    function sanitizeInput(val, fallback) {
      if (typeof val === 'number') return isNaN(val) ? fallback : val;
      if (!val) return fallback;
      var clean = val.toString().trim().replace(',', '.');
      var num = parseFloat(clean);
      return isNaN(num) ? fallback : num;
    }

    function calculateCurvePoints(systemType, Ca, Va_mL, Cb, pK) {
      var Va_L = Va_mL / 1000.0;
      var molesAnalyte = Ca * Va_L;
      var Veq_mL = (molesAnalyte / Cb) * 1000.0;
      var maxV_mL = Veq_mL * 2.0;
      var steps = 140;
      var dV = maxV_mL / steps;

      function solveExactPH(V_mL) {
        var V_L = V_mL / 1000.0;
        var totalVol_L = Va_L + V_L;
        var molesTitrant = Cb * V_L;

        if (systemType === 'strong_acid_strong_base') {
          if (V_mL < Veq_mL - 1e-5) {
            var h = (molesAnalyte - molesTitrant) / totalVol_L;
            return -Math.log10(Math.max(1e-14, h));
          } else if (Math.abs(V_mL - Veq_mL) <= 1e-5) {
            return 7.00;
          } else {
            var oh = (molesTitrant - molesAnalyte) / totalVol_L;
            return 14.0 + Math.log10(Math.max(1e-14, oh));
          }
        }

        if (systemType === 'weak_acid_strong_base') {
          var Ka = Math.pow(10, -pK);
          if (V_mL <= 0.001) {
            return -Math.log10(Math.max(1e-14, Math.sqrt(Ka * Ca)));
          } else if (V_mL < Veq_mL - 1e-5) {
            var ratio = Math.max(1e-6, molesTitrant / (molesAnalyte - molesTitrant));
            return Math.max(0, Math.min(14, pK + Math.log10(ratio)));
          } else if (Math.abs(V_mL - Veq_mL) <= 1e-5) {
            var cA = molesAnalyte / totalVol_L;
            var oh_eq = Math.sqrt((KW / Ka) * cA);
            return 14.0 + Math.log10(Math.max(1e-14, oh_eq));
          } else {
            var oh_excess = (molesTitrant - molesAnalyte) / totalVol_L;
            return 14.0 + Math.log10(Math.max(1e-14, oh_excess));
          }
        }

        if (systemType === 'weak_base_strong_acid') {
          var Kb = Math.pow(10, -pK);
          var pKa_conj = 14.0 - pK;
          if (V_mL <= 0.001) {
            var oh_init = Math.sqrt(Kb * Ca);
            return 14.0 + Math.log10(Math.max(1e-14, oh_init));
          } else if (V_mL < Veq_mL - 1e-5) {
            var ratio_base = Math.max(1e-6, (molesAnalyte - molesTitrant) / molesTitrant);
            return Math.max(0, Math.min(14, pKa_conj + Math.log10(ratio_base)));
          } else if (Math.abs(V_mL - Veq_mL) <= 1e-5) {
            var cBH = molesAnalyte / totalVol_L;
            var h_eq = Math.sqrt((KW / Kb) * cBH);
            return -Math.log10(Math.max(1e-14, h_eq));
          } else {
            var h_excess = (molesTitrant - molesAnalyte) / totalVol_L;
            return -Math.log10(Math.max(1e-14, h_excess));
          }
        }
        return 7.00;
      }

      var points = [];
      for (var i = 0; i <= steps; i++) {
        var v = i * dV;
        points.push({ volumeAdded: Number(v.toFixed(3)), pH: solveExactPH(v), derivative: 0 });
      }

      var maxDeriv = 0;
      for (var j = 1; j < points.length - 1; j++) {
        var dVol = points[j + 1].volumeAdded - points[j - 1].volumeAdded;
        var dpH = Math.abs(points[j + 1].pH - points[j - 1].pH);
        var deriv = dVol > 0 ? dpH / dVol : 0;
        points[j].derivative = Number(deriv.toFixed(3));
        if (deriv > maxDeriv) maxDeriv = deriv;
      }

      return {
        Veq: Number(Veq_mL.toFixed(2)),
        eqPH: Number(solveExactPH(Veq_mL).toFixed(2)),
        halfV: Number((Veq_mL / 2).toFixed(2)),
        halfPH: Number(solveExactPH(Veq_mL / 2).toFixed(2)),
        points: points,
        maxDerivVal: Number(maxDeriv.toFixed(2)),
        maxV: maxV_mL,
        solveExactPH: solveExactPH
      };
    }

    function getIndicatorColor(indicatorName, currentPH) {
      if (indicatorName === 'Phenolphthalein') {
        if (currentPH < 8.2) return { bg: '#e2e8f0', text: 'Colorless' };
        if (currentPH <= 10.0) return { bg: '#f472b6', text: 'Faint Pink' };
        return { bg: '#db2777', text: 'Vivid Magenta' };
      }
      if (indicatorName === 'Bromothymol Blue') {
        if (currentPH < 6.0) return { bg: '#facc15', text: 'Yellow' };
        if (currentPH <= 7.6) return { bg: '#22c55e', text: 'Green (Neutral)' };
        return { bg: '#3b82f6', text: 'Blue' };
      }
      if (indicatorName === 'Methyl Orange') {
        if (currentPH < 3.1) return { bg: '#ef4444', text: 'Red' };
        if (currentPH <= 4.4) return { bg: '#f97316', text: 'Orange' };
        return { bg: '#eab308', text: 'Yellow' };
      }
      if (indicatorName === 'Methyl Red') {
        if (currentPH < 4.4) return { bg: '#ef4444', text: 'Red' };
        if (currentPH <= 6.2) return { bg: '#f97316', text: 'Orange' };
        return { bg: '#eab308', text: 'Yellow' };
      }
      return { bg: '#94a3b8', text: 'Neutral' };
    }

    function updateStudentDashboard() {
      var Ca = Math.max(1e-4, sanitizeInput(inpCa.value, 0.1));
      var Va = Math.max(0.1, sanitizeInput(inpVa.value, 25.0));
      var Cb = Math.max(1e-4, sanitizeInput(inpCb.value, 0.1));
      var indName = selIndicator.value;

      if (indName === 'Phenolphthalein') indRangeTag.textContent = 'pH 8.2 - 10.0';
      if (indName === 'Bromothymol Blue') indRangeTag.textContent = 'pH 6.0 - 7.6';
      if (indName === 'Methyl Orange') indRangeTag.textContent = 'pH 3.1 - 4.4';
      if (indName === 'Methyl Red') indRangeTag.textContent = 'pH 4.4 - 6.2';

      var res = calculateCurvePoints(currentSystemType, Ca, Va, Cb, currentPK);

      outVeq.textContent = res.Veq.toFixed(2);
      outEqPH.textContent = res.eqPH.toFixed(2);
      outHalfV.textContent = res.halfV.toFixed(2);
      outHalfPH.textContent = res.halfPH.toFixed(2);
      outMaxDeriv.textContent = res.maxDerivVal.toFixed(2);

      if (currentSystemType === 'strong_acid_strong_base') {
        outBufferNote.textContent = 'No buffer region (Strong Electrolyte)';
        outEqNature.textContent = 'Neutral (pH = 7.00)';
      } else if (currentSystemType === 'weak_acid_strong_base') {
        outBufferNote.textContent = 'Buffer Shelf [pKa ± 1]: [' + (currentPK - 1).toFixed(2) + ' - ' + (currentPK + 1).toFixed(2) + ']';
        outEqNature.textContent = 'Basic (Conjugate Base Hydrolysis)';
      } else {
        var effPka = 14.0 - currentPK;
        outBufferNote.textContent = 'Buffer Shelf [pKa ± 1]: [' + (effPka - 1).toFixed(2) + ' - ' + (effPka + 1).toFixed(2) + ']';
        outEqNature.textContent = 'Acidic (Conjugate Acid Hydrolysis)';
      }

      // Update Live Probe Tool
      var probeVol = Math.max(0, sanitizeInput(inpProbeVol.value, 0));
      var probePH = res.solveExactPH(probeVol);
      probePhOutput.textContent = probePH.toFixed(2);

      var probeColor = getIndicatorColor(indName, probePH);
      probeColorDot.style.backgroundColor = probeColor.bg;

      if (probeVol === 0) {
        probeRegionBadge.textContent = 'Initial Solution';
        probeRegionBadge.style.background = '#64748b';
      } else if (probeVol < res.Veq - 0.2) {
        probeRegionBadge.textContent = currentSystemType === 'strong_acid_strong_base' ? 'Pre-Equivalence' : 'Buffer Region';
        probeRegionBadge.style.background = '#0284c7';
      } else if (Math.abs(probeVol - res.Veq) <= 0.2) {
        probeRegionBadge.textContent = 'Equivalence Point!';
        probeRegionBadge.style.background = '#ec4899';
      } else {
        probeRegionBadge.textContent = 'Excess Titrant Zone';
        probeRegionBadge.style.background = '#7c3aed';
      }

      // Render Dynamic SVG Curve
      renderSvgChart(res, indName, probeVol, probePH);

      // Student SOP Recipe Text
      outSop.textContent = '1. Pipette exactly ' + Va.toFixed(2) + ' mL of ' + currentAnalyteName + ' (' + Ca.toFixed(4) + ' M) into a clean 150 mL Erlenmeyer flask.\n' +
        '2. Add 2–3 drops of ' + indName + ' indicator.\n' +
        '3. Fill a 50 mL Class-A burette with ' + currentTitrantName + ' (' + Cb.toFixed(4) + ' M).\n' +
        '4. Titrate with continuous swirling until the persistent endpoint color change is observed at ' + res.Veq.toFixed(2) + ' mL (Equivalence pH: ' + res.eqPH.toFixed(2) + ').';
    }

    function renderSvgChart(res, indName, probeVol, probePH) {
      var width = 640;
      var height = 380;
      var pad = { top: 30, right: 30, bottom: 50, left: 55 };
      var cW = width - pad.left - pad.right;
      var cH = height - pad.top - pad.bottom;

      var scaleX = function(v) { return pad.left + (v / res.maxV) * cW; };
      var scaleY = function(ph) { return pad.top + cH - (ph / 14) * cH; };
      var maxD = Math.max.apply(null, [1].concat(res.points.map(function(p) { return p.derivative; })));
      var scaleYD = function(d) { return pad.top + cH - (d / maxD) * cH; };

      var pathPH = '';
      var pathDeriv = '';

      res.points.forEach(function(p, idx) {
        var x = scaleX(p.volumeAdded).toFixed(1);
        var y = scaleY(p.pH).toFixed(1);
        var yD = scaleYD(p.derivative).toFixed(1);
        pathPH += (idx === 0 ? 'M ' : ' L ') + x + ' ' + y;
        pathDeriv += (idx === 0 ? 'M ' : ' L ') + x + ' ' + yD;
      });

      var eqX = scaleX(res.Veq);
      var eqY = scaleY(res.eqPH);
      var halfX = scaleX(res.halfV);
      var halfY = scaleY(res.halfPH);
      var probeX = scaleX(probeVol);
      var probeY = scaleY(probePH);

      // Indicator Region Highlight
      var indMin = 8.2; var indMax = 10.0;
      if (indName === 'Bromothymol Blue') { indMin = 6.0; indMax = 7.6; }
      if (indName === 'Methyl Orange') { indMin = 3.1; indMax = 4.4; }
      if (indName === 'Methyl Red') { indMin = 4.4; indMax = 6.2; }

      var indTopY = scaleY(indMax);
      var indBotY = scaleY(indMin);
      var indH = Math.abs(indBotY - indTopY);

      var xTicks = [0, 0.25, 0.5, 0.75, 1.0].map(function(r) { return (res.maxV * r).toFixed(1); });
      var yTicks = [0, 2, 4, 6, 8, 10, 12, 14];

      var svgHTML = '<svg viewBox="0 0 ' + width + ' ' + height + '" style="width: 100%; height: 100%; font-family: monospace;" role="img" aria-label="Titration Curve">' +
        '<rect x="' + pad.left + '" y="' + pad.top + '" width="' + cW + '" height="' + cH + '" fill="#0b1120" stroke="#1e293b" stroke-width="1"/>' +
        '<rect x="' + pad.left + '" y="' + indTopY + '" width="' + cW + '" height="' + indH + '" fill="#ec4899" fill-opacity="0.12" stroke="#ec4899" stroke-dasharray="3 3" stroke-width="0.8"/>' +
        '<line x1="' + pad.left + '" y1="' + (pad.top + cH) + '" x2="' + (pad.left + cW) + '" y2="' + (pad.top + cH) + '" stroke="#475569" stroke-width="1.2"/>' +
        '<line x1="' + pad.left + '" y1="' + pad.top + '" x2="' + pad.left + '" y2="' + (pad.top + cH) + '" stroke="#475569" stroke-width="1.2"/>' +
        yTicks.map(function(t) { return '<line x1="' + (pad.left - 4) + '" y1="' + scaleY(t) + '" x2="' + pad.left + '" y2="' + scaleY(t) + '" stroke="#64748b" stroke-width="1"/><text x="' + (pad.left - 8) + '" y="' + (scaleY(t) + 3) + '" fill="#94a3b8" font-size="10" text-anchor="end">' + t + '</text>'; }).join('') +
        xTicks.map(function(val) { return '<line x1="' + scaleX(parseFloat(val)) + '" y1="' + (pad.top + cH) + '" x2="' + scaleX(parseFloat(val)) + '" y2="' + (pad.top + cH + 4) + '" stroke="#64748b" stroke-width="1"/><text x="' + scaleX(parseFloat(val)) + '" y="' + (pad.top + cH + 16) + '" fill="#94a3b8" font-size="10" text-anchor="middle">' + val + '</text>'; }).join('') +
        '<text x="' + (pad.left + cW / 2) + '" y="' + (height - 10) + '" fill="#94a3b8" font-size="11" font-weight="bold" text-anchor="middle">Burette Titrant Volume (mL)</text>' +
        '<text transform="rotate(-90)" x="' + (-(pad.top + cH / 2)) + '" y="16" fill="#94a3b8" font-size="11" font-weight="bold" text-anchor="middle">pH</text>' +
        '<path d="' + pathDeriv + '" fill="none" stroke="#a78bfa" stroke-width="1.5" stroke-dasharray="3 3" stroke-opacity="0.8"/>' +
        '<path d="' + pathPH + '" fill="none" stroke="#22d3ee" stroke-width="2.6" stroke-linecap="round"/>' +
        (currentSystemType !== 'strong_acid_strong_base' ? '<circle cx="' + halfX + '" cy="' + halfY + '" r="4.5" fill="#f59e0b" stroke="#0f172a" stroke-width="1.5"/><text x="' + (halfX + 6) + '" y="' + (halfY - 4) + '" fill="#fbbf24" font-size="10" font-weight="700">V 1/2 (' + res.halfV + ' mL, pH ' + res.halfPH + ')</text>' : '') +
        '<line x1="' + eqX + '" y1="' + (pad.top + cH) + '" x2="' + eqX + '" y2="' + eqY + '" stroke="#ef4444" stroke-dasharray="2 2" stroke-width="1"/>' +
        '<circle cx="' + eqX + '" cy="' + eqY + '" r="5.5" fill="#ef4444" stroke="#ffffff" stroke-width="1.5"/>' +
        '<text x="' + (eqX + 7) + '" y="' + (eqY - 6) + '" fill="#fca5a5" font-size="11" font-weight="800">Veq (' + res.Veq + ' mL, pH ' + res.eqPH + ')</text>' +
        '<circle cx="' + probeX + '" cy="' + probeY + '" r="5" fill="#facc15" stroke="#020617" stroke-width="1.5"/>' +
        '</svg>';

      svgContainer.innerHTML = svgHTML;
    }

    // Preset Button Click Handlers
    document.querySelectorAll('.preset-chip-btn').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        var key = e.currentTarget.getAttribute('data-preset');
        var p = chemicalPresets[key];
        if (p) {
          currentSystemType = p.systemType;
          currentAnalyteName = p.analyteName;
          currentTitrantName = p.titrantName;
          currentPK = p.pKa;
          inpCa.value = p.defaultCa.toFixed(3);
          inpVa.value = p.defaultVa.toFixed(1);
          inpCb.value = p.defaultCb.toFixed(3);
          selIndicator.value = p.indicator;
          activeBadge.textContent = p.badge;
          updateStudentDashboard();
        }
      });
    });

    // Analyte Dropdown Change
    if (selAnalyte) {
      selAnalyte.addEventListener('change', function() {
        var val = selAnalyte.value;
        if (val === 'ch3cooh') {
          currentSystemType = 'weak_acid_strong_base';
          currentAnalyteName = 'Acetic Acid (CH₃COOH)';
          currentPK = 4.76;
          selIndicator.value = 'Phenolphthalein';
          activeBadge.textContent = 'Weak Acid vs. Strong Base';
        } else if (val === 'hcl') {
          currentSystemType = 'strong_acid_strong_base';
          currentAnalyteName = 'Hydrochloric Acid (HCl)';
          currentPK = 0;
          selIndicator.value = 'Bromothymol Blue';
          activeBadge.textContent = 'Strong Acid vs. Strong Base';
        } else if (val === 'nh3') {
          currentSystemType = 'weak_base_strong_acid';
          currentAnalyteName = 'Ammonia (NH₃)';
          currentPK = 4.75;
          selIndicator.value = 'Methyl Orange';
          activeBadge.textContent = 'Weak Base vs. Strong Acid';
        } else if (val === 'hcooh') {
          currentSystemType = 'weak_acid_strong_base';
          currentAnalyteName = 'Formic Acid (HCOOH)';
          currentPK = 3.75;
          selIndicator.value = 'Phenolphthalein';
          activeBadge.textContent = 'Weak Acid vs. Strong Base';
        }
        updateStudentDashboard();
      });
    }

    // Input Listeners
    [inpCa, inpVa, inpCb, selIndicator, inpProbeVol].forEach(function(el) {
      if (el) {
        el.addEventListener('input', updateStudentDashboard);
        el.addEventListener('change', updateStudentDashboard);
      }
    });

    // CSV Download
    document.getElementById('btn-export-csv').addEventListener('click', function() {
      var Ca = Math.max(1e-4, sanitizeInput(inpCa.value, 0.1));
      var Va = Math.max(0.1, sanitizeInput(inpVa.value, 25.0));
      var Cb = Math.max(1e-4, sanitizeInput(inpCb.value, 0.1));
      var res = calculateCurvePoints(currentSystemType, Ca, Va, Cb, currentPK);

      var csv = 'Volume_Added_mL,pH,First_Derivative\n';
      res.points.forEach(function(p) {
        csv += p.volumeAdded + ',' + p.pH + ',' + p.derivative + '\n';
      });
      var blob = new Blob([csv], { type: 'text/csv' });
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url;
      a.download = 'titration_curve_data.csv';
      a.click();
      URL.revokeObjectURL(url);
    });

    // Copy SOP
    document.getElementById('btn-copy-sop').addEventListener('click', function() {
      navigator.clipboard.writeText(outSop.textContent).then(function() {
        alert('Lab procedure copied to clipboard!');
      });
    });

    // Share URL
    document.getElementById('btn-share-link').addEventListener('click', function() {
      navigator.clipboard.writeText(window.location.href).then(function() {
        alert('Setup URL copied to clipboard!');
      });
    });

    document.getElementById('btn-reset-defaults').addEventListener('click', function() {
      window.location.href = window.location.pathname;
    });

    // Initial Load
    updateStudentDashboard();
  })();
</script>