---
// src/pages/titration.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import titrationPresets from '../data/titrationPairs.json';
import { COMMON_INDICATORS, calculateTitration } from '../lib/calculations/titration';

// Default initial simulation (Acetic acid vs. NaOH)
const defaultPreset = titrationPresets[0];
const initialResult = calculateTitration({
  systemType: defaultPreset.systemType as any,
  analyteConcentration: defaultPreset.defaultAnalyteConc,
  analyteVolume: defaultPreset.defaultAnalyteVol,
  titrantConcentration: defaultPreset.defaultTitrantConc,
  pKa: defaultPreset.pKa,
  analyteName: defaultPreset.analyteName,
  titrantName: defaultPreset.titrantName,
  selectedIndicator: defaultPreset.recommendedIndicator
});

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://chemistrycal.com';
const canonicalUrl = `${siteUrl}/titration`;

const pageTitle = "Acid-Base Titration Studio | pH Curve & 1st Derivative Generator";
const pageDescription = "Simulate acid-base titration curves, compute equivalence points, buffer capacities, and numerical first derivatives (dpH/dV) with indicator transition zones and Overleaf LaTeX exports.";

// Structured Schema Markup
const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `${canonicalUrl}#software`,
      "name": "Acid-Base Titration & Inflection Studio",
      "url": canonicalUrl,
      "applicationCategory": "EducationalApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Runs 100% offline via local client-side execution.",
      "description": pageDescription,
      "featureList": [
        "Dynamic pH Sigmoidal Curve Visualizer",
        "Numerical First Derivative (dpH/dV) Peak Detection",
        "Weak Acid & Weak Base Buffer Capacity Modeling (Henderson-Hasselbalch)",
        "Indicator Transition Band Evaluator (Phenolphthalein, Bromothymol Blue, Methyl Orange)",
        "1-Click Overleaf LaTeX Export and BibTeX Academic Citation",
        "1-Click Electronic Lab Notebook (ELN) Benchtop SOP Recipe",
        "CSV Numerical Data Export",
        "Experimental Lab Data Scatter Point Overlay",
        "Printable Secondary Container Benchtop Label Generator"
      ]
    },
    {
      "@type": "HowTo",
      "@id": `${canonicalUrl}#howto`,
      "name": "How to Determine the Equivalence Point and Titration Curve of an Acid-Base Reaction",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Select System and Enter Concentrations",
          "text": "Select your chemical system (Strong/Strong, Weak Acid/Strong Base, or Weak Base/Strong Acid) and input the analyte volume, molarity, and titrant molarity."
        },
        {
          "@type": "HowToStep",
          "name": "Inspect Inflection and Equivalence Points",
          "text": "Identify the equivalence volume (Veq) and pH where stoichiometric neutralization occurs using the sigmoidal curve or the peak of the 1st derivative."
        },
        {
          "@type": "HowToStep",
          "name": "Verify Chemical Indicator Compatibility",
          "text": "Select an indicator to check that its pH transition range brackets the steep vertical inflection zone."
        },
        {
          "@type": "HowToStep",
          "name": "Export Data and Protocol",
          "text": "Download numerical curve data as a CSV file, export high-res vector graphics, or copy the formatted benchtop SOP into your laboratory notebook."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Why is the equivalence point pH greater than 7 for a weak acid titrated with a strong base?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "At the equivalence point, all weak acid has reacted to form its conjugate base (A-). This conjugate base hydrolyzes in water: A- + H2O <=> HA + OH-, producing hydroxide ions and resulting in an alkaline equivalence pH (typically between 8.0 and 9.5)."
          }
        },
        {
          "@type": "Question",
          "name": "What is the physical significance of the half-equivalence point?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "At half-equivalence (V = Veq / 2), exactly half of the original weak acid has been converted to its conjugate base, making [HA] equal to [A-]. Under the Henderson-Hasselbalch equation, log([A-]/[HA]) becomes log(1) = 0, meaning pH = pKa."
          }
        },
        {
          "@type": "Question",
          "name": "How does the first derivative (dpH/dV) pinpoint the equivalence volume?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The titration curve experiences its steepest slope at the equivalence point where buffer capacity reaches a minimum. The numerical first derivative dpH/dV converts this steep slope into a sharp peak, locating the exact stoichiometric inflection volume."
          }
        },
        {
          "@type": "Question",
          "name": "Why does this titration simulator work offline?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The calculation engine runs entirely within your browser using client-side JavaScript. No data is sent to external servers, allowing full functionality in laboratory basements or without internet connectivity."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Schema Markup injected safely inside layout -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaData)}></script>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-10">

    <div class="space-y-2">
      <nav class="text-xs text-slate-400 flex items-center gap-2">
        <a href="/" class="hover:text-cyan-400 transition">Home</a>
        <span>/</span>
        <a href="/tools" class="hover:text-cyan-400 transition">Analytical Tools</a>
        <span>/</span>
        <span class="text-slate-200">Titration Studio</span>
      </nav>
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
            Acid-Base Titration &amp; Inflection Studio
          </h1>
          <p class="text-base text-slate-400 mt-1 max-w-3xl">
            Simulate real-time neutralization curves, Henderson-Hasselbalch buffer capacities, and first-derivative (<span class="font-mono text-cyan-300">dpH/dV</span>) inflection peaks with indicator transition zones.
          </p>
        </div>

        <div class="flex items-center gap-2">
          <button id="btn-share-link" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-200 border border-slate-700 transition shadow-sm active:scale-95">
            <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path></svg>
            Share URL State
          </button>
          <button id="btn-reset-defaults" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-300 border border-slate-700 transition shadow-sm active:scale-95">
            Reset
          </button>
        </div>
      </div>
    </div>

    <div id="ghs-alert-box" class="p-3.5 rounded-xl bg-amber-950/40 border border-amber-800/50 flex items-start gap-3 text-xs text-amber-200">
      <div class="w-5 h-5 rounded bg-amber-500/20 text-amber-400 flex items-center justify-center flex-shrink-0 font-bold">!</div>
      <div class="space-y-0.5">
        <span class="font-semibold text-amber-300" id="ghs-alert-title">Chemical Safety Advisory:</span>
        <p id="ghs-alert-text">{defaultPreset.ghsAlert}</p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <div class="lg:col-span-5 space-y-6">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-xl space-y-5">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <h2 class="text-sm font-bold uppercase tracking-wider text-slate-200 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
              Experimental Setup
            </h2>
            <span class="text-xs text-slate-400">Pure Client-Side Math</span>
          </div>

          <div class="space-y-1.5">
            <label for="select-preset" class="text-xs font-medium text-slate-300 flex items-center justify-between">
              <span>Standard Laboratory System</span>
              <span class="text-[10px] text-cyan-400">Auto-fills constants</span>
            </label>
            <select id="select-preset" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-cyan-500 transition">
              {titrationPresets.map((p) => (
                <option value={p.id}>{p.name} ({p.analyteFormula})</option>
              ))}
              <option value="custom">Custom System Entry...</option>
            </select>
          </div>

          <div class="space-y-1.5">
            <label for="select-system-type" class="text-xs font-medium text-slate-300">System Chemistry Model</label>
            <select id="select-system-type" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-cyan-500 transition">
              <option value="weak_acid_strong_base">Weak Acid vs. Strong Base (CH₃COOH / NaOH)</option>
              <option value="strong_acid_strong_base">Strong Acid vs. Strong Base (HCl / NaOH)</option>
              <option value="weak_base_strong_acid">Weak Base vs. Strong Acid (NH₃ / HCl)</option>
            </select>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div class="space-y-1">
              <label for="input-analyte-name" class="text-xs text-slate-400">Analyte In Flask</label>
              <input type="text" id="input-analyte-name" value={defaultPreset.analyteName} class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-slate-200 focus:border-cyan-500 focus:outline-none" />
            </div>
            <div class="space-y-1">
              <label for="input-titrant-name" class="text-xs text-slate-400">Titrant In Burette</label>
              <input type="text" id="input-titrant-name" value={defaultPreset.titrantName} class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-slate-200 focus:border-cyan-500 focus:outline-none" />
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4 pt-2">
            <div class="space-y-1">
              <label for="input-ca" class="text-xs font-medium text-slate-300 flex items-center justify-between">
                <span>Analyte Conc. (C<sub>a</sub>)</span>
              </label>
              <div class="relative">
                <input
                  type="text"
                  inputmode="decimal"
                  id="input-ca"
                  value={defaultPreset.defaultAnalyteConc}
                  class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white font-mono focus:border-cyan-500 focus:outline-none"
                />
                <span class="absolute right-3 top-2 text-xs text-slate-500 font-mono">M</span>
              </div>
            </div>

            <div class="space-y-1">
              <label for="input-va" class="text-xs font-medium text-slate-300 flex items-center justify-between">
                <span>Analyte Vol. (V<sub>a</sub>)</span>
              </label>
              <div class="relative">
                <input
                  type="text"
                  inputmode="decimal"
                  id="input-va"
                  value={defaultPreset.defaultAnalyteVol}
                  class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white font-mono focus:border-cyan-500 focus:outline-none"
                />
                <span class="absolute right-3 top-2 text-xs text-slate-500 font-mono">mL</span>
              </div>
            </div>

            <div class="space-y-1">
              <label for="input-cb" class="text-xs font-medium text-slate-300 flex items-center justify-between">
                <span>Titrant Conc. (C<sub>b</sub>)</span>
              </label>
              <div class="relative">
                <input
                  type="text"
                  inputmode="decimal"
                  id="input-cb"
                  value={defaultPreset.defaultTitrantConc}
                  class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white font-mono focus:border-cyan-500 focus:outline-none"
                />
                <span class="absolute right-3 top-2 text-xs text-slate-500 font-mono">M</span>
              </div>
            </div>

            <div class="space-y-1" id="wrap-pk">
              <label for="input-pk" id="label-pk" class="text-xs font-medium text-slate-300 flex items-center justify-between">
                <span>Dissociation (pK<sub>a</sub>)</span>
              </label>
              <input
                type="text"
                inputmode="decimal"
                id="input-pk"
                value={defaultPreset.pKa}
                class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white font-mono focus:border-cyan-500 focus:outline-none"
              />
            </div>
          </div>

          <div class="space-y-2 pt-2 border-t border-slate-800">
            <label for="select-indicator" class="text-xs font-medium text-slate-300 flex items-center justify-between">
              <span>Colorimetric Indicator Overlay</span>
              <span id="indicator-range-tag" class="text-[11px] text-pink-400 font-mono">pH 8.2 - 10.0</span>
            </label>
            <select id="select-indicator" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-cyan-500 transition">
              {COMMON_INDICATORS.map((ind) => (
                <option value={ind.name} selected={ind.name === defaultPreset.recommendedIndicator}>
                  {ind.name} ({ind.colorChange})
                </option>
              ))}
            </select>

            <div class="flex items-center gap-3 p-2.5 rounded-lg bg-slate-950 border border-slate-800 text-xs">
              <div id="flask-preview-dot" class="w-6 h-6 rounded-full border border-slate-600 transition-colors duration-500 shadow-inner flex items-center justify-center font-bold text-[9px]">
                pH
              </div>
              <div class="space-y-0.5">
                <span class="font-semibold text-slate-300">Flask Visual State at Equivalence:</span>
                <p id="flask-color-desc" class="text-[11px] text-slate-400">Loading transition color...</p>
              </div>
            </div>

            <p id="indicator-status-msg" class="text-[11px] text-slate-400 leading-relaxed pt-0.5">
              {initialResult.indicator.statusNote}
            </p>
          </div>

          <div class="grid grid-cols-2 gap-3 pt-3">
            <button id="btn-export-csv" class="w-full py-2.5 px-3 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-white border border-slate-700 flex items-center justify-center gap-2 transition active:scale-95 shadow">
              <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
              Export CSV Points
            </button>
            <button id="btn-copy-sop" class="w-full py-2.5 px-3 rounded-lg bg-cyan-600 hover:bg-cyan-500 text-xs font-bold text-slate-950 flex items-center justify-center gap-1.5 transition active:scale-95 shadow-lg shadow-cyan-950">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path></svg>
              Copy Lab SOP
            </button>
          </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-2 gap-3">
          <div class="bg-slate-900 border border-slate-800 rounded-xl p-3.5">
            <span class="text-[11px] font-medium text-slate-400">Equivalence Vol (V<sub>eq</sub>)</span>
            <div class="text-xl font-bold font-mono text-cyan-400 mt-0.5">
              <span id="metric-veq">{initialResult.equivalenceVolume}</span> <span class="text-xs text-slate-400">mL</span>
            </div>
            <span class="text-[10px] text-slate-500">Stoichiometric endpoint</span>
          </div>

          <div class="bg-slate-900 border border-slate-800 rounded-xl p-3.5">
            <span class="text-[11px] font-medium text-slate-400">Equivalence pH</span>
            <div class="text-xl font-bold font-mono text-pink-400 mt-0.5">
              <span id="metric-eqph">{initialResult.equivalencePH}</span>
            </div>
            <span class="text-[10px] text-slate-500">Neutralization point</span>
          </div>

          <div class="bg-slate-900 border border-slate-800 rounded-xl p-3.5">
            <span class="text-[11px] font-medium text-slate-400">Half-Eq Vol (V<sub>½</sub>)</span>
            <div class="text-xl font-bold font-mono text-amber-400 mt-0.5">
              <span id="metric-halfv">{initialResult.halfEquivalenceVolume}</span> <span class="text-xs text-slate-400">mL</span>
            </div>
            <span class="text-[10px] text-slate-500">Buffer midpoint</span>
          </div>

          <div class="bg-slate-900 border border-slate-800 rounded-xl p-3.5">
            <span class="text-[11px] font-medium text-slate-400">Half-Eq pH (pK<sub>a</sub>)</span>
            <div class="text-xl font-bold font-mono text-emerald-400 mt-0.5">
              <span id="metric-halfph">{initialResult.halfEquivalencePH}</span>
            </div>
            <span class="text-[10px] text-slate-500">pH = pK<sub>a</sub></span>
          </div>
        </div>

      </div>

      <div class="lg:col-span-7 space-y-4">
        
        <div class="flex flex-wrap items-center justify-between gap-2.5 bg-slate-900 border border-slate-800 rounded-xl p-3 text-xs shadow-md">
          <div class="flex flex-wrap items-center gap-2">
            <button id="btn-toggle-lab-mode" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-medium transition active:scale-95 flex items-center gap-1.5">
              🧪 Overlay Lab Data
            </button>
            <button id="btn-print-titration-label" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-medium transition active:scale-95 flex items-center gap-1.5">
              🏷️ Print Flask Label
            </button>
          </div>
          <button id="btn-download-svg" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-cyan-300 border border-slate-700 font-semibold transition active:scale-95 flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
            Download SVG
          </button>
        </div>

        <div id="drawer-lab-mode" class="hidden bg-slate-900 border border-cyan-800/50 rounded-xl p-4 space-y-3 text-xs shadow-xl">
          <div class="flex justify-between items-center">
            <span class="font-bold text-slate-200 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-yellow-400"></span>
              Paste Experimental Burette Readings
            </span>
            <span class="text-slate-400 text-[11px]">Format: Volume &lt;space&gt; pH per line</span>
          </div>
          <textarea id="input-raw-lab-data" rows="4" placeholder="0.0  2.88&#10;5.0  4.12&#10;12.5 4.76&#10;25.0 8.72&#10;30.0 12.05" class="w-full bg-slate-950 border border-slate-700 rounded-lg p-2.5 font-mono text-cyan-300 focus:outline-none focus:border-cyan-500"></textarea>
          <div class="flex justify-end gap-2">
            <button id="btn-clear-lab-data" class="px-3 py-1 rounded bg-slate-800 text-slate-400 hover:text-white">Clear Points</button>
            <button id="btn-apply-lab-data" class="px-3 py-1 rounded bg-cyan-600 font-bold text-slate-950 hover:bg-cyan-500">Plot Points Over Curve</button>
          </div>
        </div>

        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 sm:p-6 shadow-2xl space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-800 pb-3">
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-cyan-400"></div>
              <h3 class="text-base font-bold text-white tracking-wide">Dynamic Titration Curve</h3>
            </div>
            <div class="flex flex-wrap items-center gap-3 text-xs">
              <span class="flex items-center gap-1.5 text-cyan-300">
                <span class="w-3 h-0.5 bg-cyan-400 inline-block"></span> pH Curve
              </span>
              <span class="flex items-center gap-1.5 text-violet-400">
                <span class="w-3 h-0.5 border-t border-dashed border-violet-400 inline-block"></span> 1st Deriv
              </span>
              <span class="flex items-center gap-1.5 text-pink-400">
                <span class="w-2.5 h-2 rounded bg-pink-500/30 inline-block"></span> Indicator
              </span>
              <span class="flex items-center gap-1.5 text-yellow-400">
                <span class="w-2 h-2 rounded-full bg-yellow-400 inline-block"></span> Lab Data
              </span>
            </div>
          </div>

          <div id="svg-chart-container" class="w-full overflow-hidden"></div>

          <div class="flex flex-wrap items-center justify-between text-xs text-slate-400 pt-1 border-t border-slate-800/80">
            <div>Inflection Max Slope: <span id="metric-max-deriv" class="font-mono text-violet-300">{initialResult.maxDerivativeValue}</span> dpH/mL</div>
            <div id="metric-buffer-range-note" class="text-amber-300 font-mono">
              Buffer Capacity Zone: [3.76 - 5.76]
            </div>
          </div>
        </div>

        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-xl space-y-4">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <h3 class="text-sm font-bold uppercase tracking-wider text-slate-200 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              Academic Citation &amp; Overleaf Exporters
            </h3>
            <span class="text-xs text-slate-400">ELN / Manuscript Ready</span>
          </div>

          <div class="flex gap-2 border-b border-slate-800 text-xs">
            <button id="tab-btn-sop" class="pb-2 font-bold text-cyan-400 border-b-2 border-cyan-400 transition">Lab Notebook SOP</button>
            <button id="tab-btn-latex" class="pb-2 font-medium text-slate-400 hover:text-slate-200 transition">Overleaf / LaTeX</button>
            <button id="tab-btn-bibtex" class="pb-2 font-medium text-slate-400 hover:text-slate-200 transition">BibTeX Citation</button>
          </div>

          <div class="relative">
