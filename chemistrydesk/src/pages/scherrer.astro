    function loadUrlParams() {
      var params = new URLSearchParams(window.location.search);
      if (params.has('twoTheta')) inpTwoTheta.value = params.get('twoTheta');
      if (params.has('fwhm')) inpFwhmObs.value = params.get('fwhm');
      if (params.has('inst')) inpFwhmInst.value = params.get('inst');
      if (params.has('lambda')) {
        inpLambda.value = params.get('lambda');
        selectSource.value = 'custom';
      }
      if (params.has('k')) {
        inpK.value = params.get('k');
        selectShape.value = 'custom';
      }
    }

    categoryFilter.addEventListener('change', function() {
      var selected = categoryFilter.value;
      document.querySelectorAll('.preset-btn').forEach(function(btn) {
        var cat = btn.dataset.category;
        if (selected === 'all' || cat === selected) {
          btn.style.display = 'inline-block';
        } else {
          btn.style.display = 'none';
        }
      });
    });

    selectSource.addEventListener('change', function() {
      if (selectSource.value !== 'custom') {
        inpLambda.value = selectSource.value;
      }
      runScherrerEngine();
    });

    inpLambda.addEventListener('input', function() {
      selectSource.value = 'custom';
      runScherrerEngine();
    });

    selectShape.addEventListener('change', function() {
      if (selectShape.value !== 'custom') {
        inpK.value = selectShape.value;
      }
      runScherrerEngine();
    });

    inpK.addEventListener('input', function() {
      selectShape.value = 'custom';
      runScherrerEngine();
    });

    checkEnableInst.addEventListener('change', function() {
      inpFwhmInst.disabled = !checkEnableInst.checked;
      inpFwhmInst.style.background = checkEnableInst.checked ? '#ffffff' : '#f8fafc';
      runScherrerEngine();
    });

    function renderPeakSvg(betaDeg) {
      var center = 200;
      var baseline = 120;
      var visualHalfWidth = Math.min(Math.max(betaDeg * 120, 15), 140);
      
      var d = 'M 20 ' + baseline;
      for (var x = 20; x <= 380; x += 5) {
        var diff = x - center;
        var intensity = 100 * Math.exp(-4 * Math.log(2) * Math.pow(diff / (visualHalfWidth * 2), 2));
        var y = baseline - intensity;
        d += ' L ' + x + ' ' + y.toFixed(1);
      }
      d += ' L 380 ' + baseline + ' Z';
      peakCurve.setAttribute('d', d);

      var halfMaxY = 70;
      var x1 = center - visualHalfWidth;
      var x2 = center + visualHalfWidth;
      fwhmIndicator.setAttribute('x1', x1.toFixed(1));
      fwhmIndicator.setAttribute('x2', x2.toFixed(1));
      fwhmIndicator.setAttribute('y1', halfMaxY.toString());
      fwhmIndicator.setAttribute('y2', halfMaxY.toString());

      fwhmText.setAttribute('y', (halfMaxY - 6).toString());
      fwhmPeakTag.textContent = 'FWHM (b): ' + betaDeg.toFixed(3) + ' deg';
    }

    function runScherrerEngine() {
      var twoThetaDeg = sanitizeNumber(inpTwoTheta.value);
      var fwhmObsRaw = sanitizeNumber(inpFwhmObs.value);
      var fwhmUnit = selectFwhmUnit.value;
      var useInst = checkEnableInst.checked;
      var fwhmInstDeg = useInst ? sanitizeNumber(inpFwhmInst.value) : 0;
      var profile = selectProfile.value;
      var lambdaAngstrom = sanitizeNumber(inpLambda.value);
      var kFactor = sanitizeNumber(inpK.value);

      warnBox.style.display = 'none';

      if (twoThetaDeg <= 0 || twoThetaDeg >= 180) {
        warnBox.style.display = 'block';
        warnBox.textContent = 'Invalid 2-theta range: Diffraction detector position must be between 0 deg and 180 deg.';
        return;
      }

      var thetaDeg = twoThetaDeg / 2;
      thetaValEl.textContent = thetaDeg.toFixed(2);
      centerThetaLabel.textContent = 'Peak Centroid (' + twoThetaDeg.toFixed(2) + ' deg)';
      var thetaRad = thetaDeg * (Math.PI / 180);
      var sinTheta = Math.sin(thetaRad);
      var cosTheta = Math.cos(thetaRad);

      if (sinTheta > 0 && lambdaAngstrom > 0) {
        var dSpacingAngstrom = lambdaAngstrom / (2 * sinTheta);
        displayDSpacing.textContent = dSpacingAngstrom.toFixed(4) + ' \u00C5';
      } else {
        displayDSpacing.textContent = '--';
      }

      var fwhmObsDeg = (fwhmUnit === 'rad') ? fwhmObsRaw * (180 / Math.PI) : fwhmObsRaw;

      if (fwhmObsDeg <= 0) {
        primarySizeNm.textContent = '--';
        displayAngstrom.textContent = '--';
        displayBetaRad.textContent = '--';
        displayDislocation.textContent = '--';
        return;
      }

      var betaCorrectedDeg = fwhmObsDeg;

      if (useInst && fwhmInstDeg > 0) {
        if (fwhmObsDeg <= fwhmInstDeg) {
          warnBox.style.display = 'block';
          warnBox.textContent = 'Instrumental Limit: Observed FWHM cannot be smaller than or equal to instrumental broadening.';
          primarySizeNm.textContent = 'Limit Exceeded';
          displayAngstrom.textContent = '--';
          displayBetaRad.textContent = '--';
          displayDislocation.textContent = '--';
          return;
        }

        if (profile === 'gaussian') {
          betaCorrectedDeg = Math.sqrt(Math.pow(fwhmObsDeg, 2) - Math.pow(fwhmInstDeg, 2));
        } else {
          betaCorrectedDeg = Math.max(0, fwhmObsDeg - fwhmInstDeg);
        }
      }

      var betaRad = betaCorrectedDeg * (Math.PI / 180);

      if (betaRad <= 0 || lambdaAngstrom <= 0 || kFactor <= 0 || cosTheta <= 0) {
        return;
      }

      var dAngstrom = (kFactor * lambdaAngstrom) / (betaRad * cosTheta);
      var dNanometer = dAngstrom / 10;
      var dMeters = dNanometer * 1e-9;
      var dislocationDensity = 1 / (dMeters * dMeters);

      primarySizeNm.textContent = dNanometer.toFixed(2) + ' nm';
      displayAngstrom.textContent = dAngstrom.toFixed(1) + ' \u00C5';
      displayBetaRad.textContent = betaRad.toFixed(5) + ' rad';
      displayDislocation.textContent = dislocationDensity.toExponential(2) + ' lines/m\u00B2';

      renderPeakSvg(betaCorrectedDeg);

      var pct = Math.min(Math.max((dNanometer / 100) * 100, 2), 100);
      scaleProgress.style.width = pct + '%';

      if (dNanometer < 5) {
        regimeBadge.textContent = 'Ultrafine / Quantum Dots (<5 nm)';
        regimeBadge.style.color = '#0284c7';
      } else if (dNanometer <= 50) {
        regimeBadge.textContent = 'Nanocrystalline Domain (5 - 50 nm)';
        regimeBadge.style.color = '#059669';
      } else if (dNanometer <= 100) {
        regimeBadge.textContent = 'Upper Nanoscale (50 - 100 nm)';
        regimeBadge.style.color = '#d97706';
      } else {
        regimeBadge.textContent = 'Approaching Scherrer Accuracy Limit (>100 nm)';
        regimeBadge.style.color = '#dc2626';
      }

      summaryReport.innerHTML = 
        'Sample: <strong>' + activePresetTag.textContent + '</strong><br />' +
        'Bragg Angle: 2&theta; = ' + twoThetaDeg.toFixed(2) + '&deg; (&theta; = ' + thetaDeg.toFixed(2) + '&deg;) | cos(&theta;) = ' + cosTheta.toFixed(4) + '<br />' +
        'Observed FWHM: ' + fwhmObsDeg.toFixed(4) + '&deg; | Inst Broadening: ' + (useInst ? fwhmInstDeg.toFixed(4) + '&deg;' : 'Disabled') + '<br />' +
        'Corrected Broadening &beta;: ' + betaCorrectedDeg.toFixed(4) + '&deg; &rarr; <strong>' + betaRad.toFixed(6) + ' radians</strong><br />' +
        'Source: &lambda; = ' + lambdaAngstrom + ' \u00C5 | Shape Factor: K = ' + kFactor + '<br />' +
        '<strong>Mean Domain Size (D): ' + dNanometer.toFixed(2) + ' nm (' + dAngstrom.toFixed(1) + ' \u00C5) | Dislocation Density: ' + dislocationDensity.toExponential(2) + ' lines/m&sup2;</strong>';

      labelCompoundName.textContent = activePresetTag.textContent;
      labelSize.textContent = dNanometer.toFixed(2) + ' nm';
      label2Theta.textContent = twoThetaDeg.toFixed(2) + ' deg';
      labelDislocation.textContent = dislocationDensity.toExponential(2) + ' lines/m2';
      labelTarget.textContent = selectSource.options[selectSource.selectedIndex].text.split(' ')[0];

      syncUrlParams();
    }

    document.querySelectorAll('.preset-btn').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        var t = e.currentTarget;
        inpTwoTheta.value = t.dataset['2theta'];
        inpFwhmObs.value = t.dataset.fwhm;
        inpFwhmInst.value = t.dataset.inst;
        inpLambda.value = t.dataset.lambda;
        inpK.value = t.dataset.k;
        selectSource.value = t.dataset.lambda;
        selectShape.value = t.dataset.k;
        selectFwhmUnit.value = 'deg';
        checkEnableInst.checked = true;
        inpFwhmInst.disabled = false;
        activePresetTag.textContent = t.dataset.compound || 'Benchmark Material';
        runScherrerEngine();
      });
    });

    document.getElementById('copyLatexBtn').addEventListener('click', function() {
      var twoTheta = inpTwoTheta.value;
      var k = inpK.value;
      var lambda = inpLambda.value;
      var beta = displayBetaRad.textContent;
      var sizeNm = primarySizeNm.textContent;
      
      var thetaHalved = (parseFloat(twoTheta) / 2).toFixed(2);
      var latexStr = 'D = \\frac{K \\cdot \\lambda}{\\beta \\cdot \\cos(\\theta)} = \\frac{' + k + ' \\cdot ' + lambda + '\\,\\mathrm{\\u00C5}}{' + beta + '\\,\\mathrm{rad} \\cdot \\cos(' + thetaHalved + '^\\circ)} = ' + sizeNm;
      navigator.clipboard.writeText(latexStr);
      alert('Complete LaTeX derivation equation copied to clipboard.');
    });

    document.getElementById('copyBibtexBtn').addEventListener('click', function() {
      var bibtex = '@article{scherrer1918bestimmung,\n  title={Bestimmung der Gr{\\"o}{\\ss}e und der inneren Struktur von Kolloidteilchen mittels R{\\"o}ntgenstrahlen},\n  author={Scherrer, Paul},\n  journal={Nachrichten von der Gesellschaft der Wissenschaften zu G{\\"o}ttingen, Mathematisch-Physikalische Klasse},\n  volume={1918},\n  pages={98--100},\n  year={1918}\n}';
      navigator.clipboard.writeText(bibtex);
      alert('Scherrer BibTeX citation copied to clipboard.');
    });

    document.getElementById('exportCsvBtn').addEventListener('click', function() {
      var csv = 'Parameter,Value,Unit\n' +
        'Sample_Name,' + activePresetTag.textContent + ',text\n' +
        '2-Theta,' + inpTwoTheta.value + ',degrees\n' +
        'Bragg_d_Spacing,' + displayDSpacing.textContent.replace(' \u00C5','') + ',Angstrom\n' +
        'Observed_FWHM,' + inpFwhmObs.value + ',' + selectFwhmUnit.value + '\n' +
        'Inst_Broadening,' + inpFwhmInst.value + ',degrees\n' +
        'Corrected_Beta_Rad,' + displayBetaRad.textContent + ',radians\n' +
        'Wavelength,' + inpLambda.value + ',Angstrom\n' +
        'Shape_Factor_K,' + inpK.value + ',dimensionless\n' +
        'Crystallite_Size_nm,' + primarySizeNm.textContent.replace(' nm','') + ',nm\n' +
        'Crystallite_Size_Angstrom,' + displayAngstrom.textContent.replace(' \u00C5','') + ',Angstrom\n' +
        'Dislocation_Density,' + displayDislocation.textContent.replace(' lines/m\u00B2','') + ',lines/m^2\n';
      var blob = new Blob([csv], { type: 'text/csv' });
      var url = window.URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.setAttribute('href', url);
      a.setAttribute('download', 'pxrd_scherrer_crystallite_size.csv');
      a.click();
    });

    document.getElementById('shareSetupBtn').addEventListener('click', function() {
      navigator.clipboard.writeText(window.location.href);
      alert('Experiment URL copied to clipboard! Anyone opening this link will see your exact calculations.');
    });

    document.getElementById('printLabelBtn').addEventListener('click', function() {
      printableLabelWrapper.style.display = printableLabelWrapper.style.display === 'none' ? 'block' : 'none';
      if (printableLabelWrapper.style.display === 'block') {
        printableLabelWrapper.scrollIntoView({ behavior: 'smooth' });
      }
    });

    document.getElementById('triggerPrintBtn').addEventListener('click', function() {
      window.print();
    });

    [inpTwoTheta, inpFwhmObs, inpFwhmInst, inpLambda, inpK].forEach(function(input) {
      input.addEventListener('input', function() {
        activePresetTag.textContent = 'Custom Sample';
        runScherrerEngine();
      });
    });

    [selectFwhmUnit, selectProfile].forEach(function(select) {
      select.addEventListener('change', runScherrerEngine);
    });

    loadUrlParams();
    runScherrerEngine();
  </script>
</BaseLayout>