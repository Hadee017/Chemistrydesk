            <option value="lorentzian">Lorentzian / Cauchy Deconvolution: &beta;<sub>obs</sub> - &beta;<sub>inst</sub></option>
          </select>
        </div>

        <!-- X-Ray Radiation Source & Wavelength -->
        <div style="margin-bottom: 1.25rem;">
          <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #334155; margin-bottom: 0.35rem;">
            X-RAY TUBE SOURCE &amp; WAVELENGTH (&lambda;)
          </label>
