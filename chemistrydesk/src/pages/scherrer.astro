              <strong id="displayAngstrom" style="color: #34d399; font-size: 1.2rem;">--</strong>
            </div>
            <div>
              <span style="color: #94a3b8; display: block; font-size: 0.75rem; text-transform: uppercase;">Corrected &beta; (rad)</span>
              <strong id="displayBetaRad" style="color: #e2e8f0; font-size: 1.15rem;">--</strong>
            </div>
          </div>
        </div>

        <!-- Nanomaterial Domain Scale Visualizer -->
