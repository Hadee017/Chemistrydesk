            </select>
            <div style="display: flex;">
              <input type="number" id="lambdaInput" step="any" value="1.54056" style="width: 100%; padding: 0.65rem 0.5rem; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.9rem; font-weight: 600;" />
            </div>
