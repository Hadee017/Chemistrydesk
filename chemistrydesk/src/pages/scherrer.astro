---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="PXRD Scherrer Crystallite Size Calculator (FWHM & Broadening) | ChemistryDesk"
  description="High-precision Scherrer equation solver for powder X-ray diffraction (PXRD). Features instrumental line broadening correction, multi-wavelength targets, shape factors, and LaTeX export."
>
  <!-- Schema: WebApplication + HowTo + FAQPage for Search Engine Indexing -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebApplication",
        "name": "ChemistryDesk PXRD Scherrer Crystallite Size Studio",
        "applicationCategory": "EducationalApplication",
        "operatingSystem": "All",
        "browserRequirements": "Requires JavaScript",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        }
      },
      {
        "@type": "HowTo",
        "name": "How to Calculate Crystallite Size from PXRD Peaks",
        "step": [
          {
            "@type": "HowToStep",
            "name": "Identify Peak Position",
            "text": "Locate the 2-theta peak centroid from your diffractometer scan."
          },
          {
            "@type": "HowToStep",
            "name": "Extract FWHM",
            "text": "Fit the diffraction reflection to extract the full width at half maximum (FWHM) in degrees."
          },
          {
            "@type": "HowToStep",
            "name": "Subtract Instrumental Broadening",
            "text": "Correct the observed FWHM using a standard reference material via deconvolution."
          },
          {
            "@type": "HowToStep",
            "name": "Apply Scherrer Formula",
            "text": "Convert Bragg angle theta and corrected broadening beta into radians, then solve D = (K * lambda) / (beta * cos(theta))."
          }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "What is the difference between crystallite size and particle size?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Crystallite size represents the coherence length of single-crystal domains within a grain. A physical particle typically consists of an agglomeration of multiple crystalline sub-domains."
            }
          },
          {
            "@type": "Question",
            "name": "What is the valid limit of the Scherrer equation?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "The Scherrer equation is generally reliable for crystallite domains between 1 nm and 100 nm. Beyond 100-200 nm, instrumental line broadening dominates sample peak width."
            }
          },
          {
            "@type": "Question",
            "name": "Why must FWHM be converted to radians in the Scherrer equation?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "The Scherrer equation derives from Fourier transform principles where peak broadening beta represents an angular measure in dimensional radians."
            }
          }
        ]
      }
    ]
  })} />

  <main style="max-width: 1060px; margin: 1.5rem auto 3rem auto; padding: 0 1.5rem; font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #1e293b;">
    
    <!-- Navigation Breadcrumbs -->
    <nav style="font-size: 0.8rem; color: #64748b; margin-bottom: 1.25rem;">
      <a href="/" style="color: #0284c7; text-decoration: none;">Home</a> &rsaquo; 
      <span style="color: #94a3b8;"> Materials Characterization</span> &rsaquo; 
      <span style="color: #0f172a; font-weight: 600;">PXRD Scherrer Studio</span>
    </nav>

    <!-- Header Section -->
    <div style="border-bottom: 1px solid #e2e8f0; padding-bottom: 1.75rem; margin-bottom: 2rem;">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span style="font-size: 2.5rem;">📐</span>
        <div>
          <h1 style="font-size: 2.25rem; font-weight: 800; color: #0f172a; letter-spacing: -0.025em; margin: 0;">
            PXRD Scherrer Crystallite Size Studio
          </h1>
          <p style="color: #64748b; font-size: 0.95rem; margin-top: 0.25rem; margin-bottom: 0;">
            Rigorous crystallite domain calculator with instrumental broadening deconvolution and multi-source target selection.
          </p>
        </div>
      </div>
    </div>

    <!-- Quick Presets -->
    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 0.75rem 1rem; margin-bottom: 2rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem; font-size: 0.85rem;">
      <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
        <span style="font-weight: 700; color: #475569; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.05em;">Quick Bench Presets:</span>
        <button class="preset-btn" data-2theta="36.25" data-fwhm="0.28" data-inst="0.08" data-lambda="1.54056" data-k="0.94" style="background: #f8fafc; border: 1px solid #cbd5e1; padding: 0.35rem 0.75rem; border-radius: 6px; cursor: pointer; color: #334155; font-size: 0.8rem; font-weight: 600;">ZnO (101) Nanorods</button>
        <button class="preset-btn" data-2theta="25.28" data-fwhm="0.42" data-inst="0.08" data-lambda="1.54056" data-k="0.89" style="background: #f8fafc; border: 1px solid #cbd5e1; padding: 0.35rem 0.75rem; border-radius: 6px; cursor: pointer; color: #334155; font-size: 0.8rem; font-weight: 600;">Anatase TiO2 (101)</button>
        <button class="preset-btn" data-2theta="11.58" data-fwhm="0.22" data-inst="0.06" data-lambda="1.54056" data-k="0.90" style="background: #f8fafc; border: 1px solid #cbd5e1; padding: 0.35rem 0.75rem; border-radius: 6px; cursor: pointer; color: #334155; font-size: 0.8rem; font-weight: 600;">HKUST-1 MOF (220)</button>
