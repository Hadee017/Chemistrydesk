            </select>
            <input type="number" id="kInput" step="any" value="0.94" style="width: 100%; padding: 0.65rem 0.5rem; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.9rem; font-weight: 600;" />
          </div>
        </div>

        <div id="scherrerWarn" style="display: none; background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; padding: 0.75rem; border-radius: 6px; font-size: 0.8rem; margin-top: 1rem;"></div>
      </div>

      <!-- Real-Time Output & Physical Domain Readout -->
