      var baseMW = sanitizeInput(inpBaseMW.value);
      var acidPurityPct = Math.max(0.1, sanitizeInput(inpAcidPurity.value) || 100);
      var basePurityPct = Math.max(0.1, sanitizeInput(inpBasePurity.value) || 100);

      warnBox.style.display = 'none';

      if (targetPH <= 0 || targetPH >= 14 || rawConc <= 0 || rawVol <= 0 || refPka <= 0 || acidMW <= 0 || baseMW <= 0) {
        acidMassDisplay.textContent = '-- g';
        baseMassDisplay.textContent = '-- g';
        displayCorrPka.textContent = '--';
        displayRatio.textContent = '--';
        betaValueDisplay.textContent = '--';
        betaRatioDisplay.textContent = '--';
        return;
      }

      var cTotalM = toStandardMolar(rawConc, selConcUnit.value);
      var volL = toStandardLiters(rawVol, selVolUnit.value);

      var currentSys = bufferSystems[sysSelect.value];
      var dpKa_dT = currentSys ? currentSys.dpKa : -0.005;
      var pKa_T = refPka + dpKa_dT * (tempC - 25.0);
      displayCorrPka.textContent = pKa_T.toFixed(3);

      var deltaPH = Math.abs(targetPH - pKa_T);
      if (deltaPH > 1.0) {
        warnBox.style.display = 'block';
        warnBox.innerHTML = '<strong>Buffering Window Advisory:</strong> Target pH (' + targetPH.toFixed(2) + ') is outside the recommended range (pKa &plusmn; 1.0 &rarr; ' + (pKa_T - 1.0).toFixed(2) + ' - ' + (pKa_T + 1.0).toFixed(2) + '). Buffer capacity drops sharply beyond this threshold.';
      }

      var ratio = Math.pow(10, targetPH - pKa_T);
      displayRatio.textContent = ratio >= 1000 || ratio <= 0.001 ? ratio.toExponential(2) : ratio.toFixed(3);

      var fracBase = ratio / (1 + ratio);
      var fracAcid = 1 / (1 + ratio);

      var cBaseM = cTotalM * fracBase;
      var cAcidM = cTotalM * fracAcid;

      var theoreticalAcidG = cAcidM * volL * acidMW;
      var theoreticalBaseG = cBaseM * volL * baseMW;

      var massAcidG = theoreticalAcidG / (acidPurityPct / 100);
      var massBaseG = theoreticalBaseG / (basePurityPct / 100);

      function formatMassDisplay(g) {
        if (g < 0.01) return (g * 1000).toFixed(2) + ' mg';
        if (g >= 10) return g.toFixed(2) + ' g';
        return g.toFixed(3) + ' g';
      }

      acidMassDisplay.textContent = formatMassDisplay(massAcidG);
      baseMassDisplay.textContent = formatMassDisplay(massBaseG);

      acidMolarityDisplay.textContent = (cAcidM >= 0.01 ? (cAcidM * 1000).toFixed(2) + ' mM' : (cAcidM * 1000000).toFixed(1) + ' µM') + ' ' + inpAcidName.value;
      baseMolarityDisplay.textContent = (cBaseM >= 0.01 ? (cBaseM * 1000).toFixed(2) + ' mM' : (cBaseM * 1000000).toFixed(1) + ' µM') + ' ' + inpBaseName.value;

      var Ka = Math.pow(10, -pKa_T);
      var H = Math.pow(10, -targetPH);
      var betaM = 2.303 * cTotalM * ((Ka * H) / Math.pow(Ka + H, 2));
      var beta_mM = betaM * 1000;
      betaValueDisplay.textContent = beta_mM.toFixed(2);

      var betaMax_mM = 0.576 * (cTotalM * 1000);
      var betaPct = Math.min(Math.max((beta_mM / betaMax_mM) * 100, 5), 100);
      betaProgressBar.style.width = betaPct.toFixed(0) + '%';
      betaRatioDisplay.textContent = ((beta_mM / betaMax_mM) * 100).toFixed(0) + '% of β_max';

      if (deltaPH <= 0.3) {
        betaQualityBadge.textContent = 'Maximum Capacity (Near pKa)';
        betaQualityBadge.style.color = '#0284c7';
      } else if (deltaPH <= 1.0) {
        betaQualityBadge.textContent = 'Optimal Working Range';
        betaQualityBadge.style.color = '#059669';
      } else {
        betaQualityBadge.textContent = 'Sub-optimal Capacity (>1.0 pH from pKa)';
        betaQualityBadge.style.color = '#d97706';
      }

      renderDynamicTitrationSvg(pKa_T, targetPH);

      var volML = volL * 1000;
      var partialVolML = (volML * 0.8).toFixed(1);
      var finalVolFormatted = volML >= 1000 ? (volML / 1000).toFixed(2) + ' L' : volML.toFixed(1) + ' mL';
      protocolSteps.innerHTML = 
        '<li>Prepare a clean Class-A volumetric flask or calibrated vessel suitable for <strong>' + finalVolFormatted + '</strong>.</li>' +
        '<li>Dispense approximately <strong>' + partialVolML + ' mL</strong> of deionized or Milli-Q water into the container.</li>' +
        '<li>Accurately weigh <strong>' + formatMassDisplay(massAcidG) + '</strong> of ' + inpAcidName.value + ' and <strong>' + formatMassDisplay(massBaseG) + '</strong> of ' + inpBaseName.value + ' on an analytical balance.</li>' +
        '<li>Transfer both reagents into the vessel and stir with a PTFE magnetic bar until completely dissolved.</li>' +
        '<li>Calibrate your pH probe at <strong>' + tempC.toFixed(1) + '&deg;C</strong> and verify the solution pH (Target: ' + targetPH.toFixed(2) + '). Fine-tune with trace dilute HCl or NaOH if necessary.</li>' +
        '<li>Dilute with deionized water up to the final <strong>' + finalVolFormatted + '</strong> graduation line and invert 10 times to homogenize.</li>';

      document.getElementById('labelBufferName').textContent = activeSystemTag.textContent.toUpperCase();
      document.getElementById('labelTargetPH').textContent = targetPH.toFixed(2);
      document.getElementById('labelTotalConc').textContent = rawConc + ' ' + selConcUnit.value;
      document.getElementById('labelAcidAmt').textContent = formatMassDisplay(massAcidG) + ' (' + inpAcidName.value.split(' ')[0] + ')';
      document.getElementById('labelBaseAmt').textContent = formatMassDisplay(massBaseG) + ' (' + inpBaseName.value.split(' ')[0] + ')';
      document.getElementById('labelDate').textContent = new Date().toLocaleDateString();

      syncUrl();
    }

    document.getElementById('customReagentToggleBtn').addEventListener('click', function() {
      sysSelect.value = 'custom';
      activeSystemTag.textContent = 'Custom Reagent Buffer';
      inpAcidName.focus();
    });

    document.querySelectorAll('.buffer-preset-btn').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        var t = e.currentTarget;
        var sys = t.dataset.system;
        sysSelect.value = sys;
        inpPH.value = t.dataset.ph;
        inpConc.value = t.dataset.conc;
        selConcUnit.value = t.dataset.uconc || 'mM';
        inpVol.value = t.dataset.vol;
        selVolUnit.value = t.dataset.uvol || 'mL';
        inpAcidName.value = t.dataset.acid;
        inpAcidMW.value = t.dataset.acMw;
        inpBaseName.value = t.dataset.base;
        inpBaseMW.value = t.dataset.baMw;
        inpRefPka.value = t.dataset.pka;
        inpAcidPurity.value = '100.0';
        inpBasePurity.value = '100.0';
        activeSystemTag.textContent = t.textContent.split('(')[0].trim() || 'Selected Buffer';
        runBufferEngine();
      });
    });

    sysSelect.addEventListener('change', function() {
      var selected = sysSelect.value;
      if (selected !== 'custom' && bufferSystems[selected]) {
        var data = bufferSystems[selected];
        inpAcidName.value = data.acidName;
        inpAcidMW.value = data.acidMW.toString();
        inpBaseName.value = data.baseName;
        inpBaseMW.value = data.baseMW.toString();
        inpRefPka.value = data.pKa.toString();
        inpAcidPurity.value = '100.0';
        inpBasePurity.value = '100.0';
        activeSystemTag.textContent = sysSelect.options[sysSelect.selectedIndex].text.split('(')[0].trim();
      } else {
        activeSystemTag.textContent = 'Custom User Buffer';
      }
      runBufferEngine();
    });

    [inpAcidName, inpBaseName, inpRefPka, inpAcidMW, inpBaseMW].forEach(function(inp) {
      inp.addEventListener('input', function() {
        sysSelect.value = 'custom';
        activeSystemTag.textContent = 'Custom: ' + (inpAcidName.value.split(' ')[0] || 'Buffer');
        runBufferEngine();
      });
    });

    [inpPH, inpTemp, inpConc, inpVol, inpAcidPurity, inpBasePurity].forEach(function(inp) {
      inp.addEventListener('input', runBufferEngine);
    });

    [selConcUnit, selVolUnit].forEach(function(sel) {
      sel.addEventListener('change', runBufferEngine);
    });

    document.getElementById('saveCustomBufferBtn').addEventListener('click', function() {
      var customData = {
        acidName: inpAcidName.value,
        baseName: inpBaseName.value,
        pKa: inpRefPka.value,
        acidMW: inpAcidMW.value,
        baseMW: inpBaseMW.value,
        pH: inpPH.value,
        conc: inpConc.value,
        uconc: selConcUnit.value,
        vol: inpVol.value,
        uvol: selVolUnit.value
      };
      localStorage.setItem('chemistrydesk_buffer_custom', JSON.stringify(customData));
      alert('Custom buffer recipe saved to browser storage.');
    });

    document.getElementById('copyProtocolBtn').addEventListener('click', function() {
      var text = protocolSteps.innerText;
      navigator.clipboard.writeText(text);
      alert('Benchtop preparation protocol copied.');
    });

    document.getElementById('shareSetupBtn').addEventListener('click', function() {
      navigator.clipboard.writeText(window.location.href);
      alert('Recipe URL copied to clipboard.');
    });

    document.getElementById('printLabelBtn').addEventListener('click', function() {
      window.print();
    });

    document.getElementById('copyBufferLatexBtn').addEventListener('click', function() {
      var ph = inpPH.value;
      var pka = displayCorrPka.textContent;
      var r = displayRatio.textContent;
      var latex = '\\mathrm{pH} = \\mathrm{p}K_a + \\log_{10}\\left(\\frac{[\\mathrm{A}^-]}{[\\mathrm{HA}]}\\right) \\implies ' + ph + ' = ' + pka + ' + \\log_{10}(' + r + ')';
      navigator.clipboard.writeText(latex);
      alert('LaTeX equilibrium equation copied to clipboard.');
    });

    // --- ACADEMIC CITATIONS SYSTEM (Zenodo DOI: 10.5281/zenodo.23059466) ---
    var citeDrawer = document.getElementById('citeDrawer');
    var toggleCiteBtn = document.getElementById('toggleCiteBtn');
    var inlineCiteOutput = document.getElementById('inlineCiteOutput');
    var inlineTabs = document.querySelectorAll('.inline-cite-tab');
    var inlineCopyBtn = document.getElementById('inlineCopyCiteBtn');

    var zenodoDoi = "10.5281/zenodo.23059466";
    var currentYear = new Date().getFullYear();

    var bufferCitations = {
      bibtex: '@software{khan_chemistrydesk_buffer_' + currentYear + ',\n' +
              '  author       = {Khan, Bilal},\n' +
              '  title        = {ChemistryDesk: Laboratory Buffer Preparation & Henderson-Hasselbalch Studio},\n' +
              '  year         = {' + currentYear + '},\n' +
              '  version      = {v1.0.1},\n' +
              '  publisher    = {Zenodo},\n' +
              '  doi          = {' + zenodoDoi + '},\n' +
              '  url          = {https://chemistrycal.com/buffer}\n' +
              '}',
      acs: 'Khan, B. ChemistryDesk: Laboratory Buffer Preparation & Henderson-Hasselbalch Studio, version 1.0.1; Zenodo, ' + currentYear + '. https://doi.org/' + zenodoDoi + '.',
      rsc: 'B. Khan, ChemistryDesk: Laboratory Buffer Preparation & Henderson-Hasselbalch Studio, version 1.0.1, Zenodo, ' + currentYear + ', DOI: ' + zenodoDoi + '.',
      nature: 'Khan, B. ChemistryDesk: Laboratory Buffer Preparation & Henderson-Hasselbalch Studio. Zenodo https://doi.org/' + zenodoDoi + ' (' + currentYear + ').',
      elsevier: 'Khan, B., ' + currentYear + '. ChemistryDesk: Laboratory Buffer Preparation & Henderson-Hasselbalch Studio (Version 1.0.1). Zenodo. https://doi.org/' + zenodoDoi + '.',
      wiley: 'B. Khan, ChemistryDesk: Laboratory Buffer Preparation & Henderson-Hasselbalch Studio, version 1.0.1, Zenodo, ' + currentYear + ', DOI: ' + zenodoDoi + '.'
    };

    var activeCiteFormat = 'bibtex';

    function renderCite() {
      if (inlineCiteOutput) {
        inlineCiteOutput.textContent = bufferCitations[activeCiteFormat] || bufferCitations['bibtex'];
      }
    }

    if (toggleCiteBtn && citeDrawer) {
      toggleCiteBtn.addEventListener('click', function(e) {
        e.preventDefault();
        var isClosed = window.getComputedStyle(citeDrawer).display === 'none';
        citeDrawer.style.display = isClosed ? 'block' : 'none';
        toggleCiteBtn.style.background = isClosed ? '#0284c7' : '#e0f2fe';
        toggleCiteBtn.style.color = isClosed ? '#ffffff' : '#0369a1';
        if (isClosed) renderCite();
      });
    }

    inlineTabs.forEach(function(tab) {
      tab.addEventListener('click', function(e) {
        e.preventDefault();
        inlineTabs.forEach(function(t) {
          t.style.background = '#ffffff';
          t.style.color = '#334155';
          t.style.borderColor = '#cbd5e1';
          t.style.fontWeight = '600';
        });
        tab.style.background = '#0f172a';
        tab.style.color = '#ffffff';
        tab.style.borderColor = '#0f172a';
        tab.style.fontWeight = '700';
        activeCiteFormat = tab.getAttribute('data-format') || 'bibtex';
        renderCite();
      });
    });

    if (inlineCopyBtn) {
      inlineCopyBtn.addEventListener('click', function(e) {
        e.preventDefault();
        navigator.clipboard.writeText(bufferCitations[activeCiteFormat]).then(function() {
          inlineCopyBtn.textContent = '✅ Copied!';
          setTimeout(function() {
            inlineCopyBtn.textContent = '📋 Copy';
          }, 1800);
        }).catch(function(err) {
          console.error(err);
        });
      });
    }

    var params = new URLSearchParams(window.location.search);
    if (params.has('sys') && bufferSystems[params.get('sys')]) sysSelect.value = params.get('sys');
    if (params.has('ph')) inpPH.value = params.get('ph');
    if (params.has('c')) inpConc.value = params.get('c');
    if (params.has('uc')) selConcUnit.value = params.get('uc');
    if (params.has('v')) inpVol.value = params.get('v');
    if (params.has('uv')) selVolUnit.value = params.get('uv');
    if (params.has('t')) inpTemp.value = params.get('t');

    renderCite();
    runBufferEngine();
  </script>

