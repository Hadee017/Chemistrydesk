    function renderDynamicTitrationSvg(pKa, targetPH) {
      var minPH = pKa - 2.5;
      var maxPH = pKa + 2.5;
      var svgWidth = 330;
      
      var clampedPH = Math.min(Math.max(targetPH, minPH), maxPH);
      var xPos = 40 + ((clampedPH - minPH) / (maxPH - minPH)) * svgWidth;
      
      var alpha = 1 / (1 + Math.pow(10, pKa - clampedPH));
      var yPos = 130 - (alpha * 105);
      
      if (workingPointCircle) {
        workingPointCircle.setAttribute('cx', xPos.toFixed(1));
        workingPointCircle.setAttribute('cy', yPos.toFixed(1));
      }
      
      if (workingPointLabel) {
        workingPointLabel.setAttribute('x', xPos.toFixed(1));
        workingPointLabel.setAttribute('y', (yPos - 12).toFixed(1));
        workingPointLabel.textContent = 'pH ' + targetPH.toFixed(2);
      }
    }

