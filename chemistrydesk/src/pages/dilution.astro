      <!-- Live Tube Rack Visualizer -->
      <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem; margin-bottom: 2rem; overflow-x: auto;">
        <h3 style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: #475569; margin: 0 0 1.25rem 0;">
          Interactive Tube Rack Layout &amp; Remaining Volumes
        </h3>
        <div id="tubeRackContainer" style="display: flex; gap: 1rem; min-width: 650px; align-items: stretch;"></div>
      </div>

      <!-- Live Dynamic Semi-Log Plot -->
      <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem;">
        <h3 style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: #475569; margin: 0 0 0.5rem 0;">
          Dynamic Semi-Log Dilution Decay Curve
        </h3>
        <p style="font-size: 0.8rem; color: #64748b; margin-top: 0; margin-bottom: 1rem;">Log₁₀(Concentration) vs. Tube Step Number verifying linear geometric calibration spacing.</p>
        <div style="width: 100%; height: 260px;">
          <svg id="semiLogSvg" viewBox="0 0 600 240" style="width: 100%; height: 100%; overflow: visible; font-family: monospace; font-size: 11px;"></svg>
