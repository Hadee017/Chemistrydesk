  <style>
    .dilution-preset-btn {
      background: #f8fafc;
      border: 1.5px solid #cbd5e1;
      padding: 0.35rem 0.65rem;
      border-radius: 6px;
      cursor: pointer;
      color: #1e293b;
      font-size: 0.75rem;
      font-weight: 700;
      transition: all 0.2s ease;
    }
    .dilution-preset-btn:hover {
      background: #0284c7;
      color: #ffffff;
      border-color: #0284c7;
      transform: translateY(-1px);
    }
    @media print {
      body * {
        visibility: hidden !important;
      }
      #printLabelModal, #printLabelModal * {
        visibility: visible !important;
