    const selModel = document.getElementById('selBreakthroughModel') as HTMLSelectElement;
    const lblCap = document.getElementById('lblCap')!;
    const lblRateConst = document.getElementById('lblRateConst')!;
    const curveTitleText = document.getElementById('curveTitleText')!;

    let currentBreakthroughPoints: Array<{ t: number; ratio: number }> = [];

    function handleModelSwitch() {
      const mode = selModel.value;
      if (mode === 'thomas') {
        lblCap.textContent = 'CAPACITY q₀ (mg/g)';
        lblRateConst.textContent = 'k_Th (mL/(min·mg))';
        curveTitleText.textContent = 'Thomas Dynamic Breakthrough Sigmoid (C_t / C_0 vs. Time)';
      } else {
        lblCap.textContent = 'SATURATION N₀ (mg/L)';
        lblRateConst.textContent = 'k_BA (L/(mg·min))';
        curveTitleText.textContent = 'Bohart-Adams Quasi-Steady Breakthrough Wave';
      }
      runBreakthroughEngine();
    }

    selModel.addEventListener('change', handleModelSwitch);

    function runBreakthroughEngine() {
      const c0 = parseFloat(inpC0.value) || 100;
      const Q = parseFloat(inpQ.value) || 10;
      const m = parseFloat(inpM.value) || 20;
      const Z = parseFloat(inpZ.value) || 15;
      const capVal = parseFloat(inpCapQ0.value) || 85;
      const kVal = parseFloat(inpKRate.value) || 0.0008;
      const modelMode = selModel.value;

      if (c0 <= 0 || Q <= 0 || m <= 0 || capVal <= 0 || kVal <= 0) return;

      let tb = 0;
      let ts = 0;

      if (modelMode === 'thomas') {
        // Thomas: tau = q0 * m / (c0 * Q)
        const tau = (capVal * m) / (c0 * Q);
        tb = Math.max(0, tau - (2.9444 / (kVal * c0)));
        ts = tau + (2.9444 / (kVal * c0));
      } else {
        // Bohart-Adams: ln(Ct/C0) = kBA*C0*t - (kBA*N0*Z / u)
        // cross-sectional area approx from m and Z with packing density ~ 0.65 g/cm3
        const bedArea = (m / 0.65) / Z; // cm2
        const linearU = Q / (bedArea || 1); // cm/min
        // At Ct/C0 = 0.05: ln(0.05) ≈ -2.9957
        tb = Math.max(0, ((kVal * capVal * Z / linearU) - 2.9957) / (kVal * c0));
        // At Ct/C0 = 0.95: ln(0.95) ≈ -0.05129
        ts = Math.max(tb * 1.2, ((kVal * capVal * Z / linearU) - 0.05129) / (kVal * c0));
      }

      const mtz = ts > 0 ? Z * Math.max(0, (ts - tb) / ts) : 0;
      const eta = ts > 0 ? Math.min(100, (tb / ts) * 100) : 0;

      document.getElementById('outTb')!.textContent = `${tb.toFixed(1)} min`;
      document.getElementById('outTs')!.textContent = `${ts.toFixed(1)} min`;
      document.getElementById('outMtz')!.textContent = `${mtz.toFixed(2)} cm`;
      document.getElementById('outEta')!.textContent = `${eta.toFixed(1)} %`;

      // Generate Points for SVG
      const maxT = Math.max(ts * 1.3, 15);
      const pts: Array<{ t: number; ratio: number }> = [];
      const steps = 60;

      for (let i = 0; i <= steps; i++) {
        const t = (maxT / steps) * i;
        let ratio = 0;
        if (modelMode === 'thomas') {
          const arg = (kVal * capVal * m / Q) - (kVal * c0 * t);
          ratio = 1 / (1 + Math.exp(Math.max(-20, Math.min(20, arg))));
        } else {
          const bedArea = (m / 0.65) / Z;
          const linearU = Q / (bedArea || 1);
          const lnRatio = (kVal * c0 * t) - (kVal * capVal * Z / linearU);
          ratio = Math.min(1.0, Math.exp(Math.max(-25, Math.min(0, lnRatio))));
        }
        pts.push({ t, ratio });
      }

      currentBreakthroughPoints = pts;
      renderBreakthroughSvg(pts, maxT, tb, ts);
    }

    function renderBreakthroughSvg(pts: Array<{ t: number; ratio: number }>, maxT: number, tb: number, ts: number) {
      const svg = document.getElementById('breakthroughSvg')!;
      const w = 500, h = 300, padL = 50, padR = 25, padT = 20, padB = 35;
      const width = w - padL - padR;
      const height = h - padT - padB;

      const scX = (t: number) => padL + (t / maxT) * width;
      const scY = (r: number) => padT + height - (r * height);

      let svgHtml = `
        <line x1="${padL}" y1="${padT + height}" x2="${padL + width}" y2="${padT + height}" stroke="#cbd5e1" stroke-width="2"/>
        <line x1="${padL}" y1="${padT}" x2="${padL}" y2="${padT + height}" stroke="#cbd5e1" stroke-width="2"/>
        <text x="${w / 2}" y="${h - 8}" text-anchor="middle" font-size="11" fill="#475569" font-weight="bold">Time (min)</text>
        <text x="14" y="${h / 2}" text-anchor="middle" font-size="11" fill="#475569" font-weight="bold" transform="rotate(-90 14 ${h / 2})">C_t / C_0</text>
      `;

      svgHtml += `<line x1="${padL}" y1="${scY(0.05)}" x2="${padL + width}" y2="${scY(0.05)}" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="3,3" />`;

      for (let i = 0; i <= 4; i++) {
        const tVal = (maxT / 4) * i;
        const rVal = i * 0.25;
        svgHtml += `
          <text x="${scX(tVal)}" y="${h - padB + 14}" text-anchor="middle" font-size="9" fill="#94a3b8">${tVal.toFixed(0)}</text>
          <text x="${padL - 6}" y="${scY(rVal) + 3}" text-anchor="end" font-size="9" fill="#94a3b8">${rVal.toFixed(2)}</text>
        `;
      }

      let d = '';
      pts.forEach((p, idx) => {
        d += (idx === 0 ? `M ${scX(p.t)} ${scY(p.ratio)}` : ` L ${scX(p.t)} ${scY(p.ratio)}`);
      });
      svgHtml += `<path d="${d}" fill="none" stroke="#0d9488" stroke-width="3" />`;

      if (tb > 0 && tb < maxT) {
        svgHtml += `<circle cx="${scX(tb)}" cy="${scY(0.05)}" r="4.5" fill="#ef4444" stroke="#ffffff" stroke-width="1.5" />`;
      }

      svg.innerHTML = svgHtml;
    }

    [inpC0, inpQ, inpM, inpZ, inpCapQ0, inpKRate].forEach(inp => {
      inp.addEventListener('input', runBreakthroughEngine);
    });

    // Check URL parameters for direct import from /isotherm
    function checkUrlImport() {
      const p = new URLSearchParams(window.location.search);
      if (p.has('q0')) inpCapQ0.value = p.get('q0')!;
      if (p.has('kTh')) inpKRate.value = p.get('kTh')!;
      if (p.has('c0')) inpC0.value = p.get('c0')!;
    }

    // ============================================================
    // MODULE 2: BINARY GAS SELECTIVITY SOLVER (IAST)
    // ============================================================
    const inpQmA = document.getElementById('inpQmA') as HTMLInputElement;
    const inpKa = document.getElementById('inpKa') as HTMLInputElement;
    const inpYa = document.getElementById('inpYa') as HTMLInputElement;
    const inpQmB = document.getElementById('inpQmB') as HTMLInputElement;
    const inpKb = document.getElementById('inpKb') as HTMLInputElement;
    const inpTotalP = document.getElementById('inpTotalP') as HTMLInputElement;

    function runSelectivityEngine() {
      const qmA = parseFloat(inpQmA.value) || 4.5;
      const Ka = parseFloat(inpKa.value) || 2.8;
      let yA = parseFloat(inpYa.value) || 0.15;
      yA = Math.max(0.001, Math.min(0.999, yA));
      const yB = 1.0 - yA;
      (document.getElementById('outYb') as HTMLInputElement).value = yB.toFixed(3);

      const qmB = parseFloat(inpQmB.value) || 1.8;
      const Kb = parseFloat(inpKb.value) || 0.12;
      const P = parseFloat(inpTotalP.value) || 1.0;

      const denom = 1 + (Ka * P * yA) + (Kb * P * yB);
      const qA = (qmA * Ka * P * yA) / denom;
      const qB = (qmB * Kb * P * yB) / denom;

      const alpha = (qA / yA) / (qB / yB);

      document.getElementById('outSelectivity')!.textContent = alpha.toFixed(1);
      document.getElementById('outLoadA')!.textContent = qA.toFixed(2);
      document.getElementById('outLoadB')!.textContent = qB.toFixed(2);
    }

    [inpQmA, inpKa, inpYa, inpQmB, inpKb, inpTotalP].forEach(inp => {
      inp.addEventListener('input', runSelectivityEngine);
    });

    // ============================================================
    // MODULE 3: PACKED BED ERGUN & MINIMUM FLUIDIZATION (u_mf)
    // ============================================================
    const inpColDiameter = document.getElementById('inpColDiameter') as HTMLInputElement;
    const inpErgunL = document.getElementById('inpErgunL') as HTMLInputElement;
    const inpErgunFlowLmin = document.getElementById('inpErgunFlowLmin') as HTMLInputElement;
    const inpErgunDp = document.getElementById('inpErgunDp') as HTMLInputElement;
    const inpErgunVoid = document.getElementById('inpErgunVoid') as HTMLInputElement;

    function runErgunEngine() {
      const D_cm = parseFloat(inpColDiameter.value) || 5.0;
      const D_m = D_cm / 100;
      const L_m = parseFloat(inpErgunL.value) || 1.0;
      const Q_Lmin = parseFloat(inpErgunFlowLmin.value) || 18.0;
      const Q_m3s = (Q_Lmin / 1000) / 60; // m3/s

      const dp_mm = parseFloat(inpErgunDp.value) || 2.0;
      const dp_m = dp_mm / 1000;
      const eps = parseFloat(inpErgunVoid.value) || 0.38;

      if (D_m <= 0 || L_m <= 0 || dp_m <= 0 || eps <= 0 || eps >= 1) return;

      // Column cross-sectional area
      const area = Math.PI * Math.pow(D_m / 2, 2);
      const u = Q_m3s / area; // Superficial velocity m/s

      const rho_gas = 1.20; // kg/m3 (Air 20C)
      const mu_gas = 1.81e-5; // Pa·s
      const rho_solid = 1150; // kg/m3 (Typical porous zeolite/carbon pellet)
      const g = 9.80665; // m/s2

      // Ergun: dP/L = 150 * mu * (1-eps)^2 / (dp^2 * eps^3) * u + 1.75 * rho * (1-eps) / (dp * eps^3) * u^2
      const termVisc = (150 * mu_gas * Math.pow(1 - eps, 2) / (Math.pow(dp_m, 2) * Math.pow(eps, 3))) * u;
      const termInert = (1.75 * rho_gas * (1 - eps) / (dp_m * Math.pow(eps, 3))) * Math.pow(u, 2);

      const gradP_Pa = termVisc + termInert; // Pa/m
      const totalP_Pa = gradP_Pa * L_m;
      const totalP_kPa = totalP_Pa / 1000;
      const totalP_bar = totalP_Pa / 100000;
      const totalP_psi = totalP_kPa * 0.145038;

      document.getElementById('outDeltaP')!.textContent = `${totalP_kPa.toFixed(2)} kPa`;
      document.getElementById('outDeltaPSub')!.textContent = `${totalP_bar.toFixed(4)} bar | ${totalP_psi.toFixed(2)} psi`;
      document.getElementById('outSuperficialU')!.textContent = `${u.toFixed(3)} m/s`;
      document.getElementById('outGradP')!.textContent = `Gradient: ${(gradP_Pa / 1000).toFixed(2)} kPa/m`;

      // Minimum Fluidization Velocity via Wen & Yu (1966) Correlation:
      // Re_mf = sqrt(33.7^2 + 0.0408 * Ar) - 33.7
      // Archimedes number Ar = dp^3 * rho_gas * (rho_solid - rho_gas) * g / mu_gas^2
      const Ar = (Math.pow(dp_m, 3) * rho_gas * (rho_solid - rho_gas) * g) / Math.pow(mu_gas, 2);
      const Re_mf = Math.sqrt(Math.pow(33.7, 2) + 0.0408 * Ar) - 33.7;
      const u_mf = (Re_mf * mu_gas) / (dp_m * rho_gas);

      document.getElementById('outUmf')!.textContent = `${u_mf.toFixed(3)} m/s`;

      const fluidStatus = document.getElementById('outFluidStatus')!;
      if (u >= u_mf) {
        fluidStatus.textContent = '⚠️ Risk of Bed Fluidization (u ≥ u_mf)';
        fluidStatus.style.color = '#dc2626';
      } else if (u >= u_mf * 0.75) {
        fluidStatus.textContent = 'Caution: Approaching Fluidization (u > 0.75 u_mf)';
        fluidStatus.style.color = '#d97706';
      } else {
        fluidStatus.textContent = 'Stable Fixed Packed Bed (u < u_mf)';
        fluidStatus.style.color = '#059669';
      }
    }

    [inpColDiameter, inpErgunL, inpErgunFlowLmin, inpErgunDp, inpErgunVoid].forEach(inp => {
      inp.addEventListener('input', runErgunEngine);
    });

    // ============================================================
    // BENCHMARK PRESETS (CO2/N2, CO2/CH4, O2/N2 CMS, DYE/CARBON)
    // ============================================================
    document.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const pKey = (e.currentTarget as HTMLElement).dataset.preset;
        if (pKey === 'co2_zeolite') {
          inpC0.value = '150'; inpQ.value = '25'; inpM.value = '50'; inpZ.value = '30';
          inpCapQ0.value = '110'; inpKRate.value = '0.0012';
          inpQmA.value = '4.8'; inpKa.value = '3.5'; inpYa.value = '0.15';
          inpQmB.value = '1.4'; inpKb.value = '0.08';
          document.getElementById('labelGasA')!.textContent = 'Component A (CO₂, Strongly Adsorbed)';
          document.getElementById('labelGasB')!.textContent = 'Component B (N₂, Carrier Gas)';
        } else if (pKey === 'ch4_mof') {
          inpC0.value = '400'; inpQ.value = '50'; inpM.value = '40'; inpZ.value = '25';
          inpCapQ0.value = '145'; inpKRate.value = '0.0006';
          inpQmA.value = '6.2'; inpKa.value = '1.9'; inpYa.value = '0.40';
          inpQmB.value = '2.1'; inpKb.value = '0.15';
          document.getElementById('labelGasA')!.textContent = 'Component A (CO₂, Acid Gas)';
          document.getElementById('labelGasB')!.textContent = 'Component B (CH₄, Biomethane)';
        } else if (pKey === 'o2_cms') {
          inpC0.value = '250'; inpQ.value = '30'; inpM.value = '60'; inpZ.value = '40';
          inpCapQ0.value = '75'; inpKRate.value = '0.0018';
          inpQmA.value = '2.4'; inpKa.value = '2.1'; inpYa.value = '0.21';
          inpQmB.value = '1.6'; inpKb.value = '0.35';
          document.getElementById('labelGasA')!.textContent = 'Component A (O₂, Kinetic Uptake)';
          document.getElementById('labelGasB')!.textContent = 'Component B (N₂, Retained Stream)';
        } else if (pKey === 'mb_carbon') {
          inpC0.value = '50'; inpQ.value = '5'; inpM.value = '10'; inpZ.value = '10';
          inpCapQ0.value = '220'; inpKRate.value = '0.0025';
        }
        runBreakthroughEngine();
        runSelectivityEngine();
        runErgunEngine();
        showToast('✅ Loaded benchmark profile');
      });
    });

    // ============================================================
    // EXPORTS & CITATIONS
    // ============================================================
    document.getElementById('btnExportCsv')?.addEventListener('click', () => {
      if (!currentBreakthroughPoints.length) return;
      let csv = 'Time_min,Effluent_Ratio_Ct_C0\n';
      currentBreakthroughPoints.forEach(p => { csv += `${p.t.toFixed(2)},${p.ratio.toFixed(4)}\n`; });
      const blob = new Blob([csv], { type: 'text/csv' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `breakthrough_curve_${Date.now()}.csv`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      showToast('✅ Downloaded Breakthrough CSV');
    });

    document.getElementById('btnDownloadCurveSvg')?.addEventListener('click', () => {
      const svg = document.getElementById('breakthroughSvg');
      if (!svg) return;
      const serializer = new XMLSerializer();
      let source = serializer.serializeToString(svg);
      if (!source.includes('xmlns=')) source = source.replace('<svg ', '<svg xmlns="http://www.w3.org/2000/svg" version="1.1" ');
      const blob = new Blob([source], { type: 'image/svg+xml;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `breakthrough_curve_${Date.now()}.svg`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      showToast('✅ Saved Breakthrough Curve SVG');
    });

    document.getElementById('btnCopyShareUrl')?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(window.location.href);
      showToast('✅ Experiment Link Copied!');
    });

    document.getElementById('btnCopyLatex')?.addEventListener('click', async () => {
      const latex = `% Fixed-Bed Breakthrough Formulation (ChemistryDesk)
\\begin{equation}
  \\frac{C_t}{C_0} = \\frac{1}{1 + \\exp\\left( \\frac{k_{\\text{Th}} q_0 m}{Q} - k_{\\text{Th}} C_0 t \\right)}
\\end{equation}`;
      await navigator.clipboard.writeText(latex);
      showToast('✅ Copied LaTeX Formula');
    });

    // CITATION DRAWER
    const citeDrawer = document.getElementById('citeDrawer');
    const toggleCiteBtn = document.getElementById('toggleCiteBtn');
    const inlineCiteOutput = document.getElementById('inlineCiteOutput');
    const inlineTabs = document.querySelectorAll('.inline-cite-tab');
    const inlineCopyBtn = document.getElementById('inlineCopyCiteBtn');

    const doi = "10.5281/zenodo.23059466";
    const currentYear = new Date().getFullYear();

    const columnCitations: Record<string, string> = {
      bibtex: `@software{khan_chemistrydesk_column_${currentYear},
  author         = {Khan, Bilal},
  title          = {ChemistryDesk: Adsorption Column & Gas Separation Studio (Breakthrough, IAST & Ergun)},
  year           = {${currentYear}},
  version        = {v1.0.1},
  publisher      = {Zenodo},
  doi            = {${doi}},
  url            = {https://chemistrycal.com/adsorption-column}
}`,
      acs: `Khan, B. ChemistryDesk: Adsorption Column & Gas Separation Studio, version 1.0.1; Zenodo, ${currentYear}. https://doi.org/${doi}.`,
      rsc: `B. Khan, ChemistryDesk: Adsorption Column & Gas Separation Studio, version 1.0.1, Zenodo, ${currentYear}, DOI: ${doi}.`,
      nature: `Khan, B. ChemistryDesk: Adsorption Column & Gas Separation Studio. Zenodo https://doi.org/${doi} (${currentYear}).`,
      elsevier: `Khan, B., ${currentYear}. ChemistryDesk: Adsorption Column & Gas Separation Studio (Version 1.0.1). Zenodo. https://doi.org/${doi}.`,
      wiley: `B. Khan, ChemistryDesk: Adsorption Column & Gas Separation Studio, version 1.0.1, Zenodo, ${currentYear}, DOI: ${doi}.`
    };

    let currentInlineFormat = 'bibtex';

    function updateInlineCite() {
      if (inlineCiteOutput) inlineCiteOutput.textContent = columnCitations[currentInlineFormat] || columnCitations['bibtex'];
    }

    if (toggleCiteBtn && citeDrawer) {
      toggleCiteBtn.addEventListener('click', (e) => {
        e.preventDefault();
        const isHidden = window.getComputedStyle(citeDrawer).display === 'none';
        citeDrawer.style.display = isHidden ? 'block' : 'none';
        toggleCiteBtn.style.background = isHidden ? '#0d9488' : '#ccfbf1';
        toggleCiteBtn.style.color = isHidden ? '#ffffff' : '#0f766e';
        if (isHidden) updateInlineCite();
      });
    }

    inlineTabs.forEach(tab => {
      tab.addEventListener('click', (e) => {
        e.preventDefault();
        inlineTabs.forEach(t => {
          const el = t as HTMLElement;
          el.style.background = '#ffffff';
          el.style.color = '#334155';
          el.style.borderColor = '#cbd5e1';
          el.style.fontWeight = '600';
        });
        const activeTab = tab as HTMLElement;
        activeTab.style.background = '#0f172a';
        activeTab.style.color = '#ffffff';
        activeTab.style.borderColor = '#0f172a';
        activeTab.style.fontWeight = '700';
        currentInlineFormat = activeTab.getAttribute('data-format') || 'bibtex';
        updateInlineCite();
      });
    });

    if (inlineCopyBtn) {
      inlineCopyBtn.addEventListener('click', async (e) => {
        e.preventDefault();
        await navigator.clipboard.writeText(columnCitations[currentInlineFormat]);
        inlineCopyBtn.textContent = '✅ Copied!';
        setTimeout(() => { inlineCopyBtn.textContent = '📋 Copy'; }, 1800);
      });
    }

    updateInlineCite();
    checkUrlImport();
    runBreakthroughEngine();
    runSelectivityEngine();
    runErgunEngine();
  </script>
</BaseLayout>