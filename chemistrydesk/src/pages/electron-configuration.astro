          svgBox.style.borderRadius = '3px';
          svgBox.style.background = '#f8fafc';
          svgBox.style.border = '1.5px solid #64748b';

          // Spin-up arrow
          if (box.up) {
            const upPath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
            upPath.setAttribute('d', 'M 9 24 L 9 8 M 9 8 L 6 12');
            upPath.setAttribute('stroke', '#0284c7');
            upPath.setAttribute('stroke-width', '2');
            upPath.setAttribute('stroke-linecap', 'round');
            upPath.setAttribute('stroke-linejoin', 'round');
            svgBox.appendChild(upPath);
          }

          // Spin-down arrow
          if (box.down) {
            const downPath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
            downPath.setAttribute('d', 'M 19 8 L 19 24 M 19 24 L 22 20');
            downPath.setAttribute('stroke', '#dc2626');
            downPath.setAttribute('stroke-width', '2');
            downPath.setAttribute('stroke-linecap', 'round');
            downPath.setAttribute('stroke-linejoin', 'round');
            svgBox.appendChild(downPath);
          }

          boxesRow.appendChild(svgBox);
        });

        row.appendChild(boxesRow);

        // Subshell Electrons Count
        const countBadge = document.createElement('div');
        countBadge.style.fontSize = '0.72rem';
        countBadge.style.fontWeight = '700';
        countBadge.style.color = '#64748b';
        countBadge.textContent = `(${sub.electrons} e⁻)`;
        row.appendChild(countBadge);

        orbitalDiagramContainer.appendChild(row);
      });
    }

    // Input Listeners
    inpElementQuery.addEventListener('input', () => {
      // If user typed a charge explicitly into text (e.g. Fe+2), sync slider
      const match = inpElementQuery.value.trim().match(/[+-](\d+)?$/);
      if (match) {
        const sign = match[0][0];
        const num = match[1] ? parseInt(match[1], 10) : 1;
        rngCharge.value = (sign === '+' ? num : -num).toString();
      }
      updateWorkbench();
    });

    rngCharge.addEventListener('input', () => {
      // Remove any explicit charge from text input when slider changes
      inpElementQuery.value = inpElementQuery.value.replace(/([+-]\d*|\d+[+-])$/, '');
      updateWorkbench();
    });

    btnChargeMinus.addEventListener('click', () => {
      let val = parseInt(rngCharge.value, 10);
      if (val > -4) {
        rngCharge.value = (val - 1).toString();
        inpElementQuery.value = inpElementQuery.value.replace(/([+-]\d*|\d+[+-])$/, '');
        updateWorkbench();
      }
    });

    btnChargePlus.addEventListener('click', () => {
      let val = parseInt(rngCharge.value, 10);
      if (val < 7) {
        rngCharge.value = (val + 1).toString();
        inpElementQuery.value = inpElementQuery.value.replace(/([+-]\d*|\d+[+-])$/, '');
        updateWorkbench();
      }
    });

    // Preset Pills
    presetPills.forEach(pill => {
      pill.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        presetPills.forEach(p => p.classList.remove('active'));
        target.classList.add('active');

        const q = target.dataset.query || 'Fe';
        inpElementQuery.value = q;
        rngCharge.value = '0';
        updateWorkbench();
      });
    });

    // Reset Defaults
    document.getElementById('btnResetDefault')?.addEventListener('click', () => {
      inpElementQuery.value = 'Fe';
      rngCharge.value = '0';
      presetPills.forEach(p => p.classList.remove('active'));
      presetPills[0]?.classList.add('active');
      updateWorkbench();
    });

    // Share URL
    document.getElementById('btnShareUrl')?.addEventListener('click', async () => {
      const p = new URLSearchParams();
      p.set('elem', inpElementQuery.value.trim());
      if (rngCharge.value !== '0') p.set('charge', rngCharge.value);
      window.history.replaceState({}, '', `${window.location.pathname}?${p.toString()}`);
      await navigator.clipboard.writeText(window.location.href);
      alert('Electron configuration calculation link copied to clipboard.');
    });

    // Copy Shorthand
    document.getElementById('btnCopyResult')?.addEventListener('click', async () => {
      if (lastResult) {
        await navigator.clipboard.writeText(lastResult.nobleConfigString);
        alert('Noble gas condensed configuration copied to clipboard.');
      }
    });

    // Copy Homework Steps
    document.getElementById('btnCopyHomework')?.addEventListener('click', async () => {
      if (lastResult) {
        const text = `Electron Configuration Analysis for: ${lastResult.name} (${lastResult.symbol})\n` +
          `Atomic Number (Z): ${lastResult.z}\n` +
          `Charge: ${lastResult.charge > 0 ? `+${lastResult.charge}` : lastResult.charge}\n` +
          `Total Electrons: ${lastResult.totalElectrons}\n` +
          `Noble Gas Form: ${lastResult.nobleConfigString}\n` +
          `Full Expanded: ${lastResult.fullConfigString}\n\n` +
          `Derivation Steps:\n` + lastResult.homeworkSteps.map(s => `• ${s}`).join('\n') +
          `\nMagnetic State: ${lastResult.magneticState} (${lastResult.unpairedElectrons} unpaired electrons, ${lastResult.magneticMomentBM} BM)\n` +
          `Slater's Effective Nuclear Charge Z_eff: ${lastResult.effectiveNuclearChargeZeff} (S = ${lastResult.slaterScreeningS})`;
        await navigator.clipboard.writeText(text);
        alert('Step-by-step homework derivation copied to clipboard.');
      }
    });

    // Copy LaTeX
    document.getElementById('btnCopyLatex')?.addEventListener('click', async () => {
      if (lastResult) {
        await navigator.clipboard.writeText(lastResult.latexBlock);
        alert('LaTeX derivation block copied to clipboard.');
      }
    });

    // Copy Orbital Diagram (Unicode Text)
    document.getElementById('btnCopyOrbitalDiagram')?.addEventListener('click', async () => {
      if (lastResult) {
        let diagramText = `Orbital Box Diagram for ${lastResult.symbol} (${lastResult.nobleConfigString}):\n`;
        lastResult.subshells.forEach(s => {
          diagramText += `${s.subshell}: `;
          s.boxes.forEach(b => {
            if (b.up && b.down) diagramText += '[⥮] ';
            else if (b.up) diagramText += '[↿ ] ';
            else if (b.down) diagramText += '[ ⇂] ';
            else diagramText += '[  ] ';
          });
          diagramText += `\n`;
        });
        await navigator.clipboard.writeText(diagramText);
        alert('Unicode orbital box diagram copied to clipboard.');
      }
    });

    // CSV Exporter
    document.getElementById('btnExportCsv')?.addEventListener('click', () => {
      if (!lastResult) return;
      let csv = 'Property,Value\n';
      csv += `"Element","${lastResult.name} (${lastResult.symbol})"\n`;
      csv += `"AtomicNumber",${lastResult.z}\n`;
      csv += `"Charge",${lastResult.charge}\n`;
      csv += `"TotalElectrons",${lastResult.totalElectrons}\n`;
      csv += `"NobleGasForm","${lastResult.nobleConfigString}"\n`;
      csv += `"FullExpandedForm","${lastResult.fullConfigString}"\n`;
      csv += `"MagneticState","${lastResult.magneticState}"\n`;
      csv += `"UnpairedElectrons",${lastResult.unpairedElectrons}\n`;
      csv += `"SpinOnlyMomentBM",${lastResult.magneticMomentBM}\n`;
      csv += `"SlaterScreeningConstantS",${lastResult.slaterScreeningS}\n`;
      csv += `"SlaterZeff",${lastResult.effectiveNuclearChargeZeff}\n`;
      csv += `"FirstIE_kJ_mol",${lastResult.ionizationEnergies.ie1 || 'N/A'}\n`;
      csv += `"ElectronAffinity_kJ_mol",${lastResult.electronAffinity || 'N/A'}\n`;
      csv += `"Electronegativity",${lastResult.electronegativity || 'N/A'}\n`;

      const blob = new Blob([csv], { type: 'text/csv' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `${lastResult.symbol}_electron_config.csv`;
      a.click();
      URL.revokeObjectURL(url);
    });

    // Citation Drawer
    const citeDrawer = document.getElementById('citeDrawer')!;
    const toggleCiteBtn = document.getElementById('toggleCiteBtn')!;
    const inlineCiteOutput = document.getElementById('inlineCiteOutput')!;
    const inlineTabs = document.querySelectorAll('.inline-cite-tab');
    const inlineCopyBtn = document.getElementById('inlineCopyCiteBtn')!;
    const doi = "10.5281/zenodo.23059466";
    const year = new Date().getFullYear();

    const citations: Record<string, string> = {
      bibtex: `@software{khan_chemistrydesk_electron_config_${year},
  author        = {Khan, Bilal},
  title         = {ChemistryDesk: Electron Configuration & Orbital Physics Studio},
  year          = {${year}},
  version       = {v1.0.1},
  publisher     = {Zenodo},
  doi           = {${doi}},
  url           = {https://chemistrycal.com/electron-configuration}
}`,
      acs: `Khan, B. ChemistryDesk: Electron Configuration & Orbital Physics Studio, version 1.0.1; Zenodo, ${year}. https://doi.org/${doi}.`,
      rsc: `B. Khan, ChemistryDesk: Electron Configuration & Orbital Physics Studio, version 1.0.1, Zenodo, ${year}, DOI: ${doi}.`,
      nature: `Khan, B. ChemistryDesk: Electron Configuration & Orbital Physics Studio. Zenodo https://doi.org/${doi} (${year}).`
    };

    let activeFormat = 'bibtex';
    function updateCite() {
      inlineCiteOutput.textContent = citations[activeFormat] || citations['bibtex'];
    }

    toggleCiteBtn.addEventListener('click', (e) => {
      e.preventDefault();
      const isHidden = citeDrawer.style.display === 'none';
      citeDrawer.style.display = isHidden ? 'block' : 'none';
      if (isHidden) updateCite();
    });

    inlineTabs.forEach(tab => {
      tab.addEventListener('click', (e) => {
        e.preventDefault();
        inlineTabs.forEach(t => {
          (t as HTMLElement).style.background = '#fff';
          (t as HTMLElement).style.color = '#334155';
          (t as HTMLElement).style.borderColor = '#cbd5e1';
          (t as HTMLElement).style.fontWeight = '600';
        });
        const el = tab as HTMLElement;
        el.style.background = '#0f172a';
        el.style.color = '#fff';
        el.style.borderColor = '#0f172a';
        el.style.fontWeight = '700';
        activeFormat = el.dataset.format || 'bibtex';
        updateCite();
      });
    });

    inlineCopyBtn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(citations[activeFormat]);
      alert('Academic citation copied.');
    });

    // Check URL State on Load
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('elem')) {
      inpElementQuery.value = urlParams.get('elem')!;
    }
    if (urlParams.has('charge')) {
      rngCharge.value = urlParams.get('charge')!;
    }

    updateCite();
    updateWorkbench();
  </script>
</BaseLayout>