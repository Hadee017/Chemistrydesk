      }

      if (toggleCiteBtn && citeDrawer) {
        toggleCiteBtn.addEventListener('click', function(e) {
          e.preventDefault();
          var isHidden = window.getComputedStyle(citeDrawer).display === 'none';
          citeDrawer.style.display = isHidden ? 'block' : 'none';
          if (isHidden) updateCite();
        });
      }

      inlineTabs.forEach(function(tab) {
        tab.addEventListener('click', function(e) {
          e.preventDefault();
          inlineTabs.forEach(function(t) {
            t.style.background = '#ffffff'; t.style.color = '#334155'; t.style.borderColor = '#cbd5e1'; t.style.fontWeight = '600';
          });
          tab.style.background = '#0f172a'; tab.style.color = '#ffffff'; tab.style.borderColor = '#0f172a'; tab.style.fontWeight = '700';
          currentFormat = tab.getAttribute('data-format') || 'bibtex';
          updateCite();
        });
      });

      if (inlineCopyBtn) {
        inlineCopyBtn.addEventListener('click', function(e) {
          e.preventDefault();
          navigator.clipboard.writeText(citations[currentFormat]).then(function() {
            inlineCopyBtn.textContent = '✅ Copied!';
            setTimeout(function() { inlineCopyBtn.textContent = '📋 Copy Citation'; }, 1800);
          });
        });
      }
      updateCite();

      // Modal Close Logic
      var closeModalBtn = document.getElementById('closeModalBtn');
      if (closeModalBtn) closeModalBtn.addEventListener('click', function() { document.getElementById('elementModal').style.display = 'none'; });
      window.addEventListener('click', function(e) {
        if (e.target === document.getElementById('elementModal')) document.getElementById('elementModal').style.display = 'none';
      });

      // 6. Real-Time Search & Charge Filtering
      var elementSearch = document.getElementById('elementSearch');
      var chargeFilterBtns = document.querySelectorAll('.charge-filter-btn');
      var activeCharge = 'all';

      function filterElements() {
        var query = elementSearch ? elementSearch.value.toLowerCase().trim() : '';
        var tiles = document.querySelectorAll('.element-tile');
        tiles.forEach(function(tile) {
          var name = tile.dataset.name;
          var symbol = tile.dataset.symbol;
          var charges = [];
          try { charges = JSON.parse(tile.dataset.charges || '[]'); } catch { charges = []; }
          
          var matchesSearch = !query || name.includes(query) || symbol.includes(query);
          var matchesCharge = activeCharge === 'all' || charges.includes(activeCharge);

          if (matchesSearch && matchesCharge) {
            tile.style.opacity = '1';
            tile.style.pointerEvents = 'auto';
          } else {
            tile.style.opacity = '0.25';
            tile.style.pointerEvents = 'none';
          }
        });
      }

      if (elementSearch) elementSearch.addEventListener('input', filterElements);

      chargeFilterBtns.forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          chargeFilterBtns.forEach(function(b) {
            b.style.background = '#f8fafc'; b.style.color = '#1e293b'; b.style.borderColor = '#cbd5e1';
          });
          e.currentTarget.style.background = '#0f172a';
          e.currentTarget.style.color = '#ffffff';
          e.currentTarget.style.borderColor = '#0f172a';
          activeCharge = e.currentTarget.dataset.charge;
          filterElements();
        });
      });

      var polySearch = document.getElementById('polySearch');
      if (polySearch) {
        polySearch.addEventListener('input', function() {
          var q = polySearch.value.toLowerCase().trim();
          var polyItems = document.querySelectorAll('.poly-item');
          polyItems.forEach(function(item) {
            var name = item.dataset.name;
            var formula = item.dataset.formula;
            if (!q || name.includes(q) || formula.includes(q)) {
              item.style.display = 'flex';
            } else {
              item.style.display = 'none';
            }
          });
        });
      }
    });
  </script>

