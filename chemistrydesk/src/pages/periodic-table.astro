        { name: "Carbonate", formula: "CO32-", charge: "-2", description: "Forms extensive mineral deposits like limestone." },
        { name: "Bicarbonate", formula: "HCO3-", charge: "-1", description: "Crucial physiological buffer component." },
        { name: "Phosphate", formula: "PO43-", charge: "-3", description: "Trivalent anion foundational in nucleic acids and ATP." },
        { name: "Acetate", formula: "CH3COO-", charge: "-1", description: "Simple carboxylate anion used in buffer solutions." },
        { name: "Permanganate", formula: "MnO4-", charge: "-1", description: "Intense purple oxidizing agent used in redox titrations." }
      ];

      // Helper routing for 18-column grid layout (Prevents f-block lanthanide/actinide overlap)
      function getGridColumn(el) {
        if (el.number >= 57 && el.number <= 71) return el.number - 57 + 3;
        if (el.number >= 89 && el.number <= 103) return el.number - 89 + 3;
        return el.group || 1;
      }

      function getGridRow(el) {
        if (el.number >= 57 && el.number <= 71) return 9;
        if (el.number >= 89 && el.number <= 103) return 10;
        return el.period;
      }

      // 2. Render Periodic Grid Tiles
      var gridContainer = document.getElementById('periodicGrid');
      var isSafetyMode = false;

      function renderGrid() {
        if (!gridContainer) return;
        gridContainer.innerHTML = '';
        ELEMENTS_DATA.forEach(function(el) {
          var tile = document.createElement('div');
          tile.className = 'element-tile';
          if (isSafetyMode) {
            tile.classList.add(el.safetyTier || 'hazard-low');
          }

          tile.dataset.number = el.number;
          tile.dataset.symbol = el.symbol.toLowerCase();
          tile.dataset.name = el.name.toLowerCase();
          tile.dataset.charges = JSON.stringify(el.charges);
          tile.dataset.weight = el.atomicWeight;
          tile.dataset.config = el.config;
          tile.dataset.density = el.density || "N/A";
          tile.dataset.melting = (el.meltingPoint && el.meltingPoint !== "null") ? el.meltingPoint : "N/A";
          tile.dataset.boiling = (el.boilingPoint && el.boilingPoint !== "null") ? el.boilingPoint : "N/A";
          tile.dataset.scarcity = el.scarcity || "Low Risk / Abundant";
          tile.dataset.safety = el.safety || "Standard Lab Safe";
          tile.dataset.safetyTier = el.safetyTier || "hazard-low";
          tile.dataset.electronegativity = el.electronegativity !== null ? el.electronegativity : 'N/A';
          tile.dataset.ionization1 = el.ionization1 !== null ? el.ionization1 + " kJ/mol" : 'N/A';
          tile.dataset.category = el.category;
          tile.dataset.description = el.description;

          tile.style.cssText = 'grid-column: ' + getGridColumn(el) + '; grid-row: ' + getGridRow(el) + '; border-radius: 6px; padding: 6px 4px; cursor: pointer; text-align: center; transition: all 0.2s;';
          if (!isSafetyMode) {
            tile.style.background = '#f8fafc';
            tile.style.border = '1.5px solid #cbd5e1';
          }

          var oxidationText = el.commonOxidation ? el.commonOxidation.split(',')[0] : '0';
          tile.innerHTML = '<div style="display: flex; justify-content: space-between; font-size: 9px; font-family: monospace; color: #64748b; font-weight: 700;"><span>' + el.number + '</span><span style="color: #0284c7;">' + oxidationText + '</span></div>' +
                           '<div style="font-size: 1rem; font-weight: 900; color: #0f172a; margin: 2px 0 1px 0;">' + el.symbol + '</div>' +
                           '<div style="font-size: 8px; color: #475569; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">' + el.name + '</div>';

          gridContainer.appendChild(tile);
        });
      }
      renderGrid();

      // Render Polyatomic Ions Reference Cards
      var polyGrid = document.getElementById('polyGrid');
      if (polyGrid && POLY_DATA) {
        POLY_DATA.forEach(function(ion) {
          var ionCard = document.createElement('div');
          ionCard.className = 'poly-item';
          ionCard.dataset.name = ion.name.toLowerCase();
          ionCard.dataset.formula = ion.formula.toLowerCase();
          ionCard.style.cssText = 'background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 8px; padding: 0.75rem 1rem; display: flex; justify-content: space-between; align-items: center;';
          ionCard.innerHTML = '<div><span style="font-size: 0.72rem; font-weight: 800; color: #0284c7; display: block; text-transform: uppercase;">' + ion.name + '</span><strong style="font-size: 0.95rem; font-family: monospace; color: #0f172a;">' + ion.formula + '</strong></div>' +
                              '<span style="background: #e0f2fe; color: #0369a1; padding: 2px 8px; border-radius: 6px; font-size: 0.78rem; font-weight: 800; font-family: monospace;">' + ion.charge + '</span>';
          polyGrid.appendChild(ionCard);
        });
      }

      // 3. NULL-SAFE DYNAMIC TREND CHART VISUALIZER
      var trendBars = document.getElementById('trendChartBars');
      function renderTrendChart(prop) {
        if (!trendBars) return;
        trendBars.innerHTML = '';
        
        var validElements = ELEMENTS_DATA.map(function(el) {
          var rawVal = el[prop];
          if (prop === 'atomicWeightVal') rawVal = el.atomicWeight;
          var numVal = (rawVal !== null && rawVal !== undefined && !isNaN(parseFloat(rawVal))) ? parseFloat(rawVal) : null;
          return { symbol: el.symbol, name: el.name, val: numVal };
        });

        var numericValues = validElements.map(function(e) { return e.val; }).filter(function(v) { return v !== null; });
        var maxVal = numericValues.length ? Math.max.apply(Math, numericValues) : 1;
        var minVal = numericValues.length ? Math.min.apply(Math, numericValues) : 0;
        if (maxVal === minVal) maxVal = minVal + 1;

        validElements.forEach(function(el) {
          var barCol = document.createElement('div');
          barCol.style.cssText = 'display: flex; flex-direction: column; align-items: center; flex: 1; height: 100%; justify-content: flex-end; cursor: pointer; min-width: 14px;';
          
          if (el.val !== null) {
            var range = maxVal - (minVal < 0 ? minVal : 0);
            var barPct = Math.max(((el.val - (minVal < 0 ? minVal : 0)) / range) * 100, 6);
            barCol.innerHTML = 
              '<span style="font-size: 8px; font-family: monospace; color: #475569; margin-bottom: 2px;">' + el.symbol + '</span>' +
              '<div title="' + el.name + ': ' + el.val + '" style="width: 80%; height: ' + barPct + '%; background: linear-gradient(180deg, #0284c7 0%, #0369a1 100%); border-radius: 3px 3px 0 0; transition: height 0.3s ease;"></div>';
          } else {
            barCol.innerHTML = 
              '<span style="font-size: 8px; font-family: monospace; color: #94a3b8; margin-bottom: 2px;">' + el.symbol + '</span>' +
              '<div title="' + el.name + ': Data N/A" style="width: 80%; height: 2%; background: #cbd5e1; border-radius: 2px;"></div>';
          }
          trendBars.appendChild(barCol);
        });
      }
      renderTrendChart('electronegativity');

      var trendSelect = document.getElementById('trendPropertySelect');
      if (trendSelect) {
        trendSelect.addEventListener('change', function(e) {
          renderTrendChart(e.target.value);
        });
      }

      // 4. View Mode Switching
      var gridBtn = document.getElementById('modeGridBtn');
      var trendsBtn = document.getElementById('modeTrendsBtn');
      var safetyBtn = document.getElementById('modeSafetyBtn');
      var gridView = document.getElementById('periodicGridView');
      var trendsView = document.getElementById('periodicTrendsView');
      var gridControls = document.getElementById('gridControlsBar');
      var safetyLegend = document.getElementById('safetyLegendBar');

      if (gridBtn && trendsBtn && safetyBtn) {
        gridBtn.addEventListener('click', function() {
          isSafetyMode = false; renderGrid();
          gridView.style.display = 'block'; trendsView.style.display = 'none'; gridControls.style.display = 'flex'; safetyLegend.style.display = 'none';
          gridBtn.style.background = '#0f172a'; gridBtn.style.color = '#fff'; trendsBtn.style.background = '#f1f5f9'; trendsBtn.style.color = '#334155'; safetyBtn.style.background = '#f1f5f9'; safetyBtn.style.color = '#334155';
        });
        trendsBtn.addEventListener('click', function() {
          gridView.style.display = 'none'; trendsView.style.display = 'block'; gridControls.style.display = 'none'; safetyLegend.style.display = 'none';
          trendsBtn.style.background = '#0f172a'; trendsBtn.style.color = '#fff'; gridBtn.style.background = '#f1f5f9'; gridBtn.style.color = '#334155'; safetyBtn.style.background = '#f1f5f9'; safetyBtn.style.color = '#334155';
        });
        safetyBtn.addEventListener('click', function() {
          isSafetyMode = true; renderGrid();
          gridView.style.display = 'block'; trendsView.style.display = 'none'; gridControls.style.display = 'none'; safetyLegend.style.display = 'flex';
          safetyBtn.style.background = '#0f172a'; safetyBtn.style.color = '#fff'; gridBtn.style.background = '#f1f5f9'; gridBtn.style.color = '#334155'; trendsBtn.style.background = '#f1f5f9'; trendsBtn.style.color = '#334155';
        });
      }

      // 5. Toast Notifications & Reaction Workbench Delegation
      var workbenchArray = [];
      var workbenchContainer = document.getElementById('workbenchItemsContainer');

      function showToast(msg) {
        var toast = document.createElement('div');
        toast.style.cssText = 'position: fixed; bottom: 80px; right: 20px; background: #0f172a; color: #ffffff; padding: 12px 20px; border-radius: 8px; font-weight: 700; font-size: 0.85rem; border: 1.5px solid #0284c7; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.3); z-index: 100; transition: all 0.3s ease;';
        toast.textContent = msg;
        document.body.appendChild(toast);
        setTimeout(function() { toast.style.opacity = '0'; setTimeout(function() { toast.remove(); }, 300); }, 3000);
      }

      function updateWorkbenchUI() {
        if (!workbenchContainer) return;
        if (workbenchArray.length === 0) {
          workbenchContainer.innerHTML = '<span style="color: #94a3b8; font-size: 0.82rem; font-style: italic;">No elements selected. Click elements on the table to add them here.</span>';
          return;
        }
        workbenchContainer.innerHTML = '';
        workbenchArray.forEach(function(sym, idx) {
          var chip = document.createElement('span');
          chip.style.cssText = 'background: #38bdf8; color: #0f172a; padding: 2px 8px; border-radius: 6px; font-weight: 800; font-size: 0.8rem; font-family: monospace; display: inline-flex; align-items: center; gap: 4px;';
          chip.innerHTML = sym + ' <button type="button" data-wb-index="' + idx + '" style="background:none;border:none;color:#0f172a;cursor:pointer;font-weight:900;">×</button>';
          workbenchContainer.appendChild(chip);
        });
      }

      // Universal Click Handler (Event Delegation)
      document.addEventListener('click', function(e) {
        var tile = e.target.closest('.element-tile');
        if (tile) {
          var symbol = tile.querySelector('div:nth-child(2)').textContent;
          document.getElementById('modalSymbol').textContent = symbol;
          document.getElementById('modalNumber').textContent = 'No. ' + tile.dataset.number;
          document.getElementById('modalName').textContent = tile.dataset.name.charAt(0).toUpperCase() + tile.dataset.name.slice(1);
          document.getElementById('modalCategory').textContent = tile.dataset.category;
          document.getElementById('modalWeight').textContent = tile.dataset.weight;
          
          var chargesArr = [];
          try { chargesArr = JSON.parse(tile.dataset.charges || '[]'); } catch { chargesArr = []; }
          document.getElementById('modalCharges').textContent = chargesArr.join(', ') || '0';
          
          document.getElementById('modalDensity').textContent = tile.dataset.density;
          document.getElementById('modalMelting').textContent = tile.dataset.melting;
          document.getElementById('modalBoiling').textContent = tile.dataset.boiling || 'N/A';
          document.getElementById('modalElectronegativity').textContent = tile.dataset.electronegativity;
          document.getElementById('modalIonization1').textContent = tile.dataset.ionization1;
          document.getElementById('modalScarcity').textContent = tile.dataset.scarcity;
          document.getElementById('modalSafety').textContent = tile.dataset.safety;
          document.getElementById('modalConfig').textContent = tile.dataset.config;
          document.getElementById('modalDesc').textContent = tile.dataset.description;
          
          document.getElementById('elementModal').style.display = 'flex';
        }

        if (e.target && e.target.id === 'modalWorkbenchBtn') {
          var activeSym = document.getElementById('modalSymbol').textContent;
          if (activeSym && activeSym !== '--') {
            if (!workbenchArray.includes(activeSym)) {
              workbenchArray.push(activeSym);
              updateWorkbenchUI();
              showToast('Added ' + activeSym + ' to Reaction Workbench!');
            } else {
              showToast(activeSym + ' is already in the workbench.');
            }
            document.getElementById('elementModal').style.display = 'none';
          }
        }

        if (e.target && e.target.dataset && e.target.dataset.wbIndex !== undefined) {
          var removeIdx = parseInt(e.target.dataset.wbIndex);
          workbenchArray.splice(removeIdx, 1);
          updateWorkbenchUI();
        }
      });

      var clearWorkbenchBtn = document.getElementById('clearWorkbenchBtn');
      if (clearWorkbenchBtn) clearWorkbenchBtn.addEventListener('click', function() { workbenchArray = []; updateWorkbenchUI(); });

      // Reaction Engine & Simulation Handler
      var simulateBtn = document.getElementById('simulateReactionBtn');
      if (simulateBtn) {
        simulateBtn.addEventListener('click', function() {
          if (workbenchArray.length < 2) {
            showToast('Please select at least 2 elements in the Reaction Workbench.');
            return;
          }

          var sortedKey = workbenchArray.slice().sort().join('+');

          var REACTION_DB = {
            "H+La": {
              product: "Lanthanum(III) Hydride",
              equation: "2La + 3H₂ → 2LaH₃",
              ratio: "2 mol La : 3 mol H₂",
              note: "Direct combination under elevated heat and pressure forming a non-stoichiometric metallic hydride matrix."
            },
            "H+O": {
              product: "Water / Hydrogen Peroxide Precursor",
              equation: "2H₂ + O₂ → 2H₂O",
              ratio: "2 mol H₂ : 1 mol O₂",
              note: "Highly exothermic gaseous synthesis combination."
            },
            "Cl+Na": {
              product: "Sodium Chloride",
              equation: "2Na + Cl₂ → 2NaCl",
              ratio: "2 mol Na : 1 mol Cl₂",
              note: "Vigorous redox combination forming an ionic crystal lattice."
            }
          };

          var rxn = REACTION_DB[sortedKey];

          if (rxn) {
            document.getElementById('modalSymbol').textContent = "Rxn";
            document.getElementById('modalNumber').textContent = "Synthesized";
            document.getElementById('modalName').textContent = rxn.product;
            document.getElementById('modalCategory').textContent = "Chemical Reaction";
            document.getElementById('modalWeight').textContent = "Balanced";
            document.getElementById('modalCharges').textContent = rxn.ratio;
            
            document.getElementById('modalDesc').innerHTML = 
              '<strong>Balanced Equation:</strong> ' + rxn.equation + '<br/><br/>' +
              '<strong>Stoichiometry Ratio:</strong> ' + rxn.ratio + '<br/><br/>' +
              '<strong>Synthesis Note:</strong> ' + rxn.note;

            document.getElementById('elementModal').style.display = 'flex';
          } else {
            document.getElementById('modalSymbol').textContent = "Rxn";
            document.getElementById('modalNumber').textContent = "Calculated";
            document.getElementById('modalName').textContent = workbenchArray.join(' - ') + " Combination";
            document.getElementById('modalCategory').textContent = "Multi-Element System";
            document.getElementById('modalWeight').textContent = "N/A";
            document.getElementById('modalCharges').textContent = workbenchArray.join(' : ');
            
            document.getElementById('modalDesc').innerHTML = 
              '<strong>Selected Elements:</strong> ' + workbenchArray.join(', ') + '<br/><br/>' +
              '<strong>Stoichiometric Analysis:</strong> Binary phase stoichiometric ratio calculated for system.';

            document.getElementById('elementModal').style.display = 'flex';
          }
        });
      }

      // Academic Citation Drawer Logic
      var citeDrawer = document.getElementById('citeDrawer');
      var toggleCiteBtn = document.getElementById('toggleCiteBtn');
      var inlineCiteOutput = document.getElementById('inlineCiteOutput');
      var inlineTabs = document.querySelectorAll('.inline-cite-tab');
      var inlineCopyBtn = document.getElementById('inlineCopyCiteBtn');

      var doi = "10.5281/zenodo.23059466";
      var currentYear = new Date().getFullYear();

      var citations = {
        bibtex: '@software{khan_chemistrycal_periodic_' + currentYear + ',\n  author        = {Khan, Bilal},\n  title         = {Chemistrycal: Interactive Periodic Table with Charges & Oxidation States},\n  year          = {' + currentYear + '},\n  version       = {v1.0.1},\n  publisher     = {Zenodo},\n  doi           = {' + doi + '},\n  url           = {https://chemistrycal.com/periodic-table}\n}',
        acs: 'Khan, B. Chemistrycal: Interactive Periodic Table with Charges & Oxidation States, version 1.0.1; Zenodo, ' + currentYear + '. https://doi.org/' + doi + '.',
        rsc: 'B. Khan, Chemistrycal: Interactive Periodic Table with Charges & Oxidation States, version 1.0.1, Zenodo, ' + currentYear + ', DOI: ' + doi + '.',
        nature: 'Khan, B. Chemistrycal: Interactive Periodic Table with Charges & Oxidation States. Zenodo https://doi.org/' + doi + ' (' + currentYear + ').',
        elsevier: 'Khan, B., ' + currentYear + '. Chemistrycal: Interactive Periodic Table with Charges & Oxidation States (Version 1.0.1). Zenodo. https://doi.org/' + doi + '.',
        wiley: 'B. Khan, Chemistrycal: Interactive Periodic Table with Charges & Oxidation States, version 1.0.1, Zenodo, ' + currentYear + ', DOI: ' + doi + '.'
      };

      var currentFormat = 'bibtex';
      function updateCite() {
        if (inlineCiteOutput) inlineCiteOutput.textContent = citations[currentFormat];
      }

      if (toggleCiteBtn && citeDrawer) {
        toggleCiteBtn.addEventListener('click', function(e) {
          e.preventDefault();
          var isHidden = window.getComputedStyle(citeDrawer).display === 'none';
          citeDrawer.style.display = isHidden ? 'block' : 'none';
          if (isHidden) updateCite();
        });
      }

      inlineTabs.forEach(function(tab) {
        tab.addEventListener('click', function(e) {
          e.preventDefault();
          inlineTabs.forEach(function(t) {
            t.style.background = '#ffffff'; t.style.color = '#334155'; t.style.borderColor = '#cbd5e1'; t.style.fontWeight = '600';
          });
          tab.style.background = '#0f172a'; tab.style.color = '#ffffff'; tab.style.borderColor = '#0f172a'; tab.style.fontWeight = '700';
          currentFormat = tab.getAttribute('data-format') || 'bibtex';
          updateCite();
        });
      });

      if (inlineCopyBtn) {
        inlineCopyBtn.addEventListener('click', function(e) {
          e.preventDefault();
          navigator.clipboard.writeText(citations[currentFormat]).then(function() {
            inlineCopyBtn.textContent = '✅ Copied!';
            setTimeout(function() { inlineCopyBtn.textContent = '📋 Copy Citation'; }, 1800);
          });
        });
      }
      updateCite();

      // Modal Close Logic
      var closeModalBtn = document.getElementById('closeModalBtn');
      if (closeModalBtn) closeModalBtn.addEventListener('click', function() { document.getElementById('elementModal').style.display = 'none'; });
      window.addEventListener('click', function(e) {
        if (e.target === document.getElementById('elementModal')) document.getElementById('elementModal').style.display = 'none';
      });

      // 6. Real-Time Search & Charge Filtering
      var elementSearch = document.getElementById('elementSearch');
      var chargeFilterBtns = document.querySelectorAll('.charge-filter-btn');
      var activeCharge = 'all';

      function filterElements() {
        var query = elementSearch ? elementSearch.value.toLowerCase().trim() : '';
        var tiles = document.querySelectorAll('.element-tile');
        tiles.forEach(function(tile) {
          var name = tile.dataset.name;
          var symbol = tile.dataset.symbol;
          var charges = [];
          try { charges = JSON.parse(tile.dataset.charges || '[]'); } catch { charges = []; }
          
          var matchesSearch = !query || name.includes(query) || symbol.includes(query);
          var matchesCharge = activeCharge === 'all' || charges.includes(activeCharge);

          if (matchesSearch && matchesCharge) {
            tile.style.opacity = '1';
            tile.style.pointerEvents = 'auto';
          } else {
            tile.style.opacity = '0.25';
            tile.style.pointerEvents = 'none';
          }
        });
      }

      if (elementSearch) elementSearch.addEventListener('input', filterElements);

      chargeFilterBtns.forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          chargeFilterBtns.forEach(function(b) {
            b.style.background = '#f8fafc'; b.style.color = '#1e293b'; b.style.borderColor = '#cbd5e1';
          });
          e.currentTarget.style.background = '#0f172a';
          e.currentTarget.style.color = '#ffffff';
          e.currentTarget.style.borderColor = '#0f172a';
          activeCharge = e.currentTarget.dataset.charge;
          filterElements();
        });
      });

      var polySearch = document.getElementById('polySearch');
      if (polySearch) {
        polySearch.addEventListener('input', function() {
          var q = polySearch.value.toLowerCase().trim();
          var polyItems = document.querySelectorAll('.poly-item');
          polyItems.forEach(function(item) {
            var name = item.dataset.name;
            var formula = item.dataset.formula;
            if (!q || name.includes(q) || formula.includes(q)) {
              item.style.display = 'flex';
            } else {
              item.style.display = 'none';
            }
          });
        });
      }
    });
  </script>

