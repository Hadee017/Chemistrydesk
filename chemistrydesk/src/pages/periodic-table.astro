      function showToast(msg) {
        var toast = document.createElement('div');
        toast.style.cssText = 'position: fixed; bottom: 80px; right: 20px; background: #0f172a; color: #ffffff; padding: 12px 20px; border-radius: 8px; font-weight: 700; font-size: 0.85rem; border: 1.5px solid #0284c7; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.3); z-index: 100; transition: all 0.3s ease;';
        toast.textContent = msg;
        document.body.appendChild(toast);
        setTimeout(function() { toast.style.opacity = '0'; setTimeout(function() { toast.remove(); }, 300); }, 3000);
      }

      function updateWorkbenchUI() {
        if (!workbenchContainer) return;
        if (workbenchArray.length === 0) {
          workbenchContainer.innerHTML = '<span style="color: #94a3b8; font-size: 0.82rem; font-style: italic;">No elements selected. Click elements on the table to add them here.</span>';
          return;
        }
        workbenchContainer.innerHTML = '';
        workbenchArray.forEach(function(sym, idx) {
          var chip = document.createElement('span');
          chip.style.cssText = 'background: #38bdf8; color: #0f172a; padding: 2px 8px; border-radius: 6px; font-weight: 800; font-size: 0.8rem; font-family: monospace; display: inline-flex; align-items: center; gap: 4px;';
          chip.innerHTML = sym + ' <button type="button" data-wb-index="' + idx + '" style="background:none;border:none;color:#0f172a;cursor:pointer;font-weight:900;">×</button>';
          workbenchContainer.appendChild(chip);
        });
      }

      // Universal Click Handler (Event Delegation)
      document.addEventListener('click', function(e) {
        var tile = e.target.closest('.element-tile');
        if (tile) {
          var symbol = tile.querySelector('div:nth-child(2)').textContent;
          document.getElementById('modalSymbol').textContent = symbol;
          document.getElementById('modalNumber').textContent = 'No. ' + tile.dataset.number;
          document.getElementById('modalName').textContent = tile.dataset.name.charAt(0).toUpperCase() + tile.dataset.name.slice(1);
          document.getElementById('modalCategory').textContent = tile.dataset.category;
          document.getElementById('modalWeight').textContent = tile.dataset.weight;
          
          var chargesArr = [];
          try { chargesArr = JSON.parse(tile.dataset.charges || '[]'); } catch { chargesArr = []; }
          document.getElementById('modalCharges').textContent = chargesArr.join(', ') || '0';
          
          document.getElementById('modalDensity').textContent = tile.dataset.density;
          document.getElementById('modalMelting').textContent = tile.dataset.melting;
          document.getElementById('modalBoiling').textContent = tile.dataset.boiling || 'N/A';
          document.getElementById('modalElectronegativity').textContent = tile.dataset.electronegativity;
          document.getElementById('modalIonization1').textContent = tile.dataset.ionization1;
          document.getElementById('modalScarcity').textContent = tile.dataset.scarcity;
          document.getElementById('modalSafety').textContent = tile.dataset.safety;
          document.getElementById('modalConfig').textContent = tile.dataset.config;
          document.getElementById('modalDesc').textContent = tile.dataset.description;
          
          document.getElementById('elementModal').style.display = 'flex';
        }

        if (e.target && e.target.id === 'modalWorkbenchBtn') {
          var activeSym = document.getElementById('modalSymbol').textContent;
          if (activeSym && activeSym !== '--') {
            if (!workbenchArray.includes(activeSym)) {
              workbenchArray.push(activeSym);
              updateWorkbenchUI();
              showToast('Added ' + activeSym + ' to Reaction Workbench!');
            } else {
              showToast(activeSym + ' is already in the workbench.');
            }
            document.getElementById('elementModal').style.display = 'none';
          }
        }

        if (e.target && e.target.dataset && e.target.dataset.wbIndex !== undefined) {
          var removeIdx = parseInt(e.target.dataset.wbIndex);
          workbenchArray.splice(removeIdx, 1);
          updateWorkbenchUI();
        }
      });

      var clearWorkbenchBtn = document.getElementById('clearWorkbenchBtn');
