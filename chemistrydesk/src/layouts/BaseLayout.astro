---
interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "ChemistryDesk | Computational Chemistry Tools", 
  description = "Modern lab calculation suites." 
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="google-site-verification" content="VttazQbX1eF_0VGYeFWW3ZeG-A_Y_9CV7ZIDJRxJ0FE" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body style="margin: 0; padding: 0; background-color: #f8fafc; color: #0f172a; min-height: 100vh; display: flex; flex-direction: column; font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
    
    <!-- Top Header with clean elevation and non-intrusive height -->
    <header style="background: #ffffff; border-bottom: 1px solid #e2e8f0; position: sticky; top: 0; z-index: 50; box-shadow: 0 1px 2px rgba(0,0,0,0.03);">
      <div style="max-width: 1060px; margin: 0 auto; padding: 0 1.5rem; height: 64px; display: flex; align-items: center; justify-content: space-between;">
        <a href="/" style="display: flex; align-items: center; gap: 0.6rem; text-decoration: none; font-weight: 800; font-size: 1.2rem; color: #0f172a;">
          <span style="font-size: 1.4rem;">⚗️</span> ChemistryDesk
        </a>
       <nav style="display: flex; gap: 1.25rem; font-size: 0.9rem; font-weight: 600; flex-wrap: wrap;">
          <a href="/" style="text-decoration: none; color: #475569;">Home</a>
          <a href="/molarity" style="text-decoration: none; color: #475569;">Molarity</a>
          <a href="/dilution" style="text-decoration: none; color: #475569;">Dilution</a>
          <a href="/scherrer" style="text-decoration: none; color: #475569;">PXRD Scherrer</a>
          <a href="/about" style="text-decoration: none; color: #475569;">About</a>
          <a href="/contact" style="text-decoration: none; color: #475569;">Contact</a>
        </nav>
      </div>
    </header>

    <!-- Main Content Slot with safe top breathing room -->
    <div style="flex: 1; padding-top: 1rem;">
      <slot />
    </div>

    <!-- AdSense Mandatory Compliance Footer -->
    <footer style="margin-top: 5rem; border-top: 1px solid #e2e8f0; background: #ffffff; padding: 2.5rem 1.5rem; text-align: center; font-size: 0.875rem; color: #64748b;">
      <div style="display: flex; justify-content: center; gap: 1.75rem; flex-wrap: wrap; margin-bottom: 1rem; font-weight: 500;">
        <a href="/about" style="color: #475569; text-decoration: none;">About Us</a>
        <a href="/contact" style="color: #475569; text-decoration: none;">Contact Us</a>
        <a href="/privacy-policy" style="color: #475569; text-decoration: none;">Privacy Policy</a>
        <a href="/terms" style="color: #475569; text-decoration: none;">Terms of Service</a>
      </div>
      <div>&copy; 2026 ChemistryDesk. Designed for benchtop precision and educational reference.</div>
    </footer>
  </body>
</html>