---
interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "ChemistryDesk | Computational Chemistry Tools", 
  description = "Modern lab calculation suites." 
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Direct Tailwind CDN injection -->
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-slate-50 text-slate-900 min-h-screen antialiased">
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 font-bold text-lg text-slate-900 tracking-tight">
          <span class="text-xl">⚗️</span> ChemistryDesk
        </a>
        <nav class="flex items-center gap-6 text-sm font-medium text-slate-600">
          <a href="/" class="hover:text-sky-600 transition">Home</a>
          <a href="/molarity" class="hover:text-sky-600 transition">Molarity Studio</a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="mt-20 border-t border-slate-200 bg-white py-8 text-center text-xs text-slate-500">
      © 2026 ChemistryDesk. Precision benchtop calculations.
    </footer>
  </body>
</html>