---
interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  isTool?: boolean;
}

const {  
  title,  
  description,  
  canonicalPath = Astro.url.pathname,
  isTool = false  } = Astro.props;

// Ensure search engines always index the root URL without query string pollution
const siteOrigin = "https://chemistrycal.com";
let cleanPath = canonicalPath.split('?')[0];

// Strip accidental trailing slash to enforce strict non-slash URLs
if (cleanPath.length > 1 && cleanPath.endsWith('/')) {
  cleanPath = cleanPath.slice(0, -1);
}

const fullCanonicalUrl = new URL(cleanPath, siteOrigin).href;

// Detect tool pages dynamically via prop or route
const toolRoutes = ['/molarity', '/dilution', '/scherrer', '/molar-mass', '/buffer', '/stoichiometry', '/bet', '/spectro', '/ghs', '/isotherm', '/titration', '/gas', '/ph', '/sig-figs', '/electron-configuration', '/adsorption-column', '/periodic-table'];
const isToolPage = isTool || toolRoutes.some(route => cleanPath.startsWith(route));

// Dynamic breadcrumb generation for search engines
const pathSegments = cleanPath.split('/').filter(Boolean);
const breadcrumbItems = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": "Home",
    "item": siteOrigin
  },
  ...pathSegments.map((segment, index) => {
    const formattedName = segment
      .replace(/-/g, ' ')
      .replace(/\b\w/g, (char) => char.toUpperCase());
    const itemUrl = new URL(pathSegments.slice(0, index + 1).join('/'), siteOrigin).href;

    return {
      "@type": "ListItem",
      "position": index + 2,
      "name": formattedName,
      "item": itemUrl
    };
  })
];

// Global schema graph connecting site, author entity, navigation, and tools
const graphNodes: any[] = [
  {
    "@type": "WebSite",
    "@id": "https://chemistrycal.com/#website",
    "url": "https://chemistrycal.com",
    "name": "Chemistrycal",
    "description": "Research-grade benchtop computational suite and laboratory calculator.",
    "publisher": {
      "@id": "https://chemistrycal.com/#author"
    }
  },
  {
    "@type": "Person",
    "@id": "https://chemistrycal.com/#author",
    "name": "Bilal Khan",
    "jobTitle": "Physical Chemistry Researcher",
    "url": "https://chemistrycal.com/about",
    "sameAs": [
      "https://orcid.org/0009-0006-3082-7043",
      "https://zenodo.org/records/23059466",
      "https://github.com/Hadee017",
      "https://www.wikidata.org/wiki/Q141699332"
    ]
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${fullCanonicalUrl}#breadcrumb`,
    "itemListElement": breadcrumbItems
  }
];

// Automatically inject WebApplication node for calculator/laboratory tools
if (isToolPage) {
  graphNodes.push({
    "@type": "WebApplication",
    "@id": `${fullCanonicalUrl}#app`,
    "name": title,
    "url": fullCanonicalUrl,
    "description": description,
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "All",
    "browserRequirements": "Requires JavaScript",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "creator": {
      "@id": "https://chemistrycal.com/#author"
    },
    "isPartOf": {
      "@id": "https://chemistrycal.com/#website"
    }
  });
}

const globalSchemaGraph = {
  "@context": "https://schema.org",
  "@graph": graphNodes
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <!-- Google Search Console Verification & Crawl Directives -->
  <meta name="google-site-verification" content="VttazQbX1ef_0VGYeFWW3ZeG-A_Y_9CV7ZIDJRxJ0FE" />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={fullCanonicalUrl} />

  <!-- Global Semantic Structured Data Graph (Person, WebSite, Breadcrumbs, WebApplication) -->
  <script type="application/ld+json" set:html={JSON.stringify(globalSchemaGraph)} />

  <!-- Favicon & PWA Web Manifest -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#0284c7" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content="Chemistrycal" />

  <!-- OpenGraph / Social Media Cards -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Chemistrycal" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={fullCanonicalUrl} />
  <meta property="og:image" content="https://chemistrycal.com/og-banner.jpg" />

  <!-- Twitter / X Summary Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:domain" content="chemistrycal.com" />
  <meta name="twitter:url" content={fullCanonicalUrl} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://chemistrycal.com/og-banner.jpg" />
</head>
<body style="margin: 0; padding: 0; font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #ffffff; color: #0f172a; min-height: 100vh; display: flex; flex-direction: column;">
  
  <!-- Modern Sticky Benchtop Header -->
  <header style="position: sticky; top: 0; z-index: 100; width: 100%; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border-bottom: 1.5px solid #e2e8f0; box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);">
    <div style="max-width: 1140px; margin: 0 auto; padding: 0.75rem 1.5rem; display: flex; align-items: center; justify-content: space-between; box-sizing: border-box;">
      
      <!-- Brand Title -->
      <a href="/" style="display: flex; align-items: center; gap: 0.65rem; text-decoration: none; color: inherit;">
        <span style="font-size: 1.6rem; line-height: 1;">⚗️</span>
        <div style="display: flex; flex-direction: column;">
          <span style="font-size: 1.15rem; font-weight: 800; letter-spacing: -0.025em; color: #0f172a; line-height: 1.15;">Chemistrycal</span>
          <span style="font-size: 0.68rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: #0284c7;">Benchtop Studio</span>
        </div>
      </a>

      <!-- Modern Pill Nav Links -->
      <nav style="display: flex; align-items: center; gap: 0.35rem; flex-wrap: wrap;">
        <a href="/" style={`text-decoration: none; font-size: 0.85rem; font-weight: 700; padding: 0.45rem 0.85rem; border-radius: 8px; transition: all 0.2s ease; ${Astro.url.pathname === '/' ? 'background: #e0f2fe; color: #0284c7; border: 1px solid #bae6fd;' : 'background: transparent; color: #475569; border: 1px solid transparent;'}`}>Home</a>
        <a href="/periodic-table" style={`text-decoration: none; font-size: 0.85rem; font-weight: 700; padding: 0.45rem 0.85rem; border-radius: 8px; transition: all 0.2s ease; ${Astro.url.pathname.startsWith('/periodic-table') ? 'background: #e0f2fe; color: #0284c7; border: 1px solid #bae6fd;' : 'background: transparent; color: #475569; border: 1px solid transparent;'}`}>Periodic Table</a>
        <a href="/molarity" style={`text-decoration: none; font-size: 0.85rem; font-weight: 700; padding: 0.45rem 0.85rem; border-radius: 8px; transition: all 0.2s ease; ${Astro.url.pathname.startsWith('/molarity') ? 'background: #e0f2fe; color: #0284c7; border: 1px solid #bae6fd;' : 'background: transparent; color: #475569; border: 1px solid transparent;'}`}>Molarity</a>
        <a href="/dilution" style={`text-decoration: none; font-size: 0.85rem; font-weight: 700; padding: 0.45rem 0.85rem; border-radius: 8px; transition: all 0.2s ease; ${Astro.url.pathname.startsWith('/dilution') ? 'background: #e0f2fe; color: #0284c7; border: 1px solid #bae6fd;' : 'background: transparent; color: #475569; border: 1px solid transparent;'}`}>Dilution</a>
        <a href="/molar-mass" style={`text-decoration: none; font-size: 0.85rem; font-weight: 700; padding: 0.45rem 0.85rem; border-radius: 8px; transition: all 0.2s ease; ${Astro.url.pathname.startsWith('/molar-mass') ? 'background: #e0f2fe; color: #0284c7; border: 1px solid #bae6fd;' : 'background: transparent; color: #475569; border: 1px solid transparent;'}`}>Molar Mass</a>
        <a href="/scherrer" style={`text-decoration: none; font-size: 0.85rem; font-weight: 700; padding: 0.45rem 0.85rem; border-radius: 8px; transition: all 0.2s ease; ${Astro.url.pathname.startsWith('/scherrer') ? 'background: #e0f2fe; color: #0284c7; border: 1px solid #bae6fd;' : 'background: transparent; color: #475569; border: 1px solid transparent;'}`}>PXRD Scherrer</a>
        <a href="/about" style={`text-decoration: none; font-size: 0.85rem; font-weight: 700; padding: 0.45rem 0.85rem; border-radius: 8px; transition: all 0.2s ease; ${Astro.url.pathname.startsWith('/about') ? 'background: #e0f2fe; color: #0284c7; border: 1px solid #bae6fd;' : 'background: transparent; color: #475569; border: 1px solid transparent;'}`}>About</a>
        <a href="/contact" style={`text-decoration: none; font-size: 0.85rem; font-weight: 700; padding: 0.45rem 0.85rem; border-radius: 8px; transition: all 0.2s ease; ${Astro.url.pathname.startsWith('/contact') ? 'background: #e0f2fe; color: #0284c7; border: 1px solid #bae6fd;' : 'background: transparent; color: #475569; border: 1px solid transparent;'}`}>Contact</a>
        <button id="pwaInstallBtn" type="button" title="Install Chemistrycal as a native offline app" style="display: inline-flex; flex-direction: column; align-items: center; justify-content: center; padding: 0.35rem 0.85rem; border-radius: 8px; background: #0284c7; color: #ffffff; border: none; cursor: pointer; transition: all 0.2s ease; line-height: 1.15; box-shadow: 0 1px 3px rgba(2, 132, 199, 0.3);">
          <span style="display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.8rem; font-weight: 700;">
            <span>📥</span> Install App
          </span>
          <span style="font-size: 0.62rem; font-weight: 700; opacity: 0.92; text-transform: uppercase; letter-spacing: 0.05em; margin-top: 1px;">
            100% Offline
          </span>
        </button>
      </nav>

    </div>
  </header>

  <!-- Main Content Slot with safe top breathing room -->
  <div style="flex: 1; padding-top: 1rem;">
    <slot />
  </div>

  <!-- Automated Global Internal Link Network Footer Hub -->
  <section style="max-width: 1000px; margin: 4rem auto 1.5rem; padding: 1.5rem; background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 12px; box-sizing: border-box;">
    <h3 style="margin: 0 0 0.5rem; font-size: 1.05rem; font-weight: 700; color: #0f172a; display: flex; align-items: center; gap: 0.5rem;">
      <span>🔗</span> Core Chemistrycal Calculator Suite
    </h3>
    <p style="margin: 0 0 1rem; font-size: 0.85rem; color: #64748b; line-height: 1.4;">
      Explore our complete network of research-grade wet chemistry, stoichiometry, and materials analysis utilities:
    </p>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 0.75rem;">
      <a href="/periodic-table" style="display: block; padding: 0.75rem; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; text-decoration: none; color: inherit;">
        <div style="font-weight: 700; font-size: 0.88rem; color: #0284c7;">Periodic Table Studio &rarr;</div>
      </a>
      <a href="/molarity" style="display: block; padding: 0.75rem; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; text-decoration: none; color: inherit;">
        <div style="font-weight: 700; font-size: 0.88rem; color: #0284c7;">Molarity Studio &rarr;</div>
      </a>
      <a href="/dilution" style="display: block; padding: 0.75rem; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; text-decoration: none; color: inherit;">
        <div style="font-weight: 700; font-size: 0.88rem; color: #0284c7;">Stock Dilution &rarr;</div>
      </a>
      <a href="/molar-mass" style="display: block; padding: 0.75rem; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; text-decoration: none; color: inherit;">
        <div style="font-weight: 700; font-size: 0.88rem; color: #0284c7;">Molar Mass Calculator &rarr;</div>
      </a>
      <a href="/scherrer" style="display: block; padding: 0.75rem; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; text-decoration: none; color: inherit;">
        <div style="font-weight: 700; font-size: 0.88rem; color: #0284c7;">PXRD Scherrer Studio &rarr;</div>
      </a>
      <a href="/buffer" style="display: block; padding: 0.75rem; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; text-decoration: none; color: inherit;">
        <div style="font-weight: 700; font-size: 0.88rem; color: #0284c7;">Buffer Calculator &rarr;</div>
      </a>
      <a href="/stoichiometry" style="display: block; padding: 0.75rem; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; text-decoration: none; color: inherit;">
        <div style="font-weight: 700; font-size: 0.88rem; color: #0284c7;">Stoichiometry &rarr;</div>
      </a>
    </div>
  </section>

  <!-- AdSense Mandatory Compliance Footer -->
  <footer style="margin-top: 1.5rem; border-top: 1px solid #e2e8f0; background: #ffffff; padding: 2.5rem 1.5rem; text-align: center; font-size: 0.875rem; color: #64748b;">
    <div style="display: flex; justify-content: center; gap: 1.75rem; flex-wrap: wrap; margin-bottom: 1rem; font-weight: 500;">
      <a href="/about" style="color: #475569; text-decoration: none;">About Us</a>
      <a href="/contact" style="color: #475569; text-decoration: none;">Contact Us</a>
      <a href="/privacy-policy" style="color: #475569; text-decoration: none;">Privacy Policy</a>
      <a href="/terms" style="color: #475569; text-decoration: none;">Terms of Service</a>
    </div>
    <div>&copy; 2026 Chemistrycal. Designed for benchtop precision and educational reference.</div>
  </footer>

  <script is:inline>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js')
        .then(() => console.log('Chemistrycal offline engine active.'))
        .catch((err) => console.warn('PWA registration error:', err));
    });
  }

  let deferredPrompt;
  const installBtn = document.getElementById('pwaInstallBtn');

  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferredPrompt = e;
  });

  if (installBtn) {
    installBtn.addEventListener('click', async () => {
      if (deferredPrompt) {
        deferredPrompt.prompt();
        const { outcome } = await deferredPrompt.userChoice;
        if (outcome === 'accepted') {
          installBtn.style.display = 'none';
        }
        deferredPrompt = null;
      } else {
        alert("To install Chemistrycal for offline benchtop use:\n\n• Desktop: Click the 'Install' icon inside your browser's address bar (top-right).\n• Mobile: Tap your browser menu (⋮ or Share) and select 'Add to Home screen'.");
      }
    });
  }

  window.addEventListener('appinstalled', () => {
    if (installBtn) installBtn.style.display = 'none';
  });
  </script>
</body>
</html>