---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "ChemistryDesk | Computational Chemistry Tools", 
  description = "Modern lab calculation suites." 
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-slate-50 text-slate-900 min-h-screen">
    <slot />
  </body>
</html>