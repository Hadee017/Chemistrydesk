---
// src/components/Navbar.astro
import { SITE_CONFIG } from '../site.config.js';
---
<header class="bg-white border-b border-slate-200 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16 items-center">
      <a href="/" class="flex items-center space-x-2">
        <span class="w-9 h-9 rounded-lg bg-cyan-700 text-white flex items-center justify-center font-bold text-xl shadow-sm">
          Cd
        </span>
        <span class="text-xl font-black tracking-tight text-slate-900">
          Chemistry<span class="text-cyan-600">Desk</span>
        </span>
      </a>

      <nav class="hidden md:flex space-x-8 text-sm font-semibold text-slate-600">
        {SITE_CONFIG.navLinks.map((link) => (
          <a href={link.href} class="hover:text-cyan-600 transition-colors py-2">{link.name}</a>
        ))}
      </nav>

      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800">
        Lab Engine Live
      </span>
    </div>
  </div>
</header>