---
const currentPath = Astro.url.pathname;

const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'Molarity', href: '/molarity' },
  { name: 'Dilution', href: '/dilution' },
  { name: 'pH Studio', href: '/ph' },
  { name: 'PXRD Scherrer', href: '/scherrer' },
  { name: 'Gas Law', href: '/gas' },
  { name: 'About', href: '/about' },
  { name: 'Contact', href: '/contact' }
];
---

<header style="position: sticky; top: 0; z-index: 1000; width: 100%; background: #ffffff; border-bottom: 1.5px solid #e2e8f0; box-shadow: 0 1px 4px rgba(15, 23, 42, 0.05); font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  <div style="max-width: 1140px; margin: 0 auto; padding: 0.75rem 1.5rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; box-sizing: border-box;">
    
    <!-- Brand Logo -->
    <a href="/" style="display: flex; align-items: center; gap: 0.65rem; text-decoration: none; color: inherit;">
      <span style="font-size: 1.6rem; line-height: 1;">⚗️</span>
      <div style="display: flex; flex-direction: column;">
        <span style="font-size: 1.15rem; font-weight: 800; letter-spacing: -0.025em; color: #0f172a; line-height: 1.15;">ChemistryDesk</span>
        <span style="font-size: 0.68rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: #0284c7;">Benchtop Studio</span>
      </div>
    </a>

    <!-- Navigation Links -->
    <nav style="display: flex; align-items: center; gap: 0.35rem; flex-wrap: wrap;">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a 
            href={link.href} 
            style={`text-decoration: none; font-size: 0.85rem; font-weight: 700; padding: 0.45rem 0.85rem; border-radius: 8px; transition: all 0.2s ease; ${
              isActive 
                ? 'background: #e0f2fe; color: #0284c7; border: 1px solid #bae6fd;' 
                : 'background: transparent; color: #475569; border: 1px solid transparent;'
            }`}
          >
            {link.name}
          </a>
        );
      })}
    </nav>

  </div>
</header>