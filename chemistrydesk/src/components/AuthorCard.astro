---
interface Props {
  lastUpdated?: string;
  reviewedBy?: string;
}

const { 
  lastUpdated = "October 2026", 
  reviewedBy = "IUPAC Reference Standards & Empirical Literature" 
} = Astro.props;
---

<aside 
  aria-label="Author and Scientific Editorial Review"
  style="background: #ffffff; border: 1.5px solid #cbd5e1; border-radius: 12px; padding: 1rem 1.15rem; margin: 0 0 1.75rem 0; max-width: 680px; box-shadow: 0 2px 5px rgba(15, 23, 42, 0.03); font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;"
>
  <div style="display: flex; gap: 0.9rem; align-items: flex-start; flex-wrap: wrap;">
    
    <!-- Profile Photo Container with In-Browser Live Preview -->
    <div style="position: relative; flex-shrink: 0; text-align: center;">
      <label 
        for="authorAvatarUpload" 
        style="cursor: pointer; display: block; position: relative;" 
        title="Click to preview a local photo before committing to Git"
      >
        <img 
          id="authorAvatarImg"
          src="/images/bilal-khan.jpg" 
          alt="Bilal Khan - Chemistry Researcher & Author" 
          width="56" 
          height="56"
          loading="lazy"
          onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=Bilal+Khan&background=0284c7&color=fff&size=112&bold=true';"
          style="width: 54px; height: 54px; border-radius: 50%; object-fit: cover; border: 2px solid #0284c7; box-shadow: 0 2px 4px rgba(2, 132, 199, 0.2); display: block;" 
        />
        <span 
          style="position: absolute; bottom: -2px; right: -2px; background: #059669; color: white; width: 17px; height: 17px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 9px; border: 1.5px solid white; font-weight: 800;" 
          title="Verified Chemistry Author"
        >
          ✓
        </span>
      </label>
      
      <!-- Hidden Local File Selector for Testing -->
      <input type="file" id="authorAvatarUpload" accept="image/*" style="display: none;" />
      <span style="font-size: 0.62rem; color: #64748b; display: block; margin-top: 3px;">Change photo</span>
    </div>

    <!-- Author Details & Verified Identifiers -->
    <div style="flex: 1; min-width: 250px;">
      <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 0.2rem;">
        <div style="display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap;">
          <h3 style="margin: 0; font-size: 1.05rem; font-weight: 800; color: #0f172a; display: flex; align-items: center;">
            Bilal Khan
          </h3>
          <span style="font-size: 0.68rem; background: #e0f2fe; color: #0369a1; padding: 1px 7px; border-radius: 9999px; font-weight: 700;">Verified Author</span>
          <span style="font-size: 0.75rem; color: #64748b; font-weight: 500;">
            • Researcher in Physical &amp; Materials Chemistry
          </span>
        </div>
        <div style="font-size: 0.72rem; color: #94a3b8; font-weight: 600;">
          Reviewed: <strong style="color: #475569;">{lastUpdated}</strong>
        </div>
      </div>

      <p style="margin: 0.25rem 0 0.5rem 0; font-size: 0.78rem; color: #334155; line-height: 1.45;">
        Specializes in porous material characterization (BET / PXRD), gas physisorption equilibria, and aqueous solution thermodynamics. All formula derivations, calibration tolerances, and empirical constants across ChemistryDesk are verified against IUPAC nomenclature and peer-reviewed reference standards.
      </p>

      <!-- Authority Badges & Persistent Identifiers -->
      <div style="display: flex; flex-wrap: wrap; gap: 0.35rem; align-items: center; font-size: 0.7rem;">
        <span style="background: #f1f5f9; color: #334155; padding: 2px 7px; border-radius: 5px; font-weight: 600; border: 1px solid #cbd5e1;">
          🛡️ Verified against {reviewedBy}
        </span>
        <a 
          href="https://orcid.org/0009-0006-3082-7043" 
          target="_blank" 
          rel="noopener noreferrer" 
          style="background: #f8fafc; color: #2e7d32; border: 1px solid #a5d6a7; padding: 2px 7px; border-radius: 5px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 0.25rem;"
        >
          <span style="color: #43a047; font-weight: 900;">iD</span> ORCID (0009-0006-3082-7043)
        </a>
        <a 
          href="https://www.linkedin.com/in/bilal-khan-bbb259248" 
          target="_blank" 
          rel="noopener noreferrer" 
          style="background: #0a66c2; color: #ffffff; padding: 2px 7px; border-radius: 5px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 0.25rem;"
        >
          <span>in</span> LinkedIn Profile
        </a>
        <a 
          href="https://doi.org/10.5281/zenodo.23059466" 
          target="_blank" 
          rel="noopener noreferrer" 
          style="background: #0f172a; color: #38bdf8; padding: 2px 7px; border-radius: 5px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 0.25rem;"
        >
          <span>📦</span> CERN Zenodo Record
        </a>
        <a 
          href="https://www.wikidata.org/wiki/Q141699332" 
          target="_blank" 
          rel="noopener noreferrer" 
          style="background: #f8fafc; color: #0284c7; border: 1px solid #bae6fd; padding: 2px 7px; border-radius: 5px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 0.25rem;"
        >
          <span>🌐</span> Wikidata (Q141699332)
        </a>
      </div>

    </div>

  </div>
</aside>

<script is:inline>
  var uploadInput = document.getElementById('authorAvatarUpload');
  var avatarImg = document.getElementById('authorAvatarImg');

  if (uploadInput && avatarImg) {
    uploadInput.addEventListener('change', function(e) {
      var file = e.target.files && e.target.files[0];
      if (file) {
        var reader = new FileReader();
        reader.onload = function(evt) {
          avatarImg.src = evt.target.result;
        };
        reader.readAsDataURL(file);
      }
    });
  }
</script>