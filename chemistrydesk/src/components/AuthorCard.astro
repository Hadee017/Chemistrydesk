---
// src/components/AuthorCard.astro
interface Props {
  lastUpdated?: string;
}

const { 
  lastUpdated = "October 2026" 
} = Astro.props;

const orcidUrl = "https://orcid.org/0009-0006-3082-7043";
const linkedinUrl = "https://www.linkedin.com/in/bilal-khan-bbb259248";
const zenodoUrl = "https://doi.org/10.5281/zenodo.23059466";
const wikidataUrl = "https://www.wikidata.org/wiki/Q141699332";
---

<!-- Omni-Style Creator Byline with Chemistry Concentric Frame -->
<div class="omni-author-wrapper" aria-label="Author Profile & Credentials">
  
  <!-- Chemistry Spectral Ring Frame -->
  <div class="avatar-ring-frame">
    <label for="authorAvatarUpload" class="avatar-label" title="Click to test local photo preview">
      <img 
        id="authorAvatarImg"
        src="/images/bilal-khan.jpg" 
        alt="Bilal Khan - Materials Scientist & Physical Chemistry Researcher" 
        width="56" 
        height="56"
        loading="lazy"
        onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=Bilal+Khan&background=0284c7&color=fff&size=112&bold=true';"
        class="avatar-image"
      />
    </label>
    <input type="file" id="authorAvatarUpload" accept="image/*" style="display: none;" />
  </div>

  <!-- Creator Byline & Qualification Details -->
  <div class="author-meta-text">
    <span class="meta-label">Creator</span>
    
    <div class="creator-line">
      <!-- Interactive Name Trigger with Popover -->
      <div class="popover-trigger-container">
        <a href={orcidUrl} target="_blank" rel="noopener noreferrer" class="author-name-link">
          Bilal Khan
        </a>

        <!-- Hover Popover Modal Card -->
        <div class="author-popover-card">
          <div class="popover-header">
            <div class="popover-avatar-wrapper">
              <img 
                src="/images/bilal-khan.jpg" 
                alt="Bilal Khan" 
                onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=Bilal+Khan&background=0284c7&color=fff&size=90&bold=true';"
                class="popover-avatar"
              />
              <span class="verified-badge-icon" title="Verified Chemistry Author">✓</span>
            </div>
            <div>
              <div class="popover-name-row">
                <strong class="popover-name">Bilal Khan</strong>
                <span class="verified-pill">Verified Author</span>
              </div>
              <span class="popover-title">Materials Scientist &amp; Physical Chemistry Researcher</span>
            </div>
          </div>

          <p class="popover-bio">
            Specializes in porous material characterization (BET / PXRD), gas physisorption equilibria, and aqueous solution thermodynamics. All formula derivations and calibration tolerances across Chemistrycal are verified against empirical standards.
          </p>

          <!-- Verified Persistent Authority Identifiers -->
          <div class="popover-links">
            <a href={orcidUrl} target="_blank" rel="noopener noreferrer" class="id-badge orcid">
              <span>iD</span> ORCID
            </a>
            <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="id-badge linkedin">
              <span>in</span> LinkedIn
            </a>
            <a href={zenodoUrl} target="_blank" rel="noopener noreferrer" class="id-badge zenodo">
              <span>📦</span> Zenodo
            </a>
            <a href={wikidataUrl} target="_blank" rel="noopener noreferrer" class="id-badge wikidata">
              <span>🌐</span> Wikidata
            </a>
          </div>
        </div>
      </div>

      <span class="qualification-sep">•</span>
      <span class="qualification-tag">Materials Scientist</span>
    </div>
  </div>

</div>

<style>
  .omni-author-wrapper {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    margin: 0 0 1.5rem 0;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    position: relative;
    z-index: 50;
  }

  /* Chemistry Spectral Conic Gradient Ring */
  .avatar-ring-frame {
    position: relative;
    width: 62px;
    height: 62px;
    border-radius: 50%;
    background: conic-gradient(from 180deg at 50% 50%, #0284c7 0deg, #06b6d4 115deg, #10b981 200deg, #3b82f6 305deg, #0284c7 360deg);
    padding: 2.5px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 3px 10px rgba(2, 132, 199, 0.18);
    flex-shrink: 0;
  }

  .avatar-label {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: #ffffff;
    padding: 2px;
    cursor: pointer;
  }

  .avatar-image {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    display: block;
  }

  .author-meta-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .meta-label {
    color: #64748b;
    font-size: 0.78rem;
    font-weight: 500;
  }

  .creator-line {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  /* Popover Trigger Container */
  .popover-trigger-container {
    position: relative;
    display: inline-block;
  }

  .author-name-link {
    color: #0284c7;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .author-name-link:hover {
    color: #0369a1;
  }

  .qualification-sep {
    color: #cbd5e1;
    font-size: 0.85rem;
  }

  .qualification-tag {
    color: #334155;
    font-weight: 600;
    font-size: 0.85rem;
  }

  /* Hover Popover Modal Card */
  .author-popover-card {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    width: 320px;
    background: #ffffff;
    border: 1.5px solid #cbd5e1;
    border-radius: 12px;
    padding: 1rem;
    box-shadow: 0 10px 25px -3px rgba(15, 23, 42, 0.15), 0 4px 6px -2px rgba(15, 23, 42, 0.05);
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1), transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.2s;
    pointer-events: none;
    z-index: 60;
  }

  .popover-trigger-container:hover .author-popover-card {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .popover-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.65rem;
  }

  .popover-avatar-wrapper {
    position: relative;
    flex-shrink: 0;
  }

  .popover-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #0284c7;
    display: block;
  }

  .verified-badge-icon {
    position: absolute;
    bottom: -2px;
    right: -2px;
    background: #10b981;
    color: white;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    border: 1.5px solid white;
    font-weight: 800;
  }

  .popover-name-row {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .popover-name {
    color: #0f172a;
    font-size: 0.95rem;
  }

  .verified-pill {
    font-size: 0.65rem;
    background: #e0f2fe;
    color: #0369a1;
    padding: 1px 6px;
    border-radius: 9999px;
    font-weight: 700;
  }

  .popover-title {
    display: block;
    font-size: 0.72rem;
    color: #64748b;
    margin-top: 1px;
    line-height: 1.3;
  }

  .popover-bio {
    margin: 0 0 0.75rem 0;
    font-size: 0.76rem;
    color: #334155;
    line-height: 1.5;
  }

  .popover-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .id-badge {
    padding: 2px 7px;
    border-radius: 5px;
    font-size: 0.68rem;
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .id-badge.orcid {
    background: #f8fafc;
    color: #2e7d32;
    border: 1px solid #cbd5e1;
  }

  .id-badge.linkedin {
    background: #0a66c2;
    color: #ffffff;
  }

  .id-badge.zenodo {
    background: #0f172a;
    color: #38bdf8;
  }

  .id-badge.wikidata {
    background: #f8fafc;
    color: #0284c7;
    border: 1px solid #cbd5e1;
  }
</style>

<script is:inline>
  var uploadInput = document.getElementById('authorAvatarUpload');
  var avatarImg = document.getElementById('authorAvatarImg');
  var popoverAvatarImgs = document.querySelectorAll('.popover-avatar');

  // Check if a saved avatar exists in localStorage on page load
  var savedImage = localStorage.getItem('authorAvatar');
  if (savedImage) {
    if (avatarImg) avatarImg.src = savedImage;
    popoverAvatarImgs.forEach(function(img) {
      img.src = savedImage;
    });
  }

  if (uploadInput && avatarImg) {
    uploadInput.addEventListener('change', function(e) {
      var file = e.target.files && e.target.files[0];
      if (file) {
        var reader = new FileReader();
        reader.onload = function(evt) {
          var result = evt.target.result;
          if (avatarImg) avatarImg.src = result;
          popoverAvatarImgs.forEach(function(img) {
            img.src = result;
          });
          // Save the base64 string to localStorage for persistent sessions
          try {
            localStorage.setItem('authorAvatar', result);
          } catch (err) {
            console.warn('Image file is too large to store locally', err);
          }
        };
        reader.readAsDataURL(file);
      }
    });
  }
</script>