---
// src/components/TitrationChart.astro
import type { TitrationDataPoint, IndicatorEvaluation } from '../lib/calculations/titration';

interface Props {
  points: TitrationDataPoint[];
  equivalenceVolume: number;
  equivalencePH: number;
  halfEquivalenceVolume?: number;
  halfEquivalencePH?: number;
  bufferRange?: [number, number];
  indicator: IndicatorEvaluation;
  showDerivative?: boolean;
}

const {
  points,
  equivalenceVolume,
  equivalencePH,
  halfEquivalenceVolume,
  halfEquivalencePH,
  bufferRange,
  indicator,
  showDerivative = false,
} = Astro.props;

// SVG Canvas Coordinate Dimensions
const width = 720;
const height = 440;
const padding = { top: 40, right: 50, bottom: 60, left: 60 };

const chartWidth = width - padding.left - padding.right;
const chartHeight = height - padding.top - padding.bottom;

// Scales
const maxVolume = points.length > 0 ? points[points.length - 1].volumeAdded : equivalenceVolume * 2;
const maxDerivative = Math.max(...points.map((p) => p.derivative), 1.0);

const scaleX = (v: number) => padding.left + (v / (maxVolume || 1)) * chartWidth;
const scaleY = (ph: number) => padding.top + chartHeight - (ph / 14) * chartHeight;
const scaleYDeriv = (d: number) => padding.top + chartHeight - (d / (maxDerivative || 1)) * chartHeight;

// Construct Primary pH Path
const pathD = points.reduce((acc, pt, idx) => {
  const x = scaleX(pt.volumeAdded);
  const y = scaleY(pt.pH);
  return idx === 0 ? `M ${x.toFixed(1)} ${y.toFixed(1)}` : `${acc} L ${x.toFixed(1)} ${y.toFixed(1)}`;
}, '');

// Construct First Derivative Path (dpH/dV)
const derivPathD = points.reduce((acc, pt, idx) => {
  const x = scaleX(pt.volumeAdded);
  const y = scaleYDeriv(pt.derivative);
  return idx === 0 ? `M ${x.toFixed(1)} ${y.toFixed(1)}` : `${acc} L ${x.toFixed(1)} ${y.toFixed(1)}`;
}, '');

// Coordinates for Key Intercepts
const eqX = scaleX(equivalenceVolume);
const eqY = scaleY(equivalencePH);

const halfX = halfEquivalenceVolume !== undefined ? scaleX(halfEquivalenceVolume) : null;
const halfY = halfEquivalencePH !== undefined ? scaleY(halfEquivalencePH) : null;

// Indicator Transition Band Coordinates
const indTopY = scaleY(indicator.pHRange[1]);
const indBottomY = scaleY(indicator.pHRange[0]);
const indHeight = Math.abs(indBottomY - indTopY);

// Buffer Zone Coordinates
const bufferTopY = bufferRange ? scaleY(bufferRange[1]) : null;
const bufferBottomY = bufferRange ? scaleY(bufferRange[0]) : null;
const bufferHeight = bufferTopY && bufferBottomY ? Math.abs(bufferBottomY - bufferTopY) : null;

// Axis Grid Divisions
const xTicks = [0, 0.25, 0.5, 0.75, 1.0].map((ratio) => (maxVolume * ratio).toFixed(1));
const yTicks = [0, 2, 4, 6, 8, 10, 12, 14];
---

<div class="w-full bg-slate-900 border border-slate-800 rounded-xl p-4 shadow-xl">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-3 border-b border-slate-800/80 pb-3">
    <div class="flex items-center gap-2">
      <div class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-pulse"></div>
      <span class="text-sm font-semibold tracking-wide text-slate-200 uppercase">Equilibrium Inflection Curve</span>
    </div>

    <!-- Chart Legend Badges -->
    <div class="flex flex-wrap items-center gap-3 text-xs">
      <div class="flex items-center gap-1.5 text-cyan-300">
        <span class="inline-block w-3.5 h-0.5 bg-cyan-400"></span>
        <span>Titration (pH)</span>
      </div>
      <div class="flex items-center gap-1.5 text-pink-400">
        <span class="inline-block w-3 h-2 rounded bg-pink-500/20 border border-pink-500/40"></span>
        <span>{indicator.name} Band</span>
      </div>
      {bufferRange && (
        <div class="flex items-center gap-1.5 text-amber-400">
          <span class="inline-block w-3 h-2 rounded bg-amber-500/20 border border-amber-500/40"></span>
          <span>Buffer Zone</span>
        </div>
      )}
      <div class="flex items-center gap-1.5 text-violet-400">
        <span class="inline-block w-3.5 h-0.5 border-t border-dashed border-violet-400"></span>
        <span>1st Deriv (dpH/dV)</span>
      </div>
    </div>
  </div>

  <div class="relative w-full overflow-hidden">
    <svg viewBox={`0 0 ${width} ${height}`} class="w-full h-auto select-none" role="img" aria-label="Titration Curve Graph">
      <!-- Defs for Shading Gradients -->
      <defs>
        <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#1e293b" stroke-width="0.8" />
        </pattern>
        <linearGradient id="indicatorGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#ec4899" stop-opacity="0.25" />
          <stop offset="100%" stop-color="#ec4899" stop-opacity="0.08" />
        </linearGradient>
        <linearGradient id="bufferGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#f59e0b" stop-opacity="0.2" />
          <stop offset="100%" stop-color="#f59e0b" stop-opacity="0.05" />
        </linearGradient>
      </defs>

      <!-- Grid Background -->
      <rect x={padding.left} y={padding.top} width={chartWidth} height={chartHeight} fill="url(#grid)" />

      <!-- Horizontal Buffer Zone Shading (if Weak System) -->
      {bufferRange && bufferTopY && bufferHeight && (
        <rect
          x={padding.left}
          y={bufferTopY}
          width={chartWidth}
          height={bufferHeight}
          fill="url(#bufferGrad)"
          stroke="#f59e0b"
          stroke-dasharray="2 3"
          stroke-opacity="0.4"
          stroke-width="1"
        />
      )}

      <!-- Indicator Transition Range Shading -->
      <rect
        x={padding.left}
        y={indTopY}
        width={chartWidth}
        height={indHeight}
        fill="url(#indicatorGrad)"
        stroke="#ec4899"
        stroke-dasharray="3 3"
        stroke-opacity="0.5"
        stroke-width="1"
      />

      <!-- X and Y Axes -->
      <line
        x1={padding.left}
        y1={padding.top + chartHeight}
        x2={padding.left + chartWidth}
        y2={padding.top + chartHeight}
        stroke="#475569"
        stroke-width="1.5"
      />
      <line
        x1={padding.left}
        y1={padding.top}
        x2={padding.left}
        y2={padding.top + chartHeight}
        stroke="#475569"
        stroke-width="1.5"
      />

      <!-- Y-Axis Ticks (pH: 0 to 14) -->
      {yTicks.map((tick) => {
        const yPos = scaleY(tick);
        return (
          <g>
            <line x1={padding.left - 5} y1={yPos} x2={padding.left} y2={yPos} stroke="#64748b" stroke-width="1" />
            <text x={padding.left - 12} y={yPos + 4} fill="#94a3b8" font-size="11" text-anchor="end" font-family="monospace">
              {tick}
            </text>
          </g>
        );
      })}

      <!-- X-Axis Ticks (Volume Added) -->
      {xTicks.map((val) => {
        const xPos = scaleX(parseFloat(val));
        return (
          <g>
            <line x1={xPos} y1={padding.top + chartHeight} x2={xPos} y2={padding.top + chartHeight + 5} stroke="#64748b" stroke-width="1" />
            <text x={xPos} y={padding.top + chartHeight + 20} fill="#94a3b8" font-size="11" text-anchor="middle" font-family="monospace">
              {val}
            </text>
          </g>
        );
      })}

      <!-- Axis Labels -->
      <text
        x={padding.left + chartWidth / 2}
        y={height - 12}
        fill="#cbd5e1"
        font-size="12"
        font-weight="600"
        text-anchor="middle"
        letter-spacing="0.05em"
      >
        Titrant Added Volume (mL)
      </text>

      <text
        transform={`rotate(-90)`}
        x={-(padding.top + chartHeight / 2)}
        y={18}
        fill="#cbd5e1"
        font-size="12"
        font-weight="600"
        text-anchor="middle"
        letter-spacing="0.05em"
      >
        Solution pH
      </text>

      <!-- 1st Derivative Curve (dpH/dV) -->
      <path
        d={derivPathD}
        fill="none"
        stroke="#a78bfa"
        stroke-width="1.8"
        stroke-dasharray="4 3"
        stroke-opacity="0.85"
      />

      <!-- Primary Sigmoidal Titration Curve (pH) -->
      <path
        d={pathD}
        fill="none"
        stroke="#22d3ee"
        stroke-width="3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />

      <!-- Half-Equivalence Point Intercept (pH = pKa) -->
      {halfX !== null && halfY !== null && (
        <g>
          <line
            x1={halfX}
            y1={padding.top + chartHeight}
            x2={halfX}
            y2={halfY}
            stroke="#f59e0b"
            stroke-dasharray="3 3"
            stroke-width="1.2"
          />
          <line
            x1={padding.left}
            y1={halfY}
            x2={halfX}
            y2={halfY}
            stroke="#f59e0b"
            stroke-dasharray="3 3"
            stroke-width="1.2"
          />
          <circle cx={halfX} cy={halfY} r="5" fill="#f59e0b" stroke="#0f172a" stroke-width="2" />
          <text x={halfX + 8} y={halfY - 6} fill="#fbbf24" font-size="11" font-weight="700" font-family="monospace">
            V½ ({halfEquivalenceVolume} mL, pH {halfEquivalencePH})
          </text>
        </g>
      )}

      <!-- Equivalence Point Intercept (Inflection Point) -->
      <g>
        <line
          x1={eqX}
          y1={padding.top + chartHeight}
          x2={eqX}
          y2={eqY}
          stroke="#ef4444"
          stroke-dasharray="3 3"
          stroke-width="1.5"
        />
        <line
          x1={padding.left}
          y1={eqY}
          x2={eqX}
          y2={eqY}
          stroke="#ef4444"
          stroke-dasharray="3 3"
          stroke-width="1.5"
        />
        <circle cx={eqX} cy={eqY} r="6.5" fill="#ef4444" stroke="#ffffff" stroke-width="2" />
        <text x={eqX + 10} y={eqY - 8} fill="#fca5a5" font-size="12" font-weight="800" font-family="monospace">
          Veq ({equivalenceVolume} mL, pH {equivalencePH})
        </text>
      </g>
    </svg>
  </div>
</div>